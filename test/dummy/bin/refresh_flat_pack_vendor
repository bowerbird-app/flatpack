#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

dummy_root = File.expand_path("..", __dir__)
repo_root = File.expand_path("../../..", __dir__)
vendor_root = File.join(dummy_root, "vendor/flat_pack")

copy_entries = %w[
  app
  config
  lib
  docs
  CHANGELOG.md
  SECURITY.md
  MIT-LICENSE
  README.md
  flat_pack.gemspec
]

FileUtils.rm_rf(vendor_root)
FileUtils.mkdir_p(vendor_root)

copy_entries.each do |entry|
  source = File.join(repo_root, entry)
  destination = File.join(vendor_root, entry)

  if File.directory?(source)
    FileUtils.cp_r(source, vendor_root)
  else
    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.cp(source, destination)
  end
end

puts "Refreshed vendored FlatPack at #{vendor_root}"
