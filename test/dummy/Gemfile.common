# frozen_string_literal: true

# Rails and core dependencies
gem "rails", ">= 8.1.2.1", "< 8.2"
gem "puma", ">= 5.0"
gem "propshaft", "~> 1.0"
gem "sidekiq"
gem "redis"
gem "pg", "~> 1.1"
gem "image_processing", "~> 1.2"

# Recording Studio host stack (API + OAuth + MCP on the dummy demo)
gem "recording_studio", github: "bowerbird-app/RecordingStudio", tag: "v4.2.1"
gem "recording_studio_accessible", github: "bowerbird-app/RecordingStudio_accessible", tag: "v0.9.1"
gem "recording_studio_user", github: "bowerbird-app/RecordingStudio_users", tag: "v0.11.0"
gem "recording_studio_attachable", github: "bowerbird-app/RecordingStudio_attachable", tag: "v0.5.1"
gem "recording_studio_site_settings", github: "bowerbird-app/RecordingStudio_site_settings", tag: "v0.1.0"
gem "recording_studio_admin", github: "bowerbird-app/RecordingStudio_admin", tag: "v2.0.2"
gem "recording_studio_api", github: "bowerbird-app/RecordingStudio_api", tag: "v0.5.4"
gem "recording_studio_oauth", github: "bowerbird-app/RecordingStudio_Oauth", tag: "v0.1.0"
gem "recording_studio_mcp", github: "bowerbird-app/RecordingStudio_MCP", tag: "v0.3.0"
gem "recording_studio_root_switchable", github: "bowerbird-app/RecordingStudio_root_switchable", tag: "v0.5.1"

# Asset pipeline and frontend
gem "tailwindcss-rails", "~> 4.0"
gem "importmap-rails"
gem "stimulus-rails"
gem "turbo-rails"

# View components
gem "view_component"
gem "devise"

group :development, :test do
  gem "debug", platforms: %i[mri mingw x64_mingw]
end

group :development do
  gem "web-console"
end

group :test do
  gem "capybara"
  gem "selenium-webdriver"
end