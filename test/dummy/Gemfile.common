# frozen_string_literal: true

# Rails and core dependencies
gem "rails", ">= 8.1.2.1", "< 8.2"
gem "puma", ">= 5.0"
gem "propshaft", "~> 1.0"
gem "sidekiq"
gem "redis"
gem "pg", "~> 1.1"
gem "image_processing", "~> 1.2"

# Recording Studio host stack (API + OAuth + MCP on the dummy demo).
# Tags are each gem's latest GitHub release. The extra gems below are git-only
# dependencies of that stack (not published on RubyGems).
gem "recording_studio", github: "bowerbird-app/RecordingStudio", tag: "v7.7.1"
gem "recording_studio_accessible", github: "bowerbird-app/RecordingStudio_accessible", tag: "v0.54.0"
gem "recording_studio_user", github: "bowerbird-app/RecordingStudio_users", tag: "v0.36.0"
gem "recording_studio_attachable", github: "bowerbird-app/RecordingStudio_attachable", tag: "v0.32.1"
gem "recording_studio_site_settings", github: "bowerbird-app/RecordingStudio_site_settings", tag: "v0.6.0"
gem "recording_studio_admin", github: "bowerbird-app/RecordingStudio_admin", tag: "v2.19.0"
gem "recording_studio_api", github: "bowerbird-app/RecordingStudio_api", tag: "v1.15.0"
gem "recording_studio_oauth", github: "bowerbird-app/RecordingStudio_Oauth", tag: "v0.25.0"
gem "recording_studio_mcp", github: "bowerbird-app/RecordingStudio_MCP", tag: "v0.37.0"
gem "recording_studio_root_switchable", github: "bowerbird-app/RecordingStudio_root_switchable", tag: "v0.16.0"
gem "recording_studio_internationalization", github: "bowerbird-app/RecordingStudio_Internationalization", tag: "v0.3.0"
gem "recording_studio_trashable", github: "bowerbird-app/RecordingStudio_trashable", tag: "v1.2.0"
gem "recording_studio_cache", github: "bowerbird-app/RecordingStudio_cache", tag: "v0.7.0"
gem "recording_studio_metrics", github: "bowerbird-app/RecordingStudio_metrics", tag: "v0.9.1"
gem "recording_studio_logs", github: "bowerbird-app/RecordingStudio_logs", tag: "v0.8.1"
gem "recording_studio_moveable", github: "bowerbird-app/RecordingStudio_moveable", tag: "v6.0.1"
gem "recording_studio_icons", github: "bowerbird-app/RecordingStudio_icons", tag: "v0.4.1"

# Asset pipeline and frontend
gem "tailwindcss-rails", "~> 4.0"
gem "importmap-rails"
gem "stimulus-rails"
gem "turbo-rails"

# View components
gem "view_component"
gem "devise"

group :development, :test do
  gem "debug", platforms: %i[mri mingw x64_mingw]
end

group :development do
  gem "web-console"
end

group :test do
  gem "capybara"
  gem "selenium-webdriver"
end