<h1>Local Time Demo</h1>

<p>
  This page demonstrates the <code>local-time</code> and
  <code>relative-time</code> JavaScript component.
</p>

<h2>Local Time</h2>

<table>
  <thead>
    <tr>
      <th>Example</th>
      <th>Rendered Time</th>
      <th>Datetime</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Current time in user locale</td>
      <td>
        <time class="local-time" datetime="<%= @now.utc.iso8601 %>">
          <%= @now.utc.strftime("%d %b %Y, %I:%M %P UTC") %>
        </time>
      </td>
      <td><%= @now.utc.iso8601 %></td>
    </tr>

    <tr>
      <td>Existing title should be preserved</td>
      <td>
        <time
          class="local-time"
          datetime="<%= @now.utc.iso8601 %>"
          title="Custom title should not be overwritten"
        >
          <%= @now.utc.strftime("%d %b %Y, %I:%M %P UTC") %>
        </time>
      </td>
      <td><%= @now.utc.iso8601 %></td>
    </tr>
  </tbody>
</table>
<h2>Relative Time</h2>

<table>
  <thead>
    <tr>
      <th>Range</th>
      <th>Rendered Relative Time</th>
      <th>Datetime</th>
    </tr>
  </thead>
  <tbody>
    <% examples = [
      ["Just now", 30.seconds.ago],
      ["Minutes ago", 12.minutes.ago],
      ["Hours ago", 5.hours.ago],
      ["Yesterday", 25.hours.ago],
      ["Days ago", 3.days.ago],
      ["Weeks ago", 15.days.ago],
      ["Months ago", 120.days.ago],
      ["Absolute date", 400.days.ago]
    ] %>

    <% examples.each do |label, timestamp| %>
      <tr>
        <td><%= label %></td>
        <td>
          <time
            class="local-time relative-time"
            datetime="<%= timestamp.utc.iso8601 %>"
          >
            <%= timestamp.utc.strftime("%d %b %Y, %I:%M %P UTC") %>
          </time>
        </td>
        <td><%= timestamp.utc.iso8601 %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>Invalid / Missing Datetime</h2>

<table>
  <thead>
    <tr>
      <th>Example</th>
      <th>Rendered Content</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Invalid datetime</td>
      <td>
        <time class="local-time" datetime="not-a-valid-date">
          Fallback text should remain
        </time>
      </td>
    </tr>

    <tr>
      <td>Missing datetime</td>
      <td>
        <time class="local-time">
          Fallback text should remain
        </time>
      </td>
    </tr>
  </tbody>
</table>
