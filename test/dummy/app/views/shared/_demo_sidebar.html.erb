<% DemoCatalog.sections.each_with_index do |section, section_index| %>
  <% if section_index.positive? %>
    <%= render FlatPack::Sidebar::Divider::Component.new %>
  <% end %>

  <%= render FlatPack::Sidebar::SectionTitle::Component.new(title: section.fetch(:title)) %>

  <% section.fetch(:entries).each do |entry| %>
    <% next if entry[:search_only] %>

    <% if entry[:type] == :group %>
      <%= render FlatPack::Sidebar::Group::Component.new(
        title: entry.fetch(:title),
        icon: entry.fetch(:icon),
        open: false
      ) do |group| %>
        <% group.items do %>
          <% entry.fetch(:children).each do |child| %>
            <% next if child[:search_only] %>
            <%= render FlatPack::Sidebar::Item::Component.new(
              text: child.fetch(:title),
              href: child.fetch(:path),
              icon: child.fetch(:icon),
              active: false
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        text: entry.fetch(:title),
        href: entry.fetch(:path),
        icon: entry.fetch(:icon),
        active: false
      ) %>
    <% end %>
  <% end %>
<% end %>

<%= render FlatPack::Sidebar::Group::Component.new(
  title: "Login Demo",
  icon: :settings,
  open: false
) do |group| %>
  <% group.items do %>
    <%= render FlatPack::Sidebar::Item::Component.new(
      text: "Sign in",
      href: new_user_session_path,
      icon: :settings,
      active: false
    ) %>
    <% if user_signed_in? %>
      <%= button_to destroy_user_session_path, method: :delete,
            class: "w-full",
            form: {data: {turbo: false}} do %>
        <span class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium transition-colors rounded-lg mx-2 text-[var(--sidebar-item-text-color)] hover:bg-[var(--sidebar-item-hover-background-color)] hover:text-[var(--sidebar-item-hover-text-color)]">
          <span class="flex-shrink-0 flex items-center justify-center w-5 h-5">
            <%= render FlatPack::Shared::IconComponent.new(name: :user, size: :md) %>
          </span>
          <span class="text-left">Logout</span>
        </span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
