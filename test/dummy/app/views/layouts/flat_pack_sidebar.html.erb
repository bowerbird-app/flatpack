<!DOCTYPE html>
<html data-theme="rounded" class="h-full overflow-hidden overscroll-none">
  <head>
    <title><%= content_for(:title) || "FlatPack Studio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/flat_pack_stylesheets" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="m-0 h-full overflow-hidden overscroll-none bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
    <%= render FlatPack::SkipLink::Component.new(href: "#main") %>
    <%= render "layouts/icon_sprite" %>

    <%= render FlatPack::SidebarLayout::Component.new(
      side: :left,
      storage_key: "flatpack-dummy-studio-shell"
    ) do |layout| %>
      <% layout.sidebar do %>
        <%= render "layouts/flat_pack/sidebar", sidebar_side: :left %>
      <% end %>

      <% layout.top_nav do %>
        <%= render "layouts/flat_pack/top_nav" %>
      <% end %>

      <% layout.main do %>
        <main id="main" tabindex="-1" class="h-full overflow-auto p-4 sm:p-6 bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
          <% if notice.present? %>
            <%= render FlatPack::Alert::Component.new(description: notice, style: :success, dismissible: true, class: "mb-4") %>
          <% end %>
          <% if alert.present? %>
            <%= render FlatPack::Alert::Component.new(description: alert, style: :danger, dismissible: true, class: "mb-4") %>
          <% end %>

          <%= yield %>
        </main>
      <% end %>
    <% end %>
  </body>
</html>
