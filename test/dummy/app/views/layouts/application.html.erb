<!DOCTYPE html>
<html class="h-full overflow-hidden overscroll-none">
  <head>
    <title>FlatPack Demo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/flat_pack_stylesheets" %>
    <%= javascript_importmap_tags %>
    <script>
      // Activate the sidebar nav item matching the current URL.
      // Runs on every Turbo navigation (turbo:load). Registered once here in
      // <head> so Turbo Drive does not re-register it on subsequent navigations.
      (function () {
        function activateSidebarNav() {
          var path = window.location.pathname;

          // Find the item whose stripped href is the longest prefix of (or exact
          // match to) the current pathname — this avoids false positives from
          // short paths like "/demo" matching every "/demo/*" page.
          var bestLink = null;
          var bestLen  = 0;

          document.querySelectorAll('[data-flat-pack-sidebar-item="true"]').forEach(function (link) {
            var href = link.getAttribute('href');
            if (!href) return;
            var hrefPath = href.split('?')[0].split('#')[0];
            if (!hrefPath || hrefPath === '/') return;

            if ((path === hrefPath || path.startsWith(hrefPath + '/')) && hrefPath.length > bestLen) {
              bestLink = link;
              bestLen  = hrefPath.length;
            }
          });

          if (!bestLink) return;

          // Swap inactive → active CSS classes on the link element
          bestLink.classList.remove(
            'text-[var(--sidebar-item-text-color)]',
            'hover:bg-[var(--sidebar-item-hover-background-color)]',
            'hover:text-[var(--sidebar-item-hover-text-color)]'
          );
          bestLink.classList.add(
            'bg-[var(--sidebar-item-active-background-color)]',
            'text-[var(--sidebar-item-active-text-color)]'
          );
          bestLink.setAttribute('aria-current', 'page');

          // Swap inactive → active CSS class on the icon wrapper
          var iconEl = bestLink.querySelector('[data-flat-pack-sidebar-item-icon="true"]');
          if (iconEl) {
            iconEl.classList.remove('text-[var(--sidebar-item-icon-color)]');
            iconEl.classList.add('text-[var(--sidebar-item-active-icon-color)]');
          }

          // Open the nearest parent sidebar group if it is currently collapsed.
          // Clicking the toggle button also persists open state to localStorage,
          // so subsequent visits to pages in the same group stay open.
          var groupEl = bestLink.closest('[data-controller*="flat-pack--sidebar-group"]');
          if (groupEl) {
            var btn = groupEl.querySelector('[data-flat-pack--sidebar-group-target="button"]');
            if (btn && btn.getAttribute('aria-expanded') === 'false') {
              btn.click();
            }
          }
        }

        document.addEventListener('turbo:load', activateSidebarNav);
      })();
    </script>
  </head>

  <body class="m-0 h-full overflow-hidden overscroll-none bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]" data-controller="dark-mode">
    <%= render "layouts/icon_sprite" %>

    <% sidebar_side = params[:side].in?(%w[left right]) ? params[:side].to_sym : :left %>
    <%= render FlatPack::SidebarLayout::Component.new(
      side: sidebar_side,
      storage_key: "flatpack-dummy-shell"
    ) do |layout| %>
      <% layout.sidebar do %>
        <% cache ["dummy/sidebar-shell-v4", FlatPack::VERSION, sidebar_side, user_signed_in?] do %>
          <%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
          <% sidebar.header do %>
            <%= render FlatPack::Sidebar::Header::Component.new(
              brand_abbr: "FP",
              title: "FlatPack",
              subtitle: "Dummy App"
            ) %>
          <% end %>

          <% sidebar.items do %>
            <nav class="py-4 space-y-1" aria-label="Main navigation">
              <%= render "shared/demo_sidebar" %>
            </nav>
          <% end %>

          <% sidebar.footer do %>
            <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
              FlatPack Demo Components
            <% end %>
          <% end %>

          <% end %>
        <% end %>
      <% end %>

      <% layout.top_nav do %>
        <%= render FlatPack::TopNav::Component.new do |nav| %>
          <% nav.left do %>
            <%= render FlatPack::Button::Component.new(
              icon: "menu",
              icon_only: true,
              style: :ghost,
              size: :md,
              aria: { label: "Toggle sidebar" },
              data: {
                "flat-pack--sidebar-layout-target": "mobileToggle",
                action: "click->flat-pack--sidebar-layout#toggleMobile"
              },
              class: "md:hidden border-0 shadow-none text-(--top-nav-item-icon-color) hover:bg-(--top-nav-item-hover-background-color) hover:text-(--top-nav-item-hover-text-color) transition-colors"
            ) %>
            <span class="text-sm font-medium text-[var(--surface-muted-content-color)]">FlatPack Demo</span>
          <% end %>

          <% nav.center do %>
            <%= render FlatPack::Search::Component.new(
              search_url: demo_search_results_path,
              placeholder: "Search demo pages...",
              no_results_text: "No demo pages found",
              min_characters: 1,
              debounce: 150,
              class: "max-w-xl"
            ) %>
          <% end %>

          <% nav.right do %>
            <div
              class="ml-auto flex items-center gap-3"
              data-controller="flat-pack--theme"
              data-flat-pack--theme-themes-value='[{"value":"system","label":"System"},{"value":"light","label":"Light"},{"value":"dark","label":"Dark"},{"value":"ocean","label":"Ocean"},{"value":"rounded","label":"Rounded"},{"value":"sunrise","label":"Sunrise"}]'
            >
              <%= render FlatPack::Button::Dropdown::Component.new(
                text: "Theme",
                style: :ghost,
                size: :sm,
                placement: :bottom_right,
                icon: "cog"
              ) do |dropdown| %>
                <% dropdown.menu_item(
                  text: "System",
                  data: { action: "click->flat-pack--theme#switch click->flat-pack--button-dropdown#toggle", theme_value: "system" }
                ) %>
                <% dropdown.menu_item(
                  text: "Light",
                  data: { action: "click->flat-pack--theme#switch click->flat-pack--button-dropdown#toggle", theme_value: "light" }
                ) %>
                <% dropdown.menu_item(
                  text: "Dark",
                  data: { action: "click->flat-pack--theme#switch click->flat-pack--button-dropdown#toggle", theme_value: "dark" }
                ) %>
                <% dropdown.menu_item(
                  text: "Ocean",
                  data: { action: "click->flat-pack--theme#switch click->flat-pack--button-dropdown#toggle", theme_value: "ocean" }
                ) %>
                <% dropdown.menu_item(
                  text: "Rounded",
                  data: { action: "click->flat-pack--theme#switch click->flat-pack--button-dropdown#toggle", theme_value: "rounded" }
                ) %>
                <% dropdown.menu_item(
                  text: "Sunrise",
                  data: { action: "click->flat-pack--theme#switch click->flat-pack--button-dropdown#toggle", theme_value: "sunrise", theme_label: "Sunrise" }
                ) %>
              <% end %>

            <%= render FlatPack::Button::Component.new(
              icon: "bell",
              icon_only: true,
              style: :ghost,
              size: :sm,
              aria: { label: "Notifications" }
            ) %>
            </div>
          <% end %>

        <% end %>
      <% end %>

      <% layout.main do %>
        <main class="p-4 sm:p-8 bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
          <div class="max-w-4xl mx-auto pb-24">
            <% if notice.present? %>
              <%= render FlatPack::Alert::Component.new(description: notice, style: :success, dismissible: true, class: "mb-4") %>
            <% end %>
            <% if alert.present? %>
              <%= render FlatPack::Alert::Component.new(description: alert, style: :danger, dismissible: true, class: "mb-4") %>
            <% end %>

            <%= yield %>

            <% if @demo_theme_token_rows.present? %>
              <%= render "pages/theme_token_reference", title: @demo_theme_token_title, rows: @demo_theme_token_rows %>
            <% end %>

          </div>
        </main>
      <% end %>
    <% end %>
  </body>
</html>
