<%# Controller: no instance variables required — gallery_cards is defined inline in the view. %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Card Media",
  subtitle: "Gallery grids, media slots, and aspect ratio examples."
) %>

<%= render "pages/component_method_variables_table", component: :card %>


  <!-- Media Gallery Cards -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Media Gallery Cards", anchor_link: true, subtitle: "A compact file-browser style card grid for image-heavy layouts.") %>
    <p class="mb-4 text-sm text-[var(--surface-muted-content-color)]">
      This layout keeps the image preview dominant while moving filename and size metadata below the card, which works well for asset libraries and media pickers.
    </p>
    <%
      gallery_cards = [
        {name: "IMG_4985.HEIC", size: "3.9 MB", image_url: "https://images.unsplash.com/photo-1582053433976-25c00369fc93?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_5214.HEIC", size: "4 MB", image_url: "https://images.unsplash.com/photo-1614926857083-7be149266cda?ixlib=rb-1.2.1&ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_3851.HEIC", size: "3.8 MB", image_url: "https://images.unsplash.com/photo-1614705827065-62c3dc488f40?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_4278.HEIC", size: "4.1 MB", image_url: "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_6842.HEIC", size: "4 MB", image_url: "https://images.unsplash.com/photo-1586348943529-beaae6c28db9?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_3284.HEIC", size: "3.9 MB", image_url: "https://images.unsplash.com/photo-1497436072909-60f360e1d4b1?ixlib=rb-1.2.1&ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_4841.HEIC", size: "3.8 MB", image_url: "https://images.unsplash.com/photo-1547036967-23d11aacaee0?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80"},
        {name: "IMG_5644.HEIC", size: "4 MB", image_url: "https://images.unsplash.com/photo-1492724724894-7464c27d0ceb?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80"}
      ]
    %>
    <div class="mb-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4 xl:gap-x-8">
      <% gallery_cards.each do |image| %>
        <%= render FlatPack::Card::Component.new(
          style: :flat,
          hover: :subtle,
          "style" => "background-color: transparent",
          class: "group shadow-none ring-0 ring-[var(--color-primary)] transition duration-200 has-[:checked]:ring-2 has-[:checked]:ring-offset-2 has-[:checked]:ring-offset-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 focus-visible:ring-offset-white"
        ) do |card| %>
          <% card.media(
            aspect_ratio: "4/3",
            padding: :none,
            class: "relative rounded-lg bg-gray-100 dark:bg-gray-800"
          ) do %>
            <a
              href="#gallery-<%= image[:name].parameterize %>"
              aria-label="View details for <%= image[:name] %>"
              class="absolute inset-0 z-10 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
            ></a>
            <%= image_tag image[:image_url], class: "pointer-events-none h-full w-full rounded-lg object-cover transition duration-200 group-hover:opacity-75", alt: "" %>
            <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between gap-3 p-3 opacity-0 transition duration-200 group-hover:opacity-100 group-focus-within:opacity-100">
              <div class="pointer-events-auto rounded-md bg-white/90 p-2 shadow-sm ring-1 ring-black/5 backdrop-blur-sm dark:bg-gray-900/85 dark:ring-white/10">
                <%= render FlatPack::Checkbox::Component.new(
                  name: "selected_images[]",
                  value: image[:name],
                  aria: {label: "Select #{image[:name]}"},
                  class: "bg-white dark:bg-gray-950"
                ) %>
              </div>
              <div class="pointer-events-auto flex items-center gap-2">
                <%= render FlatPack::Button::Component.new(
                  icon: "pencil-square",
                  icon_only: true,
                  style: :secondary,
                  size: :sm,
                  href: "#edit-#{image[:name].parameterize}",
                  aria: {label: "Edit #{image[:name]}"},
                  class: "backdrop-blur-sm shadow-sm"
                ) %>
                <%= render FlatPack::Button::Component.new(
                  icon: "trash",
                  icon_only: true,
                  style: :secondary,
                  size: :sm,
                  href: "#delete-#{image[:name].parameterize}",
                  aria: {label: "Delete #{image[:name]}"},
                  class: "backdrop-blur-sm shadow-sm"
                ) %>
              </div>
            </div>
          <% end %>
          <% card.body(padding: :none, class: "pointer-events-none px-3 py-2") do %>
            <p class="block truncate text-sm font-medium text-[var(--surface-content-color)]"><%= image[:name] %></p>
            <p class="block text-sm font-medium text-[var(--color-primary)]"><%= image[:size] %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      language: "erb",
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;% gallery_cards = [
          {name: &quot;IMG_4985.HEIC&quot;, size: &quot;3.9 MB&quot;, image_url: &quot;https://images.unsplash.com/photo-1582053433976-25c00369fc93?...&quot;},
          {name: &quot;IMG_5214.HEIC&quot;, size: &quot;4 MB&quot;, image_url: &quot;https://images.unsplash.com/photo-1614926857083-7be149266cda?...&quot;}
        ] %&gt;

        &lt;div class=&quot;grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4&quot;&gt;
          &lt;% gallery_cards.each do |image| %&gt;
            &lt;%= render FlatPack::Card::Component.new(
              style: :flat,
              hover: :subtle,
              &quot;style&quot; =&gt; &quot;background-color: transparent&quot;,
              class: &quot;group shadow-none ring-0 ring-[var(--color-primary)] transition duration-200 has-[:checked]:ring-2 has-[:checked]:ring-offset-2 has-[:checked]:ring-offset-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 focus-visible:ring-offset-white&quot;
            ) do |card| %&gt;
              &lt;% card.media(aspect_ratio: &quot;4/3&quot;, padding: :none, class: &quot;relative rounded-lg bg-gray-100 dark:bg-gray-800&quot;) do %&gt;
                &lt;a
                  href=&quot;#gallery-#{image[:name].parameterize}&quot;
                  aria-label=&quot;View details for #{image[:name]}&quot;
                  class=&quot;absolute inset-0 z-10 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2&quot;
                &gt;&lt;/a&gt;
                &lt;%= image_tag image[:image_url], class: &quot;pointer-events-none h-full w-full rounded-lg object-cover group-hover:opacity-75&quot;, alt: &quot;&quot; %&gt;
                &lt;div class=&quot;pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between gap-3 p-3 opacity-0 transition duration-200 group-hover:opacity-100 group-focus-within:opacity-100&quot;&gt;
                  &lt;div class=&quot;pointer-events-auto rounded-md bg-white/90 p-2 shadow-sm ring-1 ring-black/5 backdrop-blur-sm dark:bg-gray-900/85 dark:ring-white/10&quot;&gt;
                    &lt;%= render FlatPack::Checkbox::Component.new(
                      name: &quot;selected_images[]&quot;,
                      value: image[:name],
                      aria: {label: &quot;Select #{image[:name]}&quot;},
                      class: &quot;bg-white dark:bg-gray-950&quot;
                    ) %&gt;
                  &lt;/div&gt;
                  &lt;div class=&quot;pointer-events-auto flex items-center gap-2&quot;&gt;
                    &lt;%= render FlatPack::Button::Component.new(
                      icon: &quot;pencil-square&quot;,
                      icon_only: true,
                      style: :secondary,
                      size: :sm,
                      href: &quot;#edit-#{image[:name].parameterize}&quot;,
                      aria: {label: &quot;Edit #{image[:name]}&quot;},
                      class: &quot;backdrop-blur-sm shadow-sm&quot;
                    ) %&gt;
                    &lt;%= render FlatPack::Button::Component.new(
                      icon: &quot;trash&quot;,
                      icon_only: true,
                      style: :secondary,
                      size: :sm,
                      href: &quot;#delete-#{image[:name].parameterize}&quot;,
                      aria: {label: &quot;Delete #{image[:name]}&quot;},
                      class: &quot;backdrop-blur-sm shadow-sm&quot;
                    ) %&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;% end %&gt;
              &lt;% card.body(padding: :none, class: &quot;pointer-events-none px-3 py-2&quot;) do %&gt;
                &lt;p class=&quot;block truncate text-sm font-medium text-[var(--surface-content-color)]&quot;&gt;&lt;%= image[:name] %&gt;&lt;/p&gt;
                &lt;p class=&quot;block text-sm font-medium text-[var(--color-primary)]&quot;&gt;&lt;%= image[:size] %&gt;&lt;/p&gt;
              &lt;% end %&gt;
            &lt;% end %&gt;
          &lt;% end %&gt;
        &lt;/div&gt;
      CODE
    ) %>
  </section>
  <!-- Media Slot -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Media Slot", anchor_link: true, subtitle: "Examples for Media Slot.") %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "16/9") do %>
          <%= image_tag "https://picsum.photos/800/450?random=11", class: "w-full h-full object-cover", alt: "Sample media" %>
        <% end %>
        <% card.body do %>
          <h3 class="text-lg font-semibold mb-2">Standard Media Slot</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)]">Media appears above content with default card body spacing.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "16/9", padding: :none) do %>
          <%= image_tag "https://picsum.photos/800/450?random=12", class: "w-full h-full object-cover", alt: "Edge to edge media" %>
        <% end %>
        <% card.body do %>
          <h3 class="text-lg font-semibold mb-2">Edge-to-Edge Top Media</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)]">Using <code>card.media(..., padding: :none)</code> removes top and side media spacing so the image touches the card edges.</p>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(style: :default) do |card| %&gt;
          &lt;% card.media(aspect_ratio: "16/9", padding: :none) do %&gt;
            &lt;%= image_tag "https://picsum.photos/800/450?random=12", class: "w-full h-full object-cover", alt: "Edge to edge media" %&gt;
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <h3 class="text-lg font-semibold mb-2">Edge-to-Edge Top Media</h3>
            <p class="text-sm text-[var(--surface-muted-content-color)]">
              Using <code>card.media(..., padding: :none)</code> removes top and side media spacing so the image touches the card edges.
            </p>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

  <!-- Media Aspect Ratios -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Media Aspect Ratios", anchor_link: true, subtitle: "Examples for Media Aspect Ratios.") %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "16/9") do %>
          <div class="w-full h-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-bold">
            16:9 Aspect Ratio
          </div>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Wide format, great for videos and banners.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "4/3") do %>
          <div class="w-full h-full bg-gradient-to-br from-green-400 to-green-600 flex items-center justify-center text-white font-bold">
            4:3 Aspect Ratio
          </div>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Classic format, good for product images.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "1/1") do %>
          <div class="w-full h-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center text-white font-bold">
            1:1 Square
          </div>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Square format, perfect for avatars.</p>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(style: :default) do |card| %&gt;
          &lt;% card.media(aspect_ratio: "16/9") do %&gt;
            <div class="w-full h-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white font-bold">
              16:9 Aspect Ratio
            </div>
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <p class="text-sm">Wide format, great for videos and banners.</p>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

<%= render "shared/related_demos",
  links: [
    {text: "Overview", href: demo_cards_path},
    {text: "Styles", href: demo_cards_styles_path},
    {text: "Composed", href: demo_cards_composed_path}
  ] %>
