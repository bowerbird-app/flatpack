<%= render FlatPack::PageTitle::Component.new(
  title: "Content",
  subtitle: "Long-form reading type. Wrap the article in Content and drop in headings, paragraphs, and lists."
) %>

<%= render "pages/component_method_variables_table", component: :content %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Long-form article",
    anchor_link: true,
    subtitle: "Paragraphs are 18px. Headings, the kicker, and the lead scale from that size. Primary stays on the kicker and links."
  ) %>

  <%= render FlatPack::Card::Component.new(class: "mt-6") do |card| %>
    <% card.body(class: "p-6 sm:p-8 lg:p-12") do %>
      <%= render FlatPack::Content::Component.new(class: "mx-auto max-w-4xl") do |content| %>
        <p class="fp-content-kicker">Publish faster</p>
        <h1>A mastered workflow</h1>
        <p class="fp-content-lead">
          Your stories deserve a platform as refined as your prose. The path from blank page to published work stays out of the way so you can stay on the narrative.
        </p>

        <p>
          Experience a workspace designed by writers, for writers. From version control to live collaborative editing, every feature is there so the trip from first draft to final release stays fluid.
        </p>

        <ul role="list">
          <li class="flex gap-x-3">
            <%= render FlatPack::Shared::IconComponent.new(name: "arrow-up-tray", size: :md, class: "mt-1 flex-none text-[var(--color-primary)]") %>
            <span><strong>One-click distribution.</strong> Turn a manuscript into a live publication or a print-ready file. Skip the layout busywork.</span>
          </li>
          <li class="flex gap-x-3">
            <%= render FlatPack::Shared::IconComponent.new(name: "lock-closed", size: :md, class: "mt-1 flex-none text-[var(--color-primary)]") %>
            <span><strong>Built-in proofing.</strong> Linguistic checks scan for tone, clarity, and consistency so the voice stays yours.</span>
          </li>
          <li class="flex gap-x-3">
            <%= render FlatPack::Shared::IconComponent.new(name: "circle-stack", size: :md, class: "mt-1 flex-none text-[var(--color-primary)]") %>
            <span><strong>Cloud syncing.</strong> Work saves across devices. A sentence is not lost if you go offline.</span>
          </li>
        </ul>

        <p>
          Words stay the priority. Layout and metadata run in the background, so the hours that used to go to admin go back to the draft.
        </p>

        <h2>No publisher? No problem.</h2>
        <p>
          You own the rights and the audience. Independent creators can run a list, watch readership, and grow a brand from one dashboard.
        </p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Content::Component.new do |content| %&gt;
        &lt;p class=&quot;fp-content-kicker&quot;&gt;Publish faster&lt;/p&gt;
        &lt;h1&gt;A mastered workflow&lt;/h1&gt;
        &lt;p class=&quot;fp-content-lead&quot;&gt;Stories deserve a platform as refined as the prose.&lt;/p&gt;
        &lt;p&gt;Body copy sits at 18px. Headings, lists, and links scale from that size.&lt;/p&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Lists and a quote",
    anchor_link: true,
    subtitle: "Plain lists keep bullets. Quotes pick up the shared quote tokens."
  ) %>

  <%= render FlatPack::Card::Component.new(class: "mt-6") do |card| %>
    <% card.body(class: "p-6 sm:p-8") do %>
      <%= render FlatPack::Content::Component.new(class: "max-w-2xl") do |content| %>
        <h3>What to wrap</h3>
        <ul>
          <li>Marketing pages and docs</li>
          <li>CMS HTML and markdown output</li>
          <li>Editorial sections inside a card or main column</li>
        </ul>
        <blockquote>Typography is the craft of endowing human language with a durable visual form.</blockquote>
        <p>Leave UI chrome, forms, and data tables outside this wrapper.</p>
      <% end %>
    <% end %>
  <% end %>
</section>
