<%= render FlatPack::PageTitle::Component.new(
  title: "Content",
  subtitle: "Wrap CMS HTML in Content. Bare headings and paragraphs take the kit reading scale."
) %>

<%= render "pages/component_method_variables_table", component: :content %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Long-form article",
    anchor_link: true,
    subtitle: "Same sizes and spacing as the main demo. A first paragraph before the title is the kicker. The paragraph after h1 is the lead."
  ) %>

  <%= render FlatPack::Card::Component.new(class: "mt-6") do |card| %>
    <% card.body(class: "p-6 sm:p-8 lg:p-12") do %>
      <%= render FlatPack::Content::Component.new(class: "mx-auto max-w-4xl") do |content| %>
        <p>Publish Faster</p>
        <h1>A Mastered Workflow</h1>
        <p>
          Your stories deserve a platform as refined as your prose. Our intuitive interface streamlines the path from blank page to published work, removing the technical hurdles that stall your creative momentum so you can focus entirely on the narrative.
        </p>

        <p>
          Experience a workspace designed by writers, for writers. From seamless version control to real-time collaborative editing, every feature is polished to ensure your journey from first draft to final release is fluid, focused, and fast.
        </p>

        <ul role="list">
          <li class="flex gap-x-3">
            <%= render FlatPack::Shared::IconComponent.new(name: "arrow-up-tray", size: :md, class: "mt-1 flex-none text-[var(--color-primary)]") %>
            <span><strong>One-Click Distribution.</strong> Turn your manuscript into a live digital publication or print-ready file instantly. No more manual formatting headaches.</span>
          </li>
          <li class="flex gap-x-3">
            <%= render FlatPack::Shared::IconComponent.new(name: "lock-closed", size: :md, class: "mt-1 flex-none text-[var(--color-primary)]") %>
            <span><strong>Built-in Proofing.</strong> Advanced linguistic AI scans for tone, clarity, and consistency so your voice always hits the mark.</span>
          </li>
          <li class="flex gap-x-3">
            <%= render FlatPack::Shared::IconComponent.new(name: "circle-stack", size: :md, class: "mt-1 flex-none text-[var(--color-primary)]") %>
            <span><strong>Cloud Syncing.</strong> Your work is automatically saved and backed up across all devices. Never lose a sentence, even if you’re offline.</span>
          </li>
        </ul>

        <p>
          Your words are the priority. We handle the rest. By automating the heavy lifting of layout and metadata, we give you back the hours you used to spend on "admin" tasks. It’s time to move beyond the draft and share your vision with the world.
        </p>

        <h2>No Publisher? No Problem.</h2>
        <p>
          You own your rights and your audience. Our platform empowers independent creators to build their own literary empires without the gatekeepers. Manage your subscribers, track your readership analytics, and scale your brand—all from a single, elegant dashboard designed for the modern storyteller.
        </p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Content::Component.new do |content| %&gt;
        &lt;p&gt;Publish faster&lt;/p&gt;
        &lt;h1&gt;A mastered workflow&lt;/h1&gt;
        &lt;p&gt;Stories deserve a platform as refined as the prose.&lt;/p&gt;
        &lt;p&gt;Body copy, lists, and headings take the kit scale without extra classes.&lt;/p&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Lists and a quote",
    anchor_link: true,
    subtitle: "Plain lists keep bullets. Quotes pick up the shared quote tokens."
  ) %>

  <%= render FlatPack::Card::Component.new(class: "mt-6") do |card| %>
    <% card.body(class: "p-6 sm:p-8") do %>
      <%= render FlatPack::Content::Component.new(class: "max-w-2xl") do |content| %>
        <h3>What to wrap</h3>
        <ul>
          <li>Marketing pages and docs</li>
          <li>CMS HTML and markdown output</li>
          <li>Editorial sections inside a card or main column</li>
        </ul>
        <blockquote>Typography is the craft of endowing human language with a durable visual form.</blockquote>
        <p>Leave UI chrome, forms, and data tables outside this wrapper.</p>
      <% end %>
    <% end %>
  <% end %>
</section>
