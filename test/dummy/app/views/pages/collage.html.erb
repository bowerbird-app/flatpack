<%= render FlatPack::PageTitle::Component.new(
  title: "Collage",
  subtitle: "Cards lean a little. On a phone they line up."
) %>

<%= render "pages/component_method_variables_table", components: [:collage, :card, :badge] %>

<%
  erb_output_open = "<" + "%="
  erb_tag_close = "%" + ">"
  collage_photos = [
    {src: "/masonry/harbour.svg", alt: "Harbour at dusk", badge: "Harbour", title: "Blue hour", date: "12 Mar"},
    {src: "/masonry/cliff.svg", alt: "Sea cliff in late light", badge: "Cliff", title: "The edge", date: "3 Apr"},
    {src: "/masonry/studio.svg", alt: "Studio window", badge: "Studio", title: "North light", date: "18 Apr"},
    {src: "/masonry/orchard.svg", alt: "Orchard path", badge: "Orchard", title: "Late fruit", date: "2 May"},
    {src: "/masonry/jetty.svg", alt: "Jetty at blue hour", badge: "Jetty", title: "Low tide", date: "9 May"},
    {src: "/masonry/kiln.svg", alt: "Kiln yard", badge: "Kiln", title: "Warm brick", date: "21 May"},
    {src: "/masonry/lantern.svg", alt: "Lantern on a porch", badge: "Night", title: "Porch", date: "6 Jun"},
    {src: "/masonry/quay.svg", alt: "Quay stones", badge: "Quay", title: "Stone", date: "14 Jun"},
    {src: "/masonry/meadow.svg", alt: "Meadow edge", badge: "Field", title: "After rain", date: "30 Jun"}
  ]
%>

<section class="mb-12" id="wall">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "The wall",
    anchor_link: true,
    subtitle: "Nine photos, then a place to add one."
  ) %>
  <div id="collage-wall" class="rounded-[var(--radius-lg)] border border-[var(--surface-border-color)]">
    <%= render FlatPack::Collage::Component.new(columns: 3, scatter: :subtle, stack_below: :md) do |collage| %>
      <% collage_photos.each do |photo| %>
        <% collage.item do %>
          <%= render "pages/collage_card", photo: photo %>
        <% end %>
      <% end %>
    <% end %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No stories yet",
      description: "Add a photo and it joins the scatter.",
      icon: :photo,
      width: :md
    ) do |empty| %>
      <% empty.item do %>
        <%= render FlatPack::Button::Component.new(text: "Add a photo", style: :primary) %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "A card in the scatter (ERB)",
    language: "erb",
    class: "mt-4",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Collage::Component.new(columns: 3, scatter: :subtle, stack_below: :md) do |collage| #{erb_tag_close}
        #{erb_output_open} collage.item do #{erb_tag_close}
          #{erb_output_open} render FlatPack::Card::Component.new(shadow: :sm, padding: :none) do |card| #{erb_tag_close}
            #{erb_output_open} card.media(aspect_ratio: "4/3", padding: :none) do #{erb_tag_close}
              #{erb_output_open} image_tag "/masonry/harbour.svg", alt: "Harbour at dusk", class: "h-full w-full object-cover" #{erb_tag_close}
            #{erb_output_open} end #{erb_tag_close}
            #{erb_output_open} card.body(padding: :sm) do #{erb_tag_close}
              #{erb_output_open} render FlatPack::Badge::Component.new(text: "Harbour", size: :xs) #{erb_tag_close}
            #{erb_output_open} end #{erb_tag_close}
          #{erb_output_open} end #{erb_tag_close}
        #{erb_output_open} end #{erb_tag_close}
      #{erb_output_open} end #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12" id="scatters">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Square, subtle, loose",
    anchor_link: true,
    subtitle: "The same four cards. Only the scatter changes."
  ) %>

  <div class="mb-8" id="collage-none">
    <%= render FlatPack::SectionTitle::Component.new(title: "Square", subtitle: "No tilt, no shift.") %>
    <%= render FlatPack::Collage::Component.new(columns: 4, scatter: :none, stack_below: :md) do |collage| %>
      <% collage_photos.first(4).each do |photo| %>
        <% collage.item do %>
          <%= render "pages/collage_card", photo: photo %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="mb-8" id="collage-subtle">
    <%= render FlatPack::SectionTitle::Component.new(title: "Subtle", subtitle: "The default lean.") %>
    <%= render FlatPack::Collage::Component.new(columns: 4, scatter: :subtle, stack_below: :md) do |collage| %>
      <% collage_photos.first(4).each do |photo| %>
        <% collage.item do %>
          <%= render "pages/collage_card", photo: photo %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div id="collage-loose">
    <%= render FlatPack::SectionTitle::Component.new(title: "Loose", subtitle: "The same pattern, leaned further.") %>
    <%= render FlatPack::Collage::Component.new(columns: 4, scatter: :loose, stack_below: :md) do |collage| %>
      <% collage_photos.first(4).each do |photo| %>
        <% collage.item do %>
          <%= render "pages/collage_card", photo: photo %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>

<section class="mb-12" id="pinned">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "One card steps forward",
    anchor_link: true,
    subtitle: "The middle card has its own tilt and sits in front."
  ) %>
  <div id="collage-pinned">
    <%= render FlatPack::Collage::Component.new(columns: 3, scatter: :subtle, stack_below: :md) do |collage| %>
      <% collage.item do %>
        <%= render "pages/collage_card", photo: collage_photos[0] %>
      <% end %>
      <% collage.item(rotate: -6, offset: ["0.5rem", "-0.75rem"], z: 6) do %>
        <%= render "pages/collage_card", photo: collage_photos[4] %>
      <% end %>
      <% collage.item do %>
        <%= render "pages/collage_card", photo: collage_photos[2] %>
      <% end %>
    <% end %>
  </div>
</section>
