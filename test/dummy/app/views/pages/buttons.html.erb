  <%= render FlatPack::PageTitle::Component.new(
    title: "Button Component",
    subtitle: "Buttons with different schemes and configurations."
  ) %>

  <%= render "pages/component_method_variables_table", component: :button %>


  <!-- Basic Buttons -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Basic Buttons", anchor_link: true, subtitle: "Examples for Basic Buttons.") %>
    <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(text: "Primary", style: :primary) %>
      <%= render FlatPack::Button::Component.new(text: "Secondary", style: :secondary) %>
      <%= render FlatPack::Button::Component.new(text: "Ghost", style: :ghost) %>
      <%= render FlatPack::Button::Component.new(text: "Success", style: :success) %>
      <%= render FlatPack::Button::Component.new(text: "Warning", style: :warning) %>
      <%= render FlatPack::Button::Component.new(text: "Danger", style: :danger) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      snippets: [
        {
          label: "Primary",
          language: "erb",
          code: CGI.unescapeHTML(<<~'CODE')
            &lt;%= render FlatPack::Button::Component.new(text: "Primary", style: :primary) %&gt;
          CODE
        },
        {
          label: "Secondary",
          language: "erb",
          code: CGI.unescapeHTML(<<~'CODE')
            &lt;%= render FlatPack::Button::Component.new(text: "Secondary", style: :secondary) %&gt;
          CODE
        },
        {
          label: "Ghost",
          language: "erb",
          code: CGI.unescapeHTML(<<~'CODE')
            &lt;%= render FlatPack::Button::Component.new(text: "Ghost", style: :ghost) %&gt;
          CODE
        },
        {
          label: "Success",
          language: "erb",
          code: CGI.unescapeHTML(<<~'CODE')
            &lt;%= render FlatPack::Button::Component.new(text: "Success", style: :success) %&gt;
          CODE
        },
        {
          label: "Warning",
          language: "erb",
          code: CGI.unescapeHTML(<<~'CODE')
            &lt;%= render FlatPack::Button::Component.new(text: "Warning", style: :warning) %&gt;
          CODE
        },
        {
          label: "Danger",
          language: "erb",
          code: CGI.unescapeHTML(<<~'CODE')
            &lt;%= render FlatPack::Button::Component.new(text: "Danger", style: :danger) %&gt;
          CODE
        }
      ]
    ) %>
  </section>

  <!-- Button Sizes -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Button Sizes", anchor_link: true, subtitle: "Examples for Button Sizes.") %>
    <div class="flex items-center gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(text: "Small", style: :primary, size: :sm) %>
      <%= render FlatPack::Button::Component.new(text: "Medium (default)", style: :primary, size: :md) %>
      <%= render FlatPack::Button::Component.new(text: "Large", style: :primary, size: :lg) %>
    </div>
    <div class="flex items-center gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(text: "Small", style: :secondary, size: :sm) %>
      <%= render FlatPack::Button::Component.new(text: "Medium", style: :secondary, size: :md) %>
      <%= render FlatPack::Button::Component.new(text: "Large", style: :secondary, size: :lg) %>
    </div>
    <div class="flex items-center gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(text: "Small", style: :ghost, size: :sm) %>
      <%= render FlatPack::Button::Component.new(text: "Medium", style: :ghost, size: :md) %>
      <%= render FlatPack::Button::Component.new(text: "Large", style: :ghost, size: :lg) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(text: "Small", style: :primary, size: :sm) %&gt;
        &lt;%= render FlatPack::Button::Component.new(text: "Medium", style: :primary, size: :md) %&gt;
        &lt;%= render FlatPack::Button::Component.new(text: "Large", style: :primary, size: :lg) %&gt;
      CODE
    ) %>
  </section>

  <!-- Buttons as Links -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Buttons as Links", anchor_link: true, subtitle: "Examples for Buttons as Links.") %>
    <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(text: "Go Home", href: root_path, style: :primary) %>
      <%= render FlatPack::Button::Component.new(text: "View Tables", href: demo_tables_basic_path, style: :secondary) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          text: "Go Home",
          href: root_path,
          style: :primary
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Links with Target -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Links with Target", anchor_link: true, subtitle: "Examples for Links with Target.") %>
    <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(
        text: "Open in New Tab",
        href: "https://github.com",
        style: :primary,
        target: "_blank"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Open in Same Tab",
        href: demo_tables_basic_path,
        style: :secondary,
        target: "_self"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Default (no target)",
        href: root_path,
        style: :ghost
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          text: "Open in New Tab",
          href: "https://github.com",
          style: :primary,
          target: "_blank"  # Automatically adds rel="noopener noreferrer"
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Buttons with ID and Custom Classes -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Buttons with ID and Custom Classes", anchor_link: true, subtitle: "Examples for Buttons with ID and Custom Classes.") %>
    <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(
        text: "Button with ID",
        style: :primary,
        id: "my-special-button"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Link with ID",
        href: root_path,
        style: :secondary,
        id: "my-special-link"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Custom Classes",
        style: :ghost,
        class: "text-lg font-bold"
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          text: "Button with ID",
          style: :primary,
          id: "my-special-button"
        ) %&gt;
        
        &lt;%= render FlatPack::Button::Component.new(
          text: "Custom Classes",
          style: :ghost,
          class: "text-lg font-bold"  # Additional classes are merged
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Full Width Buttons -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Full Width Button", anchor_link: true, subtitle: "Examples for Full Width Button.") %>
    <div class="mb-4">
      <%= render FlatPack::Button::Component.new(
        text: "Full Width Button",
        style: :primary,
        class: "w-full"
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          text: "Full Width Button",
          style: :primary,
          class: "w-full"
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Disabled Buttons -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Disabled Buttons", anchor_link: true, subtitle: "Examples for Disabled Buttons.") %>
    <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(
        text: "Disabled Primary",
        style: :primary,
        disabled: true
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Disabled Secondary",
        style: :secondary,
        disabled: true
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          text: "Disabled",
          style: :primary,
          disabled: true
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Icon Only Buttons -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Icon Only Buttons", anchor_link: true, subtitle: "Examples for Icon Only Buttons.") %>
    <div class="flex items-center gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :primary, size: :sm) %>
      <%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :primary, size: :md) %>
      <%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :primary, size: :lg) %>
    </div>
    <div class="flex items-center gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(icon: "settings", icon_only: true, style: :secondary) %>
      <%= render FlatPack::Button::Component.new(icon: "trash", icon_only: true, style: :ghost) %>
      <%= render FlatPack::Button::Component.new(icon: "check", icon_only: true, style: :success) %>
      <%= render FlatPack::Button::Component.new(icon: "alert", icon_only: true, style: :warning) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          icon: "search",
          icon_only: true,
          style: :primary
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Loading Buttons -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Loading Buttons", anchor_link: true, subtitle: "Examples for Loading Buttons.") %>
    <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
      <%= render FlatPack::Button::Component.new(text: "Saving", loading: true, style: :primary) %>
      <%= render FlatPack::Button::Component.new(text: "Processing", loading: true, style: :secondary) %>
      <%= render FlatPack::Button::Component.new(icon: "upload", icon_only: true, loading: true, style: :success) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Button::Component.new(
          text: "Saving",
          loading: true,
          style: :primary
        ) %&gt;
        
        &lt;%# Icon-only loading button %&gt;
        &lt;%= render FlatPack::Button::Component.new(
          icon: "upload",
          icon_only: true,
          loading: true,
          style: :success
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Regular Button Spacing (Not Grouped) -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Regular Button Spacing (Not Grouped)", anchor_link: true, subtitle: "Examples for Regular Button Spacing (Not Grouped).") %>
    <div class="flex gap-2 mb-4">
      <%= render FlatPack::Button::Component.new(text: "Save", style: :primary) %>
      <%= render FlatPack::Button::Component.new(text: "Cancel", style: :secondary) %>
      <%= render FlatPack::Button::Component.new(text: "Delete", style: :ghost) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        <div class="flex gap-2">
          &lt;%= render FlatPack::Button::Component.new(text: "Save", style: :primary) %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Cancel", style: :secondary) %&gt;
        </div>
      CODE
    ) %>
  </section>

<%= render "shared/related_demos",
    subtitle: "Sibling button-family components live on their own pages.",
    links: [
      {text: "Links", href: demo_links_path},
      {text: "Pill Buttons", href: demo_buttons_pills_path},
      {text: "Segmented", href: demo_buttons_segmented_path},
      {text: "Button Groups", href: demo_buttons_groups_path},
      {text: "Dropdowns", href: demo_buttons_dropdowns_path}
    ] %>
