<%= render FlatPack::PageTitle::Component.new(
  title: "Select",
  subtitle: "Dropdown select examples, including searchable multiselect options."
) %>

<%= render "pages/component_method_variables_table", component: :select %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Select Examples", anchor_link: true) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-[var(--stack-gap-md)]", style: "overflow: visible") do %>
      <%= render FlatPack::Select::Component.new(
        name: "country",
        options: ["United States", "Canada", "United Kingdom", "Australia"],
        label: "Country",
        placeholder: "Select a country",
        help_text: "Choose the country used for billing and tax rules.",
        required: true
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "city",
        options: ["New York", "Los Angeles", "Chicago", "Houston", "Phoenix"],
        label: "City",
        placeholder: "Search cities...",
        help_text: "Type to filter long option lists.",
        searchable: true
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "favorite_frameworks",
        options: [
          ["Ruby on Rails", "rails"],
          ["Hotwire", "hotwire"],
          ["React", "react"],
          ["Vue", "vue"],
          ["Svelte", "svelte"]
        ],
        label: "Favorite Frameworks",
        placeholder: "Search and select frameworks...",
        help_text: "Select every framework that applies.",
        searchable: true,
        multiple: true,
        value: ["rails", "hotwire"]
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "locations",
        options: [
          {
            label: "Australia",
            value: "australia",
            children: [
              { label: "VIC", value: "vic" },
              { label: "NSW", value: "nsw" },
              { label: "QLD", value: "qld" },
              { label: "WA", value: "wa" },
              { label: "SA", value: "sa" },
              { label: "TAS", value: "tas" }
            ]
          },
          {
            label: "Malaysia",
            value: "malaysia",
            children: [
              { label: "Penang", value: "penang" },
              { label: "Kuala Lumpur", value: "kuala-lumpur" },
              { label: "Selangor", value: "selangor" },
              { label: "Kedah", value: "kedah" },
              { label: "Pahang", value: "pahang" }
            ]
          }
        ],
        label: "Nested Multiselect Select",
        placeholder: "Select locations...",
        help_text: "Select a parent to include every child, or choose individual children.",
        searchable: true,
        multiple: true,
        value: ["australia"]
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "assignee",
        options: [],
        label: "Assignee (Remote Search)",
        placeholder: "Type at least 2 characters...",
        help_text: "Remote search loads matches after enough input.",
        searchable: true,
        search_mode: :remote,
        search_endpoint: demo_forms_select_options_path
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "reviewers",
        options: [["Alice Johnson", "alice-johnson"], ["Bob Smith", "bob-smith"]],
        label: "Reviewers (Remote + Multiselect)",
        placeholder: "Search teammates...",
        help_text: "Add one or more teammates to review the work.",
        searchable: true,
        multiple: true,
        value: ["alice-johnson"],
        search_mode: :remote,
        search_endpoint: demo_forms_select_options_path,
        min_search_length: 2
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Card::Component.new do |card| %&gt;
        &lt;% card.body(style: &quot;overflow: visible&quot;) do %&gt;
        &lt;%= render FlatPack::Select::Component.new(
          name: &quot;country&quot;,
          options: [&quot;United States&quot;, &quot;Canada&quot;, &quot;United Kingdom&quot;, &quot;Australia&quot;],
          label: &quot;Country&quot;,
          placeholder: &quot;Select a country&quot;,
          help_text: &quot;Choose the country used for billing and tax rules.&quot;,
          required: true
        ) %&gt;
    
        &lt;%= render FlatPack::Select::Component.new(
          name: &quot;city&quot;,
          options: [&quot;New York&quot;, &quot;Los Angeles&quot;, &quot;Chicago&quot;, &quot;Houston&quot;, &quot;Phoenix&quot;],
          label: &quot;City&quot;,
          placeholder: &quot;Search cities...&quot;,
          help_text: &quot;Type to filter long option lists.&quot;,
          searchable: true
        ) %&gt;

        &lt;%= render FlatPack::Select::Component.new(
          name: &quot;favorite_frameworks&quot;,
          options: [
            [&quot;Ruby on Rails&quot;, &quot;rails&quot;],
            [&quot;Hotwire&quot;, &quot;hotwire&quot;],
            [&quot;React&quot;, &quot;react&quot;],
            [&quot;Vue&quot;, &quot;vue&quot;],
            [&quot;Svelte&quot;, &quot;svelte&quot;]
          ],
          label: &quot;Favorite Frameworks&quot;,
          placeholder: &quot;Search and select frameworks...&quot;,
          help_text: &quot;Select every framework that applies.&quot;,
          searchable: true,
          multiple: true,
          value: [&quot;rails&quot;, &quot;hotwire&quot;]
        ) %&gt;

        &lt;%= render FlatPack::Select::Component.new(
          name: &quot;locations&quot;,
          options: [
            {
              label: &quot;Australia&quot;,
              value: &quot;australia&quot;,
              children: [
                { label: &quot;VIC&quot;, value: &quot;vic&quot; },
                { label: &quot;NSW&quot;, value: &quot;nsw&quot; },
                { label: &quot;QLD&quot;, value: &quot;qld&quot; },
                { label: &quot;WA&quot;, value: &quot;wa&quot; },
                { label: &quot;SA&quot;, value: &quot;sa&quot; },
                { label: &quot;TAS&quot;, value: &quot;tas&quot; }
              ]
            },
            {
              label: &quot;Malaysia&quot;,
              value: &quot;malaysia&quot;,
              children: [
                { label: &quot;Penang&quot;, value: &quot;penang&quot; },
                { label: &quot;Kuala Lumpur&quot;, value: &quot;kuala-lumpur&quot; },
                { label: &quot;Selangor&quot;, value: &quot;selangor&quot; },
                { label: &quot;Kedah&quot;, value: &quot;kedah&quot; },
                { label: &quot;Pahang&quot;, value: &quot;pahang&quot; }
              ]
            }
          ],
          label: &quot;Nested Multiselect Select&quot;,
          placeholder: &quot;Select locations...&quot;,
          help_text: &quot;Select a parent to include every child, or choose individual children.&quot;,
          searchable: true,
          multiple: true,
          value: [&quot;australia&quot;]
        ) %&gt;

        &lt;%= render FlatPack::Select::Component.new(
          name: &quot;assignee&quot;,
          options: [],
          label: &quot;Assignee (Remote Search)&quot;,
          placeholder: &quot;Type at least 2 characters...&quot;,
          help_text: &quot;Remote search loads matches after enough input.&quot;,
          searchable: true,
          search_mode: :remote,
          search_endpoint: demo_forms_select_options_path
        ) %&gt;

        &lt;%= render FlatPack::Select::Component.new(
          name: &quot;reviewers&quot;,
          options: [[&quot;Alice Johnson&quot;, &quot;alice-johnson&quot;], [&quot;Bob Smith&quot;, &quot;bob-smith&quot;]],
          label: &quot;Reviewers (Remote + Multiselect)&quot;,
          placeholder: &quot;Search teammates...&quot;,
          help_text: &quot;Add one or more teammates to review the work.&quot;,
          searchable: true,
          multiple: true,
          value: [&quot;alice-johnson&quot;],
          search_mode: :remote,
          search_endpoint: demo_forms_select_options_path,
          min_search_length: 2
        ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    language: "erb",
    title: "Select Examples"
  ) %>
</section>

<section id="select-with-icons" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Icons",
    anchor_link: true,
    subtitle: "A Heroicon sits before the label. The native select skips it."
  ) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-[var(--stack-gap-md)]", style: "overflow: visible") do %>
      <%= render FlatPack::Select::Component.new(
        name: "priority",
        id: "priority-select",
        options: [
          {label: "Low", value: "low", icon: "arrow-down"},
          {label: "Medium", value: "medium", icon: "minus"},
          {label: "High", value: "high", icon: "arrow-up"}
        ],
        label: "Priority",
        value: "high",
        placeholder: "Choose a priority",
        help_text: "The closed control keeps the icon for the selected value.",
        searchable: true
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "channels",
        id: "channels-select",
        options: [
          {label: "Mail", value: "mail", icon: "envelope"},
          {label: "Chat", value: "chat", icon: "chat-bubble-left"},
          {label: "Phone", value: "phone", icon: "phone"}
        ],
        label: "Channels",
        value: ["mail"],
        placeholder: "Add a channel",
        help_text: "Each chip keeps its icon.",
        searchable: true,
        multiple: true
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "regions",
        options: [
          {
            label: "Australia",
            value: "australia",
            icon: "globe-alt",
            children: [
              {label: "VIC", value: "vic", icon: "map-pin"},
              {label: "NSW", value: "nsw", icon: "map-pin"}
            ]
          }
        ],
        label: "Regions",
        placeholder: "Select regions",
        help_text: "Parents and children can each carry an icon.",
        searchable: true,
        multiple: true
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "native_priority",
        options: [
          {label: "Low", value: "low", icon: "arrow-down"},
          {label: "High", value: "high", icon: "arrow-up"}
        ],
        label: "Native priority",
        value: "high",
        help_text: "A native select still submits the value. It cannot draw the icon."
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Select::Component.new(
        name: &quot;priority&quot;,
        options: [
          { label: &quot;Low&quot;, value: &quot;low&quot;, icon: &quot;arrow-down&quot; },
          { label: &quot;Medium&quot;, value: &quot;medium&quot;, icon: &quot;minus&quot; },
          { label: &quot;High&quot;, value: &quot;high&quot;, icon: &quot;arrow-up&quot; }
        ],
        label: &quot;Priority&quot;,
        value: &quot;high&quot;,
        searchable: true
      ) %&gt;
    CODE
    language: "erb",
    title: "Select option icons"
  ) %>
</section>
