<%= render FlatPack::PageTitle::Component.new(
  title: "Top Nav Components",
  subtitle: "Top nav slot behavior with live examples and copyable code snippets."
) %>
<%= render "pages/component_method_variables_table", component: :top_nav %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Called Full Example", anchor_link: true, subtitle: "All slots defined.") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    Baseline example with left, center, and right slots all defined.
  </p>
  <div class="rounded-lg overflow-hidden mb-4">
    <%= render FlatPack::TopNav::Component.new(class: "relative rounded-lg border border-[var(--surface-border-color)]") do |nav| %>
      <% nav.left do %>
        <%= render FlatPack::Button::Component.new(
          icon: "menu",
          icon_only: true,
          style: :ghost,
          size: :md,
          aria: { label: "Toggle sidebar" },
          class: "border-0 shadow-none hover:bg-[var(--surface-muted-background-color)] transition-colors"
        ) %>
        <h3 class="text-base font-semibold">Dashboard</h3>
      <% end %>

      <% nav.center do %>
        <div class="text-sm text-[var(--surface-muted-content-color)]">Page context</div>
      <% end %>

      <% nav.right do %>
        <%= render FlatPack::Button::Component.new(
          icon: "bell",
          icon_only: true,
          style: :ghost,
          size: :md,
          aria: { label: "Notifications" },
          class: "border-0 shadow-none hover:bg-[var(--surface-muted-background-color)] transition-colors"
        ) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::TopNav::Component.new do |nav| %&gt;
        &lt;% nav.left do %&gt;
          &lt;%= render FlatPack::Button::Component.new(
            icon: &quot;menu&quot;,
            icon_only: true,
            style: :ghost,
            size: :md,
            aria: { label: &quot;Toggle sidebar&quot; },
            class: &quot;border-0 shadow-none hover:bg-[var(--surface-muted-background-color)]&quot;
          ) %&gt;
          <h3 class="text-base font-semibold">Dashboard</h3>
        &lt;% end %&gt;
      
        &lt;% nav.center do %&gt;
          <div class="text-sm text-[var(--surface-muted-content-color)]">Page context</div>
        &lt;% end %&gt;
      
        &lt;% nav.right do %&gt;
          &lt;%= render FlatPack::Button::Component.new(
            icon: &quot;bell&quot;,
            icon_only: true,
            style: :ghost,
            size: :md,
            aria: { label: &quot;Notifications&quot; },
            class: &quot;border-0 shadow-none hover:bg-[var(--surface-muted-background-color)]&quot;
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Left + Right Slots (Blank Center)", anchor_link: true, subtitle: "Center slot is undefined.") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    The center wrapper still renders even when <code>nav.center</code> is not defined.
  </p>
  <div class="rounded-lg overflow-hidden mb-4">
    <%= render FlatPack::TopNav::Component.new(class: "relative rounded-lg border border-[var(--surface-border-color)]") do |nav| %>
      <% nav.left do %>
        <h3 class="text-base font-semibold">Dashboard</h3>
      <% end %>

      <% nav.right do %>
        <%= render FlatPack::Button::Component.new(text: "Create", size: :sm, style: :primary) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::TopNav::Component.new do |nav| %&gt;
        &lt;% nav.left do %&gt;
          <h3 class="text-base font-semibold">Dashboard</h3>
        &lt;% end %&gt;
      
        &lt;% nav.right do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Create", size: :sm, style: :primary) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Center + Right Slots (Blank Left)", anchor_link: true, subtitle: "Left slot is undefined.") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    The left wrapper still renders even when <code>nav.left</code> is not defined.
  </p>
  <div class="rounded-lg overflow-hidden mb-4">
    <%= render FlatPack::TopNav::Component.new(class: "relative rounded-lg border border-[var(--surface-border-color)]") do |nav| %>
      <% nav.center do %>
        <%= render FlatPack::Search::Component.new(
          placeholder: "Search workspace..."
        ) %>
      <% end %>

      <% nav.right do %>
        <%= render FlatPack::Button::Component.new(text: "Export", size: :sm, style: :primary) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::TopNav::Component.new do |nav| %&gt;
        &lt;% nav.center do %&gt;
          &lt;%= render FlatPack::Search::Component.new(
            placeholder: "Search workspace..."
          ) %&gt;
        &lt;% end %&gt;
      
        &lt;% nav.right do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Export", size: :sm, style: :primary) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Left + Center Slots (Blank Right)", anchor_link: true, subtitle: "Right slot is undefined.") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    The right wrapper still renders even when <code>nav.right</code> is not defined.
  </p>
  <div class="rounded-lg overflow-hidden mb-4">
    <%= render FlatPack::TopNav::Component.new(class: "relative rounded-lg border border-[var(--surface-border-color)]") do |nav| %>
      <% nav.left do %>
        <h3 class="text-base font-semibold">Workspace</h3>
      <% end %>

      <% nav.center do %>
        <%= render FlatPack::Search::Component.new(
          placeholder: "Search reports..."
        ) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::TopNav::Component.new do |nav| %&gt;
        &lt;% nav.left do %&gt;
          <h3 class="text-base font-semibold">Workspace</h3>
        &lt;% end %&gt;

        &lt;% nav.center do %&gt;
          &lt;%= render FlatPack::Search::Component.new(
            placeholder: "Search reports..."
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Only Right Slot (Blank Left and Center)", anchor_link: true, subtitle: "Left and center slots are undefined.") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    Only <code>nav.right</code> is defined. Left and center remain undefined and render as blank wrappers.
  </p>
  <div class="rounded-lg overflow-hidden mb-4">
    <%= render FlatPack::TopNav::Component.new(class: "relative rounded-lg border border-[var(--surface-border-color)]") do |nav| %>
      <% nav.right do %>
        <%= render FlatPack::Button::Component.new(text: "Save", size: :sm, style: :primary) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::TopNav::Component.new do |nav| %&gt;
        &lt;% nav.right do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Save", size: :sm, style: :primary) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Alignment Rules", anchor_link: true, subtitle: "Examples for Alignment Rules.") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    <code>left</code> is start-aligned, <code>center</code> is flexed and centered, and <code>right</code> sits at the far edge. Wrappers remain present even when a slot is undefined.
  </p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::TopNav::Component.new do |nav| %&gt;
        &lt;% nav.left do %&gt;Left&lt;% end %&gt;
        &lt;% nav.center do %&gt;Centered&lt;% end %&gt;
        &lt;% nav.right do %&gt;Right&lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
