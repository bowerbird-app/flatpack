<%= render FlatPack::PageTitle::Component.new(
  title: "Combined Form",
  subtitle: "A complete example that combines multiple FlatPack form inputs in one page."
) %>

<%= render "pages/component_method_variables_table", components: [:form_input, :button] %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Complete Form Example", anchor_link: true) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-[var(--stack-gap-md)]") do %>
      <form class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "full_name",
          label: "Full Name",
          placeholder: "John Doe",
          help_text: "Use the name that should appear on account records.",
          required: true
        ) %>

        <%= render FlatPack::EmailInput::Component.new(
          name: "contact_email",
          label: "Email",
          placeholder: "john@example.com",
          help_text: "Use the email address for account notifications.",
          required: true
        ) %>

        <%= render FlatPack::PasswordInput::Component.new(
          name: "account_password",
          label: "Password",
          placeholder: "Enter a secure password",
          help_text: "Use at least 12 characters.",
          required: true
        ) %>

        <%= render FlatPack::PhoneInput::Component.new(
          name: "contact_phone",
          label: "Phone Number",
          placeholder: "+1 (555) 123-4567",
          help_text: "Include a country code when applicable."
        ) %>

        <%= render FlatPack::DateInput::Component.new(
          name: "birth_date",
          label: "Birth Date",
          help_text: "Must be today or earlier.",
          max: Date.today.to_s
        ) %>

        <%= render FlatPack::NumberInput::Component.new(
          name: "age",
          label: "Age",
          min: 18,
          max: 120,
          step: 1,
          placeholder: "Enter your age",
          help_text: "Enter a whole number from 18 to 120."
        ) %>

        <%= render FlatPack::RangeInput::Component.new(
          name: "experience_level",
          label: "Experience Level",
          min: 0,
          max: 10,
          step: 1,
          help_text: "Drag to indicate your current comfort level.",
          value: 5
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "country",
          options: [["United States", "us"], ["Canada", "ca"], ["United Kingdom", "uk"]],
          label: "Country",
          placeholder: "Select your country",
          help_text: "Choose the country used for billing details.",
          required: true
        ) %>

        <%= render FlatPack::Checkbox::Component.new(
          name: "agree_terms",
          label: "I agree to the terms and conditions",
          help_text: "Required before submitting the form.",
          required: true
        ) %>

        <%= render FlatPack::TextArea::Component.new(
          name: "bio",
          label: "Biography",
          placeholder: "Tell us about yourself...",
          help_text: "Keep the summary short and plain text.",
          rows: 4
        ) %>

        <div class="pt-2">
          <%= render FlatPack::Button::Component.new(
            text: "Submit Form",
            type: "submit",
            style: :primary
          ) %>
        </div>
      </form>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
