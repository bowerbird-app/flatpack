<%= render FlatPack::PageTitle::Component.new(
  title: "Usage Meter",
  subtitle: "Show usage against a plan limit, a split allowance, or none on the plan."
) %>

<%= render "pages/component_method_variables_table", component: :billing_usage_meter %>


<section id="usage-normal" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Within Limit", anchor_link: true, subtitle: "Default progress style under 80% usage.") %>
  <div class="mb-4 max-w-xl">
    <%= render FlatPack::Billing::UsageMeter::Component.new(
      label: "Seats",
      used: 4,
      limit: 10,
      unit: "seats",
      description: "Resets on your billing date.",
      tooltip_text: "Seats are counted for active members on this workspace."
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Billing::UsageMeter::Component.new(
        label: "Seats",
        used: 4,
        limit: 10,
        unit: "seats",
        description: "Resets on your billing date."
      ) %&gt;
    CODE
    language: "erb",
    title: "Within Limit"
  ) %>
</section>

<section id="usage-warning" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Warning", anchor_link: true, subtitle: "The bar warns from 80% of the limit. warning_ratio moves that line.") %>
  <div class="space-y-6 mb-4 max-w-xl">
    <%= render FlatPack::Billing::UsageMeter::Component.new(label: "API calls", used: 8500, limit: 10000, unit: "calls") %>
    <%= render FlatPack::Billing::UsageMeter::Component.new(
      label: "Build minutes",
      used: 55,
      limit: 100,
      unit: "minutes",
      warning_ratio: 0.5,
      description: "Warns from half the allowance."
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Billing::UsageMeter::Component.new(
        label: "Build minutes",
        used: 55,
        limit: 100,
        unit: "minutes",
        warning_ratio: 0.5
      ) %&gt;
    CODE
    language: "erb",
    title: "Warning"
  ) %>
</section>

<section id="usage-over" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Over Limit", anchor_link: true, subtitle: "At or over the limit the bar turns danger.") %>
  <div class="mb-4 max-w-xl">
    <%= render FlatPack::Billing::UsageMeter::Component.new(label: "Storage", used: 12, limit: 10, unit: "GB") %>
  </div>
</section>

<section id="usage-none" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "None on Plan", anchor_link: true, subtitle: "A limit of zero means the plan includes none. No bar.") %>
  <div class="mb-4 max-w-xl">
    <%= render FlatPack::Billing::UsageMeter::Component.new(
      label: "Exports",
      used: 0,
      limit: 0,
      description: "Exports are not on this plan."
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Billing::UsageMeter::Component.new(
        label: "Exports",
        used: 0,
        limit: 0
      ) %&gt;
    CODE
    language: "erb",
    title: "None on Plan"
  ) %>
</section>

<section id="usage-breakdown" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Included and Purchased", anchor_link: true, subtitle: "The limit is the sum. One bar, plus a breakdown line.") %>
  <div class="mb-4 max-w-xl">
    <%= render FlatPack::Billing::UsageMeter::Component.new(
      label: "API calls",
      used: 80,
      included: 100,
      purchased: 50,
      unit: "calls",
      description: "Purchased calls last until you use them."
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Billing::UsageMeter::Component.new(
        label: "API calls",
        used: 80,
        included: 100,
        purchased: 50,
        unit: "calls"
      ) %&gt;
    CODE
    language: "erb",
    title: "Included and Purchased"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Unlimited", anchor_link: true, subtitle: "When limit is nil, hide the progress bar and show unlimited copy.") %>
  <div class="mb-4 max-w-xl">
    <%= render FlatPack::Billing::UsageMeter::Component.new(
      label: "Storage",
      used: 2.4,
      limit: nil,
      unit: "GB",
      description: "Unlimited on Enterprise."
    ) %>
  </div>
</section>

<%= render "shared/related_demos",
  links: [
    {text: "Billing", href: demo_billing_path},
    {text: "Plan Summary", href: demo_billing_plan_summary_path},
    {text: "Plan Picker", href: demo_billing_plan_picker_path},
    {text: "Payment Method", href: demo_billing_payment_method_path},
    {text: "Invoice List", href: demo_billing_invoice_list_path},
    {text: "Status Alert", href: demo_billing_status_alert_path}
  ] %>
