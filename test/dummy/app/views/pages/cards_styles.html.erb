<%# Controller: no instance variables required — all card data is inline. %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Card Styles & Slots",
  subtitle: "Style variants, padding, clickable cards, and slot divider options."
) %>

<%= render "pages/component_method_variables_table", component: :card %>

<%= render "shared/related_demos",
  links: [
    {text: "Overview", href: demo_cards_path},
    {text: "Media", href: demo_cards_media_path},
    {text: "Composed", href: demo_cards_composed_path}
  ] %>

  <!-- Card Styles -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Card Styles", anchor_link: true, subtitle: "Examples for Card Styles.") %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new(style: :default, hover: :subtle) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Default Card</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Standard card with background and border.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Elevated Card</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Card with shadow, no border.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Outlined Card</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Card with strong border.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :flat) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Flat Card</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Subtle background, no border.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :interactive) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Interactive Card</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Hover effects for clickable cards.</p>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(style: :default) do |card| %&gt;
          &lt;% card.header do %&gt;
            <h3 class="text-lg font-semibold">Default Card</h3>
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <p class="text-sm">Standard card with background and border.</p>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

  <!-- Padding Options -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Padding Options", anchor_link: true, subtitle: "Examples for Padding Options.") %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new(padding: :none) do %>
        <div class="text-sm">No padding</div>
      <% end %>

      <%= render FlatPack::Card::Component.new(padding: :sm) do %>
        <div class="text-sm">Small padding (p-4)</div>
      <% end %>

      <%= render FlatPack::Card::Component.new(padding: :md) do %>
        <div class="text-sm">Medium padding (p-6)</div>
      <% end %>

      <%= render FlatPack::Card::Component.new(padding: :lg) do %>
        <div class="text-sm">Large padding (p-8)</div>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(padding: :none) do %&gt;
          <div class="text-sm">No padding</div>
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

  <!-- Card with All Slots -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Card with All Slots", anchor_link: true, subtitle: "Examples for Card with All Slots.") %>
    <div class="max-w-sm mb-4">
      <%= render FlatPack::Card::Component.new(style: :default, hover: :subtle) do |card| %>
        <% card.media(aspect_ratio: "16/9") do %>
          <div class="w-full h-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-white text-2xl font-bold">
            Media Slot
          </div>
        <% end %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Card Title</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)]">Subtitle or metadata</p>
        <% end %>
        <% card.body do %>
          <p class="text-sm">This card demonstrates all available slots: media, header, body, and footer.</p>
        <% end %>
        <% card.footer do %>
          <div class="flex gap-2">
            <%= render FlatPack::Button::Component.new(text: "Action", style: :primary, size: :sm) %>
            <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, size: :sm) %>
          </div>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(style: :default) do |card| %&gt;
          &lt;% card.media(aspect_ratio: "16/9") do %&gt;
            <div class="w-full h-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-white text-2xl font-bold">
              Media Slot
            </div>
          &lt;% end %&gt;
          &lt;% card.header do %&gt;
            <h3 class="text-lg font-semibold">Card Title</h3>
            <p class="text-sm text-[var(--surface-muted-content-color)]">Subtitle or metadata</p>
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <p class="text-sm">This card demonstrates all available slots: media, header, body, and footer.</p>
          &lt;% end %&gt;
          &lt;% card.footer do %&gt;
            <div class="flex gap-2">
              &lt;%= render FlatPack::Button::Component.new(text: "Action", style: :primary, size: :sm) %&gt;
              &lt;%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, size: :sm) %&gt;
            </div>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

  <!-- Clickable Cards -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Clickable Cards", anchor_link: true, subtitle: "Examples for Clickable Cards.") %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new(
        style: :default,
        clickable: true,
        href: "#card-1"
      ) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Clickable Card 1</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Click anywhere on this card to navigate.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(
        style: :default,
        clickable: true,
        href: "#card-2"
      ) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Clickable Card 2</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Entire card is wrapped in a link.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(
        style: :default,
        clickable: true,
        href: "#card-3"
      ) do |card| %>
        <% card.header do %>
          <h3 class="text-lg font-semibold">Clickable Card 3</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">Hover to see the interactive effects.</p>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(
          style: :default,
          clickable: true,
          href: "#card-1"
        ) do |card| %&gt;
          &lt;% card.header do %&gt;
            <h3 class="text-lg font-semibold">Clickable Card 1</h3>
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <p class="text-sm">Click anywhere on this card to navigate.</p>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>
  <!-- Slot Options -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Slot Options", anchor_link: true, subtitle: "Examples for Slot Options.") %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.header(divider: true) do %>
          <h3 class="text-lg font-semibold">Header with Divider</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">The header has a bottom border by default.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.header(divider: false) do %>
          <h3 class="text-lg font-semibold">Header without Divider</h3>
        <% end %>
        <% card.body do %>
          <p class="text-sm">You can remove the header divider.</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <p class="text-sm">Body content</p>
        <% end %>
        <% card.footer(divider: true) do %>
          <p class="text-sm font-medium">Footer with Divider</p>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <p class="text-sm">Body content</p>
        <% end %>
        <% card.footer(divider: false) do %>
          <p class="text-sm font-medium">Footer without Divider</p>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new do |card| %&gt;
          &lt;% card.header(divider: true) do %&gt;
            <h3 class="text-lg font-semibold">Header with Divider</h3>
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <p class="text-sm">The header has a bottom border by default.</p>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>
