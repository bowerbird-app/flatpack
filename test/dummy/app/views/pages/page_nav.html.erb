<%= render FlatPack::PageTitle::Component.new(
  title: "Page Nav Component",
  subtitle: "A row of items in the order you call them. The helper renders the default back control when you pass no items."
) %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Default", anchor_link: true, subtitle: "flat_pack_page_nav with no items renders this history back control.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new do |nav| %>
      <% nav.with_back %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;% flat_pack_page_nav %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Custom order", anchor_link: true, subtitle: "Back, two icon links, then close. Every nav button is round.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(round: true) do |nav| %>
      <% nav.with_back %>
      <% nav.with_link(href: demo_forms_path, icon: "home", tooltip: "Home") %>
      <% nav.with_link(href: demo_page_header_path, icon: "squares-2x2", tooltip: "Admin") %>
      <% nav.with_close(href: demo_path, tooltip: "Close") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(round: true) do |nav| %&gt;
        &lt;% nav.with_back %&gt;
        &lt;% nav.with_link(href: demo_forms_path, icon: "home", tooltip: "Home") %&gt;
        &lt;% nav.with_link(href: demo_page_header_path, icon: "squares-2x2", tooltip: "Admin") %&gt;
        &lt;% nav.with_close(href: demo_path, tooltip: "Close") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<%= render "pages/component_method_variables_table", component: :page_nav %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Back link", anchor_link: true, subtitle: "The back icon is a link.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new do |nav| %>
      <% nav.with_back(href: demo_path) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new do |nav| %&gt;
        &lt;% nav.with_back(href: demo_path) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Action", anchor_link: true, subtitle: "An action is a button at the position you call it. round: comes from the nav.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(round: true) do |nav| %>
      <% nav.with_back %>
      <% nav.with_action(icon: "plus", icon_only: true, href: demo_forms_path, aria: {label: "Add"}) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(round: true) do |nav| %&gt;
        &lt;% nav.with_back %&gt;
        &lt;% nav.with_action(icon: "plus", icon_only: true, href: demo_forms_path, aria: { label: "Add" }) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
