<%= render FlatPack::PageTitle::Component.new(
  title: "Page Nav Component",
  subtitle: "Compact icon-only page navigation with browser back, optional anchor links, tooltips, and optional right slot action."
) %>

<%= render "pages/component_method_variables_table", component: :page_nav %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Back Only", anchor_link: true, subtitle: "Always renders browser history back on the left icon.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "With Anchor Action", anchor_link: true, subtitle: "Right-side icon appears only when anchor_url is provided.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(
      anchor_href: demo_path,
      anchor_tooltip: "Close"
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(
        anchor_href: demo_path,
        anchor_tooltip: "Close"
      ) %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "With Secondary Anchor", anchor_link: true, subtitle: "Secondary anchor renders immediately to the left of the primary anchor.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(
      secondary_anchor_href: demo_forms_path,
      secondary_anchor_icon: "home",
      secondary_anchor_tooltip: "Home",
      anchor_href: demo_path,
      anchor_tooltip: "Close"
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(
        secondary_anchor_href: demo_forms_path,
        secondary_anchor_icon: "home",
        secondary_anchor_tooltip: "Home",
        anchor_href: demo_path,
        anchor_tooltip: "Close"
      ) %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "With Anchor and Right Slot", anchor_link: true, subtitle: "Line divider fills available space and custom right_slot content drives add flow.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(
      anchor_href: demo_path,
      anchor_tooltip: "Close"
    ) do |component| %>
      <% component.right_slot do %>
        <%= render FlatPack::Button::Component.new(
          icon: "plus",
          icon_only: true,
          style: :secondary,
          size: :md,
          href: demo_forms_path,
          aria: {label: "Add"}
        ) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(
        anchor_href: demo_path,
        anchor_tooltip: "Close"
      ) do |component| %&gt;
        &lt;% component.right_slot do %&gt;
          &lt;%= render FlatPack::Button::Component.new(
            icon: "plus",
            icon_only: true,
            style: :secondary,
            size: :md,
            href: demo_forms_path,
            aria: {label: "Add"}
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "With Right Slot Dropdown", anchor_link: true, subtitle: "Use right_slot with a dropdown trigger when multiple actions belong in the nav." ) %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(
      anchor_href: demo_path,
      anchor_tooltip: "Close"
    ) do |component| %>
      <% component.right_slot do %>
        <%= render FlatPack::Button::Dropdown::Component.new(
          text: "",
          icon: "ellipsis-vertical",
          style: :ghost,
          size: :sm,
          show_chevron: false,
          trigger_attributes: {
            title: "More actions",
            aria: {label: "More actions"}
          }
        ) do |dropdown| %>
          <% dropdown.menu_item(text: "Edit", href: demo_forms_path) %>
          <% dropdown.menu_item(text: "Archive", href: demo_path) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(
        anchor_href: demo_path,
        anchor_tooltip: "Close"
      ) do |component| %&gt;
        &lt;% component.right_slot do %&gt;
          &lt;%= render FlatPack::Button::Dropdown::Component.new(
            text: "",
            icon: "ellipsis-vertical",
            style: :ghost,
            size: :sm,
            show_chevron: false,
            trigger_attributes: {
              title: "More actions",
              aria: {label: "More actions"}
            }
          ) do |dropdown| %&gt;
            &lt;% dropdown.menu_item(text: "Edit", href: demo_forms_path) %&gt;
            &lt;% dropdown.menu_item(text: "Archive", href: demo_path) %&gt;
          &lt;% end %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Custom Icons and Tooltips", anchor_link: true, subtitle: "Customize icon names, tooltips, accessible labels, and button styles.") %>
  <div class="mb-4">
    <%= render FlatPack::PageNav::Component.new(
      back_icon: "arrow-left",
      back_tooltip: "Back to previous page",
      anchor_href: demo_path,
      anchor_icon: "trash",
      anchor_tooltip: "Discard",
      back_style: :ghost,
      anchor_style: :ghost
    ) do |component| %>
      <% component.right_slot do %>
        <%= render FlatPack::Button::Component.new(
          icon: "check",
          icon_only: true,
          style: :primary,
          size: :md,
          href: demo_forms_path,
          aria: {label: "Create"}
        ) %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::PageNav::Component.new(
        back_icon: "arrow-left",
        back_tooltip: "Back to previous page",
        anchor_href: demo_path,
        anchor_icon: "trash",
        anchor_tooltip: "Discard",
        back_style: :ghost,
        anchor_style: :ghost
      ) do |component| %&gt;
        &lt;% component.right_slot do %&gt;
          &lt;%= render FlatPack::Button::Component.new(
            icon: "check",
            icon_only: true,
            style: :primary,
            size: :md,
            href: demo_forms_path,
            aria: {label: "Create"}
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
