<%= render FlatPack::PageTitle::Component.new(
  title: "Email Button",
  subtitle: "Email-safe CTA links rendered with table-based markup."
) %>

<%= render "pages/component_method_variables_table", component: :email_button %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Basic Variants", anchor_link: true, subtitle: "Primary and secondary CTA styles for email layouts.") %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-4") do %>
      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/confirm",
        text: "Confirm details",
        style: :primary
      ) %>

      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/settings",
        text: "Review settings",
        style: :secondary
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    snippets: [
      {
        text: "Primary",
        language: "erb",
        code: CGI.unescapeHTML(<<~'CODE')
          &lt;%= render FlatPack::EmailButton::Component.new(
            href: "https://example.com/confirm",
            text: "Confirm details",
            style: :primary
          ) %&gt;
        CODE
      },
      {
        text: "Secondary",
        language: "erb",
        code: CGI.unescapeHTML(<<~'CODE')
          &lt;%= render FlatPack::EmailButton::Component.new(
            href: "https://example.com/settings",
            text: "Review settings",
            style: :secondary
          ) %&gt;
        CODE
      }
    ]
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Width Behaviors", anchor_link: true, subtitle: "Use default, fit-content, or full-width rendering based on your email layout.") %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-4") do %>
      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/default",
        text: "Default width",
        style: :primary
      ) %>

      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/fit-content",
        text: "Fit content",
        style: :primary,
        fit_content: true
      ) %>

      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/full-width",
        text: "Full width CTA",
        style: :secondary,
        full_width: true
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/fit-content",
        text: "Fit content",
        fit_content: true
      ) %&gt;

      &lt;%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/full-width",
        text: "Full width CTA",
        style: :secondary,
        full_width: true
      ) %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Alignment Examples", anchor_link: true, subtitle: "Align CTA placement for different email content blocks.") %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-4") do %>
      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/left",
        text: "Left aligned",
        align: :left,
        full_width: true
      ) %>

      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/center",
        text: "Centered",
        align: :center,
        full_width: true
      ) %>

      <%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/right",
        text: "Right aligned",
        align: :right,
        full_width: true
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::EmailButton::Component.new(
        href: "https://example.com/right",
        text: "Right aligned",
        align: :right,
        full_width: true
      ) %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Composed Email CTA", anchor_link: true, subtitle: "Combine EmailCard and EmailButton for transactional templates.") %>

  <%= render FlatPack::EmailCard::Component.new(max_width: 600, padding: "24px") do %>
    <h1 style="margin:0 0 12px 0;font-family:Arial,sans-serif;font-size:24px;line-height:1.3;color:#111827;">Action required</h1>
    <p style="margin:0 0 16px 0;font-family:Arial,sans-serif;font-size:16px;line-height:1.5;color:#374151;">Please confirm your account details to continue securely.</p>

    <%= render FlatPack::EmailButton::Component.new(
      href: "https://example.com/confirm",
      text: "Confirm details",
      style: :primary,
      full_width: true
    ) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::EmailCard::Component.new(max_width: 600, padding: "24px") do %&gt;
        &lt;h1 style="margin:0 0 12px 0;font-family:Arial,sans-serif;font-size:24px;line-height:1.3;color:#111827;"&gt;
          Action required
        &lt;/h1&gt;
        &lt;p style="margin:0 0 16px 0;font-family:Arial,sans-serif;font-size:16px;line-height:1.5;color:#374151;"&gt;
          Please confirm your account details to continue securely.
        &lt;/p&gt;

        &lt;%= render FlatPack::EmailButton::Component.new(
          href: "https://example.com/confirm",
          text: "Confirm details",
          style: :primary,
          full_width: true
        ) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
