<%= render FlatPack::PageTitle::Component.new(
  title: "Carousel Component",
  subtitle: "Carousel with mixed content, controls, indicators, thumbnails, and transitions."
) %>

<%= render "pages/component_method_variables_table", component: :carousel %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Card row", anchor_link: true, subtitle: "Component cards with a peek of the next one.") %>
  <%
    episode_cards = [
      {title: "Night drive", art: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=640&h=640&q=80"},
      {title: "Studio notes", art: "https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?auto=format&fit=crop&w=640&h=640&q=80"},
      {title: "A longer episode title that wraps onto a second line", art: "https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?auto=format&fit=crop&w=640&h=640&q=80"},
      {title: "City static", art: "https://images.unsplash.com/photo-1483412033650-1015ddeb83d1?auto=format&fit=crop&w=640&h=640&q=80"},
      {title: "After hours", art: "https://images.unsplash.com/photo-1511379938547-c1f69419868d?auto=format&fit=crop&w=640&h=640&q=80"}
    ]
  %>
  <div class="mb-4">
    <%= render FlatPack::Card::Component.new(padding: :md) do %>
      <%= render FlatPack::Carousel::Component.new(
        side_preview: true,
        bleed: true,
        controls_on_touch: false,
        items_per_view_desktop: 3,
        items_per_view_tablet: 2,
        items_per_view_mobile: 1,
        show_indicators: false,
        show_counter: false,
        show_captions: false,
        aria_label: "Episode row"
      ) do |carousel| %>
        <% episode_cards.each do |episode| %>
          <% carousel.with_item do %>
            <%= render FlatPack::Card::Component.new(padding: :none, class: "min-w-0") do |card| %>
              <% card.media(aspect_ratio: "1/1", padding: :none) do %>
                <%= image_tag episode[:art], alt: "", class: "h-full w-full object-cover" %>
              <% end %>
              <% card.body(class: "flex flex-1 flex-col gap-3") do %>
                <h3 class="text-base font-medium"><%= episode[:title] %></h3>
                <div class="mt-auto flex flex-wrap gap-2">
                  <%= render FlatPack::Button::Component.new(text: "Play", icon: "play", style: :primary, size: :sm) %>
                  <%= render FlatPack::Button::Component.new(text: "Save", style: :secondary, size: :sm) %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <p class="mb-3 text-sm text-(--surface-muted-content-color)">
    The row sits in a padded card. The first episode lines up with the card text. The next episode peeks to the card edge.
  </p>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Card::Component.new(padding: :md) do %&gt;
        &lt;%= render FlatPack::Carousel::Component.new(
          side_preview: true,
          bleed: true,
          controls_on_touch: false,
          items_per_view_desktop: 3,
          items_per_view_tablet: 2,
          items_per_view_mobile: 1,
          show_indicators: false,
          show_counter: false,
          show_captions: false
        ) do |carousel| %&gt;
          &lt;% carousel.with_item do %&gt;
            &lt;%= render FlatPack::Card::Component.new(padding: :none) do |card| %&gt;
              &lt;% card.media(aspect_ratio: "1/1", padding: :none) do %&gt;
                &lt;%= image_tag episode_art_url, alt: "" %&gt;
              &lt;% end %&gt;
              &lt;% card.body do %&gt;
                &lt;h3&gt;Night drive&lt;/h3&gt;
                &lt;%= render FlatPack::Button::Component.new(text: "Play", icon: "play", style: :primary, size: :sm) %&gt;
                &lt;%= render FlatPack::Button::Component.new(text: "Save", style: :secondary, size: :sm) %&gt;
              &lt;% end %&gt;
            &lt;% end %&gt;
          &lt;% end %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Basic Carousel -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Basic Carousel", anchor_link: true, subtitle: "Examples for Basic Carousel.") %>
  <div class="mb-4 overflow-hidden rounded-xl border border-(--surface-border-color) bg-(--surface-background-color) p-4">
    <%= render FlatPack::Carousel::Component.new(
      slides: @carousel_slides,
      show_controls: true,
      show_indicators: true,
      show_captions: true,
      caption_mode: :below,
      aspect_ratio: "16/9",
      aria_label: "Basic carousel demo"
    ) %>
  </div>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Carousel::Component.new(
        slides: @carousel_slides,
        show_controls: true,
        show_indicators: true,
        show_captions: true,
        caption_mode: :below,
        aspect_ratio: "16/9"
      ) %&gt;
    CODE
  ) %>

  <p class="mt-6 mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Lightbox Example (In Basic Carousel)</p>
  <p class="mb-3 text-sm text-(--surface-muted-content-color)">
    Image slides open the shared lightbox by default. Click the expand icon in the top-right corner to open the active image. A video opens it only when that slide sets lightbox: true. The slide count now sits in the bottom-right footer beside the dot navigation.
  </p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      @carousel_slides = [
        {
          type: :image,
          src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1600&h=900&fit=crop",
          thumb_src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=320&h=180&fit=crop",
          alt: "Product analytics dashboard",
          caption: "Analytics dashboard concept",
          lightbox: true
        },
        {
          type: :image,
          src: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1600&h=900&fit=crop",
          thumb_src: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=320&h=180&fit=crop",
          alt: "Planning workshop board",
          caption: "Planning workshop board",
          lightbox: false
        }
      ]
    CODE
  ) %>

  <p class="mt-6 mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Full Slide Structure (Including HTML Slide)</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      @carousel_slides = [
        {
          type: :image,
          src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1600&h=900&fit=crop",
          thumb_src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=320&h=180&fit=crop",
          alt: "Product analytics dashboard",
          caption: "Analytics dashboard concept",
          lightbox: true
        },
        {
          type: :video,
          src: "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
          poster: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=1600&h=900&fit=crop",
          caption: "Product teaser clip"
        },
        {
          type: :html,
          caption: "Email capture form",
          html: ApplicationController.render(
            renderable: FlatPack::TextInput::Component.new(
              name: "lead[email]",
              label: "Work email",
              placeholder: "you@company.com",
              required: true
            ),
            layout: false
          )
        }
      ]

      &lt;%= render FlatPack::Carousel::Component.new(
        slides: @carousel_slides,
        show_controls: true,
        show_indicators: true,
        show_captions: true,
        caption_mode: :below,
        aspect_ratio: "16/9",
        aria_label: "Basic carousel demo"
      ) %&gt;
    CODE
  ) %>
</section>

<!-- Charts Side Preview Carousel -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Charts Side Preview", anchor_link: true, subtitle: "Five charts with one-quarter preview of the next slide.") %>
  <style>
    .charts-side-preview [data-flat-pack--carousel-target='counter'] {
      display: none;
    }

    .charts-side-preview [data-flat-pack--carousel-target='viewport'] {
      aspect-ratio: auto !important;
      height: auto !important;
    }
  </style>
  <div class="mb-4">
    <%= render FlatPack::Carousel::Component.new(
      slides: @carousel_chart_slides,
      show_controls: true,
      controls_on_hover: true,
      show_indicators: true,
      show_captions: true,
      caption_mode: :below,
      side_preview: true,
      items_per_view_desktop: 3,
      items_per_view_tablet: 1,
      items_per_view_mobile: 1,
      class: "charts-side-preview",
      show_border: false,
      show_background: false,
      aria_label: "Charts side preview carousel"
    ) %>
  </div>
  <p class="mb-3 text-sm text-(--surface-muted-content-color)">
    Side preview mode keeps one-quarter of the next slide visible. This demo renders 3.25 cards on desktop and 1.25 cards on tablet/mobile.
  </p>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Carousel::Component.new(
        slides: @carousel_chart_slides,
        show_controls: true,
        controls_on_hover: true,
        show_indicators: true,
        show_captions: true,
        side_preview: true,
        items_per_view_desktop: 3,
        items_per_view_tablet: 1,
        items_per_view_mobile: 1,
        show_border: false,
        show_background: false
      ) %&gt;
    CODE
  ) %>
</section>

<!-- Single Slide Carousel -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Single Slide Example", anchor_link: true, subtitle: "Examples for a single-slide carousel where arrows and the slide count stay hidden.") %>
  <div class="mb-4 overflow-hidden rounded-xl border border-(--surface-border-color) bg-(--surface-background-color) p-4">
    <%= render FlatPack::Carousel::Component.new(
      slides: @carousel_single_slide,
      show_controls: true,
      show_indicators: true,
      show_captions: true,
      caption_mode: :below,
      aspect_ratio: "16/9",
      aria_label: "Single slide carousel demo"
    ) %>
  </div>
  <p class="mb-3 text-sm text-(--surface-muted-content-color)">
    With only one slide, the carousel keeps the content and lightbox expand button but skips the chevron controls, dot navigation, and slide count.
  </p>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      @carousel_single_slide = [
        {
          type: :image,
          src: "https://images.unsplash.com/photo-1518773553398-650c184e0bb3?w=1600&h=900&fit=crop",
          thumb_src: "https://images.unsplash.com/photo-1518773553398-650c184e0bb3?w=320&h=180&fit=crop",
          alt: "Single slide gallery preview",
          caption: "Single slide example with lightbox enabled",
          lightbox: true
        }
      ]

      &lt;%= render FlatPack::Carousel::Component.new(
        slides: @carousel_single_slide,
        show_controls: true,
        show_indicators: true,
        show_captions: true,
        caption_mode: :below,
        aspect_ratio: "16/9"
      ) %&gt;
    CODE
  ) %>
</section>

<!-- Logo Slider Carousel -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Logo Slider", anchor_link: true, subtitle: "Multi-item logo carousel with responsive counts and image controls.") %>
  <div class="mb-4 overflow-hidden bg-(--surface-background-color)">
    <%= render FlatPack::Carousel::Component.new(
      slides: @carousel_logo_slider_slides,
      variant: :logo_slider,
      loop: true,
      logo_items_per_view_desktop: 5,
      logo_items_per_view_tablet: 3,
      logo_items_per_view_mobile: 3,
      logo_grayscale: true,
      logo_opacity: 0.8,
      show_indicators: false,
      show_captions: false,
      touch_swipe: true,
      aria_label: "Logo cloud carousel demo"
    ) %>
  </div>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Carousel::Component.new(
        slides: @carousel_logo_slider_slides,
        variant: :logo_slider,
        loop: true,
        logo_items_per_view_desktop: 5,
        logo_items_per_view_tablet: 3,
        logo_items_per_view_mobile: 3,
        logo_grayscale: true,
        logo_opacity: 0.8,
        show_indicators: false,
        show_captions: false
      ) %&gt;
    CODE
  ) %>
</section>

<!-- HTML cards with thumbs -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Card thumbs", anchor_link: true, subtitle: "Give a card its own picture, or leave it blank.") %>
  <style>
    .card-thumbs [data-flat-pack--carousel-target='viewport'] {
      aspect-ratio: auto !important;
      height: auto !important;
    }
  </style>
  <div class="mb-4">
    <%= render FlatPack::Carousel::Component.new(
      slides: @carousel_card_slides,
      show_thumbs: true,
      thumbs_position: :bottom,
      thumbs_alignment: :start,
      show_controls: true,
      show_indicators: false,
      show_captions: true,
      caption_mode: :below,
      items_per_view_desktop: 3,
      items_per_view_tablet: 2,
      items_per_view_mobile: 1,
      class: "card-thumbs",
      show_border: false,
      show_background: false,
      aria_label: "Cards with picture thumbs"
    ) %>
  </div>
  <p class="mb-3 text-sm text-(--surface-muted-content-color)">
    Pass a picture with the card. The last card has none, so its thumb is the slide number. The row behind the cards is clear.
  </p>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Carousel::Component.new(
        slides: [
          {type: :html, html: quiet_desk_card, thumb_src: "/images/desk.jpg", caption: "Quiet desk"},
          {type: :html, html: workshop_card, thumb: "/images/workshop.jpg", caption: "Workshop"},
          {type: :html, html: plain_card, caption: "No picture"}
        ],
        show_thumbs: true,
        items_per_view_desktop: 3,
        items_per_view_tablet: 2,
        items_per_view_mobile: 1,
        show_border: false,
        show_background: false
      ) %&gt;
    CODE
  ) %>
</section>

<!-- Carousel with Thumbnails and Autoplay -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Carousel with Thumbnails and Autoplay", anchor_link: true, subtitle: "Examples for Carousel with Thumbnails and Autoplay.") %>
  <div class="mb-4 overflow-hidden rounded-xl border border-(--surface-border-color) bg-(--surface-background-color) p-4">
    <%= render FlatPack::Carousel::Component.new(
      slides: @carousel_slides,
      show_thumbs: true,
      thumbs_position: :bottom,
      thumbs_alignment: :center,
      show_indicators: true,
      show_controls: true,
      autoplay: true,
      autoplay_interval_ms: 4000,
      pause_on_hover: true,
      pause_on_focus: true,
      loop: true,
      caption_mode: :overlay,
      aspect_ratio: "16/9",
      aria_label: "Carousel with thumbnails and autoplay"
    ) %>
  </div>
  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">Code Example</p>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Carousel::Component.new(
        slides: @carousel_slides,
        show_thumbs: true,
        thumbs_position: :bottom,
        thumbs_alignment: :center,
        autoplay: true,
        autoplay_interval_ms: 4000,
        pause_on_hover: true,
        loop: true,
        caption_mode: :overlay
      ) %&gt;
    CODE
  ) %>
</section>

<!-- Fade Transition Carousel -->
