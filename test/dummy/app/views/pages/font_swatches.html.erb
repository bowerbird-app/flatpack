<%= render FlatPack::PageTitle::Component.new(
  title: "Font Swatches",
  subtitle: "Circular font sample with a tooltip name and a native select on click — sibling to Color Swatch."
) %>

<%= render "pages/component_method_variables_table", component: :font_swatch %>

<%
  erb_output_open = "<" + "%="
  erb_tag_close = "%" + ">"
  demo_font_options = [
    ["Sans", "ui-sans-serif"],
    ["Serif", "ui-serif"],
    ["Mono", "ui-monospace"],
    ["Georgia", "Georgia, serif"]
  ]
%>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Font swatch",
    anchor_link: true,
    subtitle: "Hover for the font name; click the circle to open the native select. The face shows Aa in the selected font — no under-circle label."
  ) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body do %>
      <div class="flex flex-wrap items-start gap-[var(--stack-gap-md)]">
        <%= render FlatPack::FontSwatch::Component.new(
          font: "ui-sans-serif",
          options: demo_font_options,
          text: "Sans",
          name: "theme[font]",
          selected: true,
          size: :lg
        ) %>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "Font swatch (ERB)",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::FontSwatch::Component.new(
        font: "ui-sans-serif",
        options: [
          ["Sans", "ui-sans-serif"],
          ["Serif", "ui-serif"],
          ["Mono", "ui-monospace"],
          ["Georgia", "Georgia, serif"]
        ],
        text: "Sans",
        name: "theme[font]",
        selected: true,
        size: :lg
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "With Color Swatches",
    anchor_link: true,
    subtitle: "Compose ColorSwatch and FontSwatch in one flex row — same circle sizes and tooltip-only names."
  ) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body do %>
      <div class="flex flex-wrap items-start gap-[var(--stack-gap-md)]">
        <%= render FlatPack::ColorSwatch::Component.new(
          color: "#f8f9fa",
          text: "Background",
          name: "theme[background]",
          selected: true,
          size: :lg
        ) %>
        <%= render FlatPack::ColorSwatch::Component.new(
          color: "#333333",
          text: "Text",
          name: "theme[text]",
          size: :lg
        ) %>
        <%= render FlatPack::ColorSwatch::Component.new(
          color: "#321100",
          text: "Accent",
          name: "theme[accent]",
          size: :lg
        ) %>
        <%= render FlatPack::FontSwatch::Component.new(
          font: "Georgia, serif",
          options: demo_font_options,
          text: "Georgia",
          name: "theme[font]",
          size: :lg
        ) %>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "Color + font row (ERB)",
    language: "erb",
    code: <<~CODE
      <div class="flex flex-wrap items-start gap-[var(--stack-gap-md)]">
        #{erb_output_open} render FlatPack::ColorSwatch::Component.new(
          color: "#f8f9fa",
          text: "Background",
          name: "theme[background]",
          selected: true,
          size: :lg
        ) #{erb_tag_close}
        #{erb_output_open} render FlatPack::FontSwatch::Component.new(
          font: "Georgia, serif",
          options: [["Sans", "ui-sans-serif"], ["Georgia", "Georgia, serif"]],
          text: "Georgia",
          name: "theme[font]",
          size: :lg
        ) #{erb_tag_close}
      </div>
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Sizes",
    anchor_link: true,
    subtitle: "Circle sizes reuse the Color Swatch / Avatar scale from xs through lg."
  ) %>

  <div class="flex flex-wrap items-end gap-[var(--stack-gap-md)] mb-4">
    <%= render FlatPack::FontSwatch::Component.new(font: "ui-sans-serif", options: demo_font_options, text: "XS", size: :xs, selected: true) %>
    <%= render FlatPack::FontSwatch::Component.new(font: "ui-serif", options: demo_font_options, text: "SM", size: :sm, selected: true) %>
    <%= render FlatPack::FontSwatch::Component.new(font: "ui-monospace", options: demo_font_options, text: "MD", size: :md, selected: true) %>
    <%= render FlatPack::FontSwatch::Component.new(font: "Georgia, serif", options: demo_font_options, text: "LG", size: :lg, selected: true) %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "Sizes (ERB)",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::FontSwatch::Component.new(
        font: "ui-monospace",
        options: [["Mono", "ui-monospace"]],
        text: "MD",
        size: :md,
        selected: true
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<%= render "shared/related_demos", links: [
  {text: "Color Swatches", href: "/demo/color_swatches"},
  {text: "Tooltips", href: "/demo/tooltips"},
  {text: "Rounded theme", href: "/themes/demos/rounded"}
] %>
