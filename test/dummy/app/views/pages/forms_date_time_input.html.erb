<%= render FlatPack::PageTitle::Component.new(
  title: "Date Time Input",
  subtitle: "Datetime-local examples plus guidance for FlatPack date range picker workflows."
) %>

<%= render "pages/component_method_variables_table", components: [:date_time_input, :date_input] %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Date Time Input Examples", anchor_link: true) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-[var(--stack-gap-md)]") do %>
      <%= render FlatPack::DateTimeInput::Component.new(
        name: "starts_at",
        label: "Starts At",
        min: Time.new(2024, 1, 1, 9, 0, 0),
        max: Time.new(2024, 12, 31, 17, 0, 0),
        required: true
      ) %>

      <%= render FlatPack::DateTimeInput::Component.new(
        name: "event_starts_at",
        label: "Event Starts At",
        min: Time.new(2024, 1, 1, 9, 0, 0),
        max: Time.new(2024, 12, 31, 17, 0, 0),
        value: Time.new(2024, 6, 15, 13, 30, 0)
      ) %>

      <%= render FlatPack::DateTimeInput::Component.new(
        name: "starts_at_error",
        label: "Starts At (with error)",
        error: "Start date and time is required",
        required: true,
        data: {
          flat_pack_message_required: "Start date and time is required"
        }
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Card::Component.new do |card| %&gt;
        &lt;% card.body do %&gt;
        &lt;%= render FlatPack::DateTimeInput::Component.new(
          name: &quot;starts_at&quot;,
          label: &quot;Starts At&quot;,
          min: Time.new(2024, 1, 1, 9, 0, 0),
          max: Time.new(2024, 12, 31, 17, 0, 0),
          required: true
        ) %&gt;

        &lt;%= render FlatPack::DateTimeInput::Component.new(
          name: &quot;event_starts_at&quot;,
          label: &quot;Event Starts At&quot;,
          min: Time.new(2024, 1, 1, 9, 0, 0),
          max: Time.new(2024, 12, 31, 17, 0, 0),
          value: Time.new(2024, 6, 15, 13, 30, 0)
        ) %&gt;

        &lt;%= render FlatPack::DateTimeInput::Component.new(
          name: &quot;starts_at_error&quot;,
          label: &quot;Starts At (with error)&quot;,
          error: &quot;Start date and time is required&quot;,
          required: true,
          data: {
            flat_pack_message_required: &quot;Start date and time is required&quot;
          }
        ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Date Range Companion Example", anchor_link: true) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-[var(--stack-gap-md)]") do %>
      <%= render FlatPack::DateInput::Component.new(
        name: "reporting_period",
        label: "Reporting Period",
        picker: :flatpack_date_picker,
        range: true,
        range_start_name: "reporting_period_start",
        range_end_name: "reporting_period_end",
        min: (Date.today - 365).to_s,
        max: Date.today.to_s,
        value: {
          start: (Date.today - 30).to_s,
          end: Date.today.to_s
        }
      ) %>

      <p class="text-sm text-(--surface-muted-content-color)">
        Use DateTimeInput for timestamp capture and DateInput with <code>picker: :flatpack_date_picker</code>
        when users need quick ranges like Today, Last week, or Last month.
      </p>
    <% end %>
  <% end %>
</section>