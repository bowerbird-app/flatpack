<div id="motion-gallery" class="flex flex-col gap-12">
  <% %i[fade rise blur scale wipe zoom words lines].each do |variant| %>
    <div>
      <p class="mb-4 text-sm font-medium"><%= variant.to_s.capitalize %></p>
      <div class="grid items-start gap-8 md:grid-cols-2">
        <%= render "pages/motion_one", variant: variant, caption: "Default", compact: true %>
        <%= render "pages/motion_one", variant: variant, intensity: :strong, caption: "Strong", compact: true %>
      </div>
    </div>
  <% end %>
  <%= render "pages/motion_one", variant: :parallax, compact: true %>
  <div id="reveal-stagger">
    <p class="mb-3 text-sm font-medium">Stagger</p>
    <%= render FlatPack::Reveal::Component.new(reveal: :rise, stagger: true, class: "grid gap-4 md:grid-cols-4") do %>
      <% %w[Oak Walnut Maple Ash].each do |name| %>
        <div class="rounded-[var(--radius-md)] border border-[var(--card-border-color)] bg-[var(--card-background-color)] px-4 py-4 text-lg font-medium"><%= name %></div>
      <% end %>
    <% end %>
  </div>
</div>
