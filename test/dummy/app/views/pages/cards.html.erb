<%# Controller: no instance variables required — all card data is inline. %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Card Component",
  subtitle: "Flexible, composable cards for displaying content in structured containers."
) %>

<%= render "pages/component_method_variables_table", component: :card %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Overview", anchor_link: true) %>
  <p class="text-[var(--surface-muted-content-color)] mb-6">
    Cards combine media, header, body, and footer slots. Background is the colour. Shadow, border, and hover are separate.
    Explore colour, slots, media, and composed examples below.
  </p>

  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
    <%= render FlatPack::Card::Component.new(background: :default, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Styles &amp; Slots</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Border, shadow, padding, clickable cards, and slot dividers.</p>
        <%= render FlatPack::Button::Component.new(text: "View styles", style: :secondary, size: :sm, href: demo_cards_styles_path) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(background: :brand, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Colour</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Surface, transparent, shaded, brand, soft brand, and gradient fills.</p>
        <%= render FlatPack::Button::Component.new(text: "View colour", style: :default, size: :sm, href: demo_cards_tones_path) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(background: :default, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Media</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Gallery grids, media slots, and aspect ratios.</p>
        <%= render FlatPack::Button::Component.new(text: "View media", style: :secondary, size: :sm, href: demo_cards_media_path) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(background: :default, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Composed Examples</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Product, stat, profile, pricing, and list cards.</p>
        <%= render FlatPack::Button::Component.new(text: "View examples", style: :secondary, size: :sm, href: demo_cards_composed_path) %>
      <% end %>
    <% end %>
  <% end %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Inset media",
    anchor_link: true,
    subtitle: "The photo corner follows the card."
  ) %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-6">
    On the default theme the padding is at least the card corner, so the photo is square. Rounded leaves a curve on the small card. A photo in the media slot still uses the card corner.
  </p>
  <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
    <%= render FlatPack::Card::Component.new(padding: :none) do |card| %>
      <% card.media(padding: :none) do %>
        <div class="fp-card-inner-radius overflow-hidden">
          <%= image_tag "/images/hero-stool.jpg", alt: "Stool", class: "block h-40 w-full object-cover" %>
        </div>
      <% end %>
      <% card.footer(divider: false, padding: :md) do %>
        <p class="text-sm font-medium">None</p>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(padding: :sm) do %>
      <%= render FlatPack::Media::Component.new(
        src: "/images/hero-packaging.jpg",
        alt: "Packaging",
        width: 800,
        height: 320,
        radius: :card_inner
      ) %>
      <p class="mt-3 text-sm font-medium">Small</p>
    <% end %>

    <%= render FlatPack::Card::Component.new(padding: :md) do %>
      <%= render FlatPack::Media::Component.new(
        src: "/images/hero-packhelp.png",
        alt: "Pack",
        width: 800,
        height: 320,
        radius: :card_inner
      ) %>
      <p class="mt-3 text-sm font-medium">Medium</p>
    <% end %>

    <%= render FlatPack::Card::Component.new(padding: :lg) do %>
      <%= render FlatPack::Media::Component.new(
        src: "/images/hero-subscription-box.webp",
        alt: "Box",
        width: 800,
        height: 320,
        radius: :card_inner
      ) %>
      <p class="mt-3 text-sm font-medium">Large</p>
    <% end %>
  <% end %>
</section>

<section class="mb-12" id="hand-inset">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Hand inset",
    anchor_link: true,
    subtitle: "Padding none, inset small. The photo corner stays parallel to the card."
  ) %>
  <div class="max-w-sm">
    <%= render FlatPack::Card::Component.new(padding: :none, inset: :sm) do %>
      <div class="p-[var(--card-padding-sm)]">
        <%= render FlatPack::Media::Component.new(
          src: "/images/hero-packaging.jpg",
          alt: "Packaging",
          width: 800,
          height: 320,
          radius: :card_inner
        ) %>
      </div>
    <% end %>
  </div>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Radius",
    anchor_link: true,
    subtitle: "A step overrides the theme corner."
  ) %>
  <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md) do %>
    <% [
      [:none, "None"],
      [:sm, "Small"],
      [:md, "Medium"],
      [:lg, "Large"],
      [:xl, "Extra large"],
      [:xxl, "32px"]
    ].each do |radius, label| %>
      <%= render FlatPack::Card::Component.new(radius: radius) do |card| %>
        <% card.body do %>
          <p class="text-sm font-medium"><%= label %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <div class="mt-4">
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
      <%= render FlatPack::Card::Component.new(radius: :xxxl, padding: :md) do %>
        <%= render FlatPack::Media::Component.new(
          src: "/images/hero-stool.jpg",
          alt: "Stool",
          width: 1200,
          height: 800,
          radius: :card_inner
        ) %>
        <p class="mt-3 text-sm font-medium">40px corner</p>
      <% end %>
    <% end %>
  </div>
</section>

<!-- Combined Default Grid Card -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Combined Default Card (Grid Default)", anchor_link: true, subtitle: "Examples for Combined Default Card (Grid Default).") %>
  <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">
    Recommended default for grid layouts: edge-to-edge top media, subtle hover interaction, and icon actions at the bottom.
  </p>
  <div class="max-w-sm mb-4">
    <%= render FlatPack::Card::Component.new(background: :default, hover: :subtle, shadow: :md) do |card| %>
      <% card.media(aspect_ratio: "16/9", padding: :none) do %>
        <%= image_tag "https://picsum.photos/800/450?random=21", class: "w-full h-full object-cover", alt: "Grid default card media" %>
      <% end %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Grid Card Title</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)]">Edge-to-edge hero media with a compact content block for grid views.</p>
      <% end %>
      <% card.footer(divider: false) do %>
        <div class="flex items-center justify-between">
          <div class="text-xs text-[var(--surface-muted-content-color)]">Updated 2h ago</div>
          <div class="flex gap-2">
            <%= render FlatPack::Button::Component.new(icon: "bell", icon_only: true, style: :ghost, size: :sm, href: "#grid-card-notifications", aria: { label: "Notifications" }) %>
            <%= render FlatPack::Button::Component.new(icon: "calendar", icon_only: true, style: :ghost, size: :sm, href: "#grid-card-schedule", aria: { label: "Schedule" }) %>
            <%= render FlatPack::Button::Component.new(icon: "dots", icon_only: true, style: :ghost, size: :sm, href: "#grid-card-menu", aria: { label: "More" }) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Card::Component.new(background: :default, hover: :subtle, shadow: :md) do |card| %&gt;
        &lt;% card.media(aspect_ratio: "16/9", padding: :none) do %&gt;
          &lt;%= image_tag "https://picsum.photos/800/450?random=21", class: "w-full h-full object-cover", alt: "Grid default card media" %&gt;
        &lt;% end %&gt;
        &lt;% card.body do %&gt;
          <h3 class="text-lg font-semibold mb-2">Grid Card Title</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)]">Edge-to-edge hero media with a compact content block for grid views.</p>
        &lt;% end %&gt;
        &lt;% card.footer(divider: false) do %&gt;
          <div class="flex items-center justify-between">
            <div class="text-xs text-[var(--surface-muted-content-color)]">Updated 2h ago</div>
            <div class="flex gap-2">
              &lt;%= render FlatPack::Button::Component.new(icon: "bell", icon_only: true, style: :ghost, size: :sm, href: "#grid-card-notifications", aria: { label: "Notifications" }) %&gt;
              &lt;%= render FlatPack::Button::Component.new(icon: "calendar", icon_only: true, style: :ghost, size: :sm, href: "#grid-card-schedule", aria: { label: "Schedule" }) %&gt;
              &lt;%= render FlatPack::Button::Component.new(icon: "dots", icon_only: true, style: :ghost, size: :sm, href: "#grid-card-menu", aria: { label: "More" }) %&gt;
            </div>
          </div>
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
