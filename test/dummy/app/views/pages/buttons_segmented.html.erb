<%= render FlatPack::PageTitle::Component.new(
  title: "Segmented Buttons",
  subtitle: "Toggle-style button groups with a selected state."
) %>

<!-- Segmented Buttons -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Segmented Buttons (Selected State)", anchor_link: true, subtitle: "Examples for Segmented Buttons (Selected State).") %>
  <div class="mb-4">
    <%= render FlatPack::SegmentedButtons::Component.new(
      data: {
        controller: "segmented-buttons-demo",
        segmented_buttons_demo_active_classes_value: FlatPack::Button::Component::SCHEMES[:primary],
        segmented_buttons_demo_inactive_classes_value: FlatPack::Button::Component::SCHEMES[:secondary]
      }
    ) do |group| %>
      <% group.button(text: "Day", selected: true, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
      <% group.button(text: "Week", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
      <% group.button(text: "Month", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
      <% group.button(text: "Year", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
    <% end %>
  </div>
  <div class="mb-4">
    <%= render FlatPack::SegmentedButtons::Component.new(
      data: {
        controller: "segmented-buttons-demo",
        segmented_buttons_demo_active_classes_value: FlatPack::Button::Component::SCHEMES[:primary],
        segmented_buttons_demo_inactive_classes_value: FlatPack::Button::Component::SCHEMES[:secondary]
      }
    ) do |group| %>
      <% group.button(text: "List", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
      <% group.button(text: "Grid", selected: true, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
      <% group.button(text: "Table", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::SegmentedButtons::Component.new(
        data: {
          controller: "segmented-buttons-demo",
          segmented_buttons_demo_active_classes_value: FlatPack::Button::Component::SCHEMES[:primary],
          segmented_buttons_demo_inactive_classes_value: FlatPack::Button::Component::SCHEMES[:secondary]
        }
      ) do |group| %&gt;
        &lt;% group.button(text: "Day", selected: true, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %&gt;
        &lt;% group.button(text: "Week", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %&gt;
        &lt;% group.button(text: "Month", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %&gt;
        &lt;% group.button(text: "Year", aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" }) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
