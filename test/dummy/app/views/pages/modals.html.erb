<%= render FlatPack::PageTitle::Component.new(
  title: "Modal Component",
  subtitle: "Accessible dialog overlays with focus trap, backdrop dismiss, and ESC key support."
) %>

<!-- Basic Modal -->
<%= render "pages/component_method_variables_table", component: :modal %>
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Basic Modal", anchor_link: true, subtitle: "Examples for Basic Modal.") %>
  <div class="mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Open Modal",
      style: :primary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "basic-modal" }
    ) %>
  </div>
  
  <%= render FlatPack::Modal::Component.new(id: "basic-modal", size: :md) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Modal Title</h2>
    <% end %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">
        This is a basic modal dialog. Click the backdrop, press ESC, or click the close button to dismiss.
      </p>
      <p class="mt-4 text-(--surface-muted-content-color)">
        The modal traps focus and prevents interaction with the rest of the page while open.
      </p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Cancel",
        style: :secondary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Confirm",
        style: :primary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
    <% end %>
  <% end %>
  
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(id: "basic-modal", size: :md) do |modal| %&gt;
        &lt;% modal.header do %&gt;
          <h2>Modal Title</h2>
        &lt;% end %&gt;
        &lt;% modal.body do %&gt;
          <p>Modal content goes here...</p>
        &lt;% end %&gt;
        &lt;% modal.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(
            text: "Close",
            data: { action: "click->flat-pack--modal#close" }
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Modal Sizes -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Modal Sizes", anchor_link: true, subtitle: "Examples for Modal Sizes.") %>
  <div class="flex gap-3 mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Small Modal",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "flat-pack--modal-target": "trigger", "modal-id": "small-modal" }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Medium Modal",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "flat-pack--modal-target": "trigger", "modal-id": "medium-modal" }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Large Modal",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "flat-pack--modal-target": "trigger", "modal-id": "large-modal" }
    ) %>
  </div>
  
  <%= render FlatPack::Modal::Component.new(id: "small-modal", size: :sm) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Small Modal</h2>
    <% end %>
    <% modal.body do %>
      <p>This is a small modal with limited width.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: { action: "click->flat-pack--modal#close" }) %>
    <% end %>
  <% end %>
  
  <%= render FlatPack::Modal::Component.new(id: "medium-modal", size: :md) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Medium Modal (Default)</h2>
    <% end %>
    <% modal.body do %>
      <p>This is a medium-sized modal, which is the default size.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: { action: "click->flat-pack--modal#close" }) %>
    <% end %>
  <% end %>
  
  <%= render FlatPack::Modal::Component.new(id: "large-modal", size: :lg) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Large Modal</h2>
    <% end %>
    <% modal.body do %>
      <p>This is a large modal with more width for complex content.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: { action: "click->flat-pack--modal#close" }) %>
    <% end %>
  <% end %>
  
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(id: "my-modal", size: :sm) ... %&gt;
      &lt;%= render FlatPack::Modal::Component.new(id: "my-modal", size: :md) ... %&gt;
      &lt;%= render FlatPack::Modal::Component.new(id: "my-modal", size: :lg) ... %&gt;
    CODE
  ) %>
</section>

<!-- Optional Sections -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Optional Sections", anchor_link: true, subtitle: "Examples showing header, body, and footer wrappers only render when content is provided.") %>
  <div class="flex flex-wrap gap-3 mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "No Header",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "no-header-modal" }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "No Body",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "no-body-modal" }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "No Footer",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "no-footer-modal" }
    ) %>
  </div>

  <div class="grid gap-4 lg:grid-cols-3 mb-6">
    <div class="rounded-lg border border-(--surface-border-color) bg-(--surface-muted-background-color) p-4">
      <h3 class="mb-2 text-sm font-semibold text-(--surface-content-color)">No Header</h3>
      <p class="text-sm text-(--surface-muted-content-color)">The close button stays visible, but the header wrapper is omitted entirely.</p>
    </div>
    <div class="rounded-lg border border-(--surface-border-color) bg-(--surface-muted-background-color) p-4">
      <h3 class="mb-2 text-sm font-semibold text-(--surface-content-color)">No Body</h3>
      <p class="text-sm text-(--surface-muted-content-color)">Use this for compact confirmation or status modals that only need a title and actions.</p>
    </div>
    <div class="rounded-lg border border-(--surface-border-color) bg-(--surface-muted-background-color) p-4">
      <h3 class="mb-2 text-sm font-semibold text-(--surface-content-color)">No Footer</h3>
      <p class="text-sm text-(--surface-muted-content-color)">The body can stand alone when actions are embedded in content or not needed.</p>
    </div>
  </div>

  <%= render FlatPack::Modal::Component.new(id: "no-header-modal", size: :sm) do |modal| %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">This example omits the header slot, so only the close button row and body are rendered.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Dismiss",
        style: :secondary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(id: "no-body-modal", title: "No Body Example", size: :sm) do |modal| %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Close",
        style: :secondary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Continue",
        style: :primary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(id: "no-footer-modal", title: "No Footer Example", size: :sm) do |modal| %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">This modal renders just the title and body content, without a footer wrapper.</p>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(id: "no-header-modal") do |modal| %&gt;
        &lt;% modal.body do %&gt;
          <p>Only the body renders here.</p>
        &lt;% end %&gt;
        &lt;% modal.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Dismiss", data: { action: "click-&gt;flat-pack--modal#close" }) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::Modal::Component.new(id: "no-body-modal", title: "No Body Example") do |modal| %&gt;
        &lt;% modal.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Close", data: { action: "click-&gt;flat-pack--modal#close" }) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::Modal::Component.new(id: "no-footer-modal", title: "No Footer Example") do |modal| %&gt;
        &lt;% modal.body do %&gt;
          <p>Only the header and body render here.</p>
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Modal with Form -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Modal with Form", anchor_link: true, subtitle: "Examples for Modal with Form.") %>
  <p class="text-(--surface-muted-content-color) mb-4">
    A practical example of placing a form inside a modal for focused data entry.
  </p>
  <div class="mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Open Form Modal",
      style: :primary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "form-modal" }
    ) %>
  </div>

  <%= render FlatPack::Modal::Component.new(id: "form-modal", size: :md) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Contact Sales</h2>
    <% end %>
    <% modal.body do %>
      <form class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "contact[name]",
          label: "Name",
          placeholder: "Jane Doe",
          required: true
        ) %>

        <%= render FlatPack::EmailInput::Component.new(
          name: "contact[email]",
          label: "Work Email",
          placeholder: "jane@company.com",
          required: true
        ) %>

        <%= render FlatPack::TextArea::Component.new(
          name: "contact[message]",
          label: "Message",
          placeholder: "Tell us what you'd like to build...",
          rows: 3,
          required: true
        ) %>

        <div class="flex justify-end gap-2 pt-2">
          <%= render FlatPack::Button::Component.new(
            text: "Cancel",
            style: :secondary,
            data: { action: "click->flat-pack--modal#close" }
          ) %>
          <%= render FlatPack::Button::Component.new(
            text: "Submit",
            style: :primary,
            data: { action: "click->flat-pack--modal#close" }
          ) %>
        </div>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(id: "form-modal", size: :md) do |modal| %&gt;
        &lt;% modal.header do %&gt;
          <h2>Contact Sales</h2>
        &lt;% end %&gt;
        &lt;% modal.body do %&gt;
          <form class="space-y-4">
            &lt;%= render FlatPack::TextInput::Component.new(...) %&gt;
            &lt;%= render FlatPack::EmailInput::Component.new(...) %&gt;
            &lt;%= render FlatPack::TextArea::Component.new(...) %&gt;
            <div class="flex justify-end gap-2 pt-2">
              &lt;%= render FlatPack::Button::Component.new(text: "Cancel", style: :secondary, data: { action: "click->flat-pack--modal#close" }) %&gt;
              &lt;%= render FlatPack::Button::Component.new(text: "Submit", style: :primary, data: { action: "click->flat-pack--modal#close" }) %&gt;
            </div>
          </form>
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Long Content Modal -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Long Content Modal", anchor_link: true, subtitle: "The card stays viewport-tall. The copy scrolls inside.") %>
  <p class="text-(--surface-muted-content-color) mb-4">
    Default <code>scroll: :body</code>. Header and actions stay put. Only the body moves.
  </p>
  <div class="mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Scroll inside",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "flat-pack--modal-target": "trigger", "modal-id": "long-content-modal" }
    ) %>
  </div>

  <%= render FlatPack::Modal::Component.new(id: "long-content-modal", size: :lg) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Long Content Test</h2>
    <% end %>
    <% modal.body do %>
      <div class="space-y-4 text-(--surface-content-color)">
        <p>
          This modal intentionally contains a lot of text so you can validate scrolling behavior, focus handling,
          and layout stability with larger content sets.
        </p>
        <% 20.times do |i| %>
          <p>
            <strong>Section <%= i + 1 %>:</strong>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus at augue vitae lacus consequat feugiat.
            Curabitur suscipit, est in dapibus rhoncus, nisi lectus congue turpis, at interdum turpis dui eget nibh.
            Integer facilisis velit ac tellus feugiat, non aliquet elit convallis. Aenean tempor sem ut neque luctus,
            vitae pulvinar ipsum sodales.
          </p>
        <% end %>
      </div>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Close",
        style: :secondary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;p class=&quot;text-[var(--surface-muted-content-color)] mb-4&quot;&gt;
        This example includes a large amount of text to test modal body scrolling and overall behavior with long-form content.
      &lt;/p&gt;
      &lt;div class=&quot;mb-4&quot;&gt;
        &lt;%= render FlatPack::Button::Component.new(
          text: &quot;Open Long Content Modal&quot;,
          style: :secondary,
          data: { action: &quot;click-&gt;flat-pack--modal#open&quot;, &quot;flat-pack--modal-target&quot;: &quot;trigger&quot;, &quot;modal-id&quot;: &quot;long-content-modal&quot; }
        ) %&gt;
      &lt;/div&gt;
    
      &lt;%= render FlatPack::Modal::Component.new(id: &quot;long-content-modal&quot;, size: :lg) do |modal| %&gt;
        &lt;% modal.header do %&gt;
          &lt;h2 class=&quot;text-xl font-semibold&quot;&gt;Long Content Test&lt;/h2&gt;
        &lt;% end %&gt;
        &lt;% modal.body do %&gt;
          &lt;div class=&quot;space-y-4 text-[var(--surface-content-color)]&quot;&gt;
            &lt;p&gt;
              This modal intentionally contains a lot of text so you can validate scrolling behavior, focus handling,
              and layout stability with larger content sets.
            &lt;/p&gt;
            &lt;% 20.times do |i| %&gt;
              &lt;p&gt;
                &lt;strong&gt;Section &lt;%= i + 1 %&gt;:&lt;/strong&gt;
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus at augue vitae lacus consequat feugiat.
                Curabitur suscipit, est in dapibus rhoncus, nisi lectus congue turpis, at interdum turpis dui eget nibh.
                Integer facilisis velit ac tellus feugiat, non aliquet elit convallis. Aenean tempor sem ut neque luctus,
                vitae pulvinar ipsum sodales.
              &lt;/p&gt;
            &lt;% end %&gt;
          &lt;/div&gt;
        &lt;% end %&gt;
        &lt;% modal.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(
            text: &quot;Close&quot;,
            style: :secondary,
            data: { action: &quot;click-&gt;flat-pack--modal#close&quot; }
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    language: "erb",
    title: "Long Content Modal"
  ) %>
</section>

<!-- Page scroll -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Scroll the overlay", anchor_link: true, subtitle: "The card is as tall as the copy. You scroll the dimmed layer.") %>
  <p class="text-(--surface-muted-content-color) mb-4">
    <code>scroll: :page</code> drops the viewport cap. Pin the actions with <code>sticky_footer: true</code> when the form is long.
  </p>
  <div class="flex flex-wrap gap-3 mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Long note",
      style: :secondary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "page-scroll-modal" }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Long form, pinned actions",
      style: :primary,
      data: { action: "click->flat-pack--modal#open", "modal-id": "page-scroll-sticky-modal" }
    ) %>
  </div>

  <%= render FlatPack::Modal::Component.new(id: "page-scroll-modal", size: :lg, scroll: :page) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Long content (page)</h2>
    <% end %>
    <% modal.body do %>
      <div class="space-y-4 text-(--surface-content-color)">
        <p>This card grows with the copy. Scroll the overlay, not a box inside the card.</p>
        <% 24.times do |i| %>
          <p>
            <strong>Paragraph <%= i + 1 %>.</strong>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad
            minim veniam, quis nostrud exercitation ullamco laboris.
          </p>
        <% end %>
      </div>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Cancel",
        style: :secondary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Save changes",
        style: :primary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(
    id: "page-scroll-sticky-modal",
    size: :lg,
    scroll: :page,
    sticky_footer: true
  ) do |modal| %>
    <% modal.header do %>
      <h2 class="text-xl font-semibold">Workspace policy</h2>
    <% end %>
    <% modal.body do %>
      <form class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "policy[title]",
          label: "Title",
          placeholder: "Public notes",
          required: true
        ) %>
        <%= render FlatPack::TextArea::Component.new(
          name: "policy[summary]",
          label: "Summary",
          placeholder: "What this policy covers…",
          rows: 4,
          required: true
        ) %>
        <% 8.times do |i| %>
          <%= render FlatPack::TextArea::Component.new(
            name: "policy[section_#{i + 1}]",
            label: "Section #{i + 1}",
            placeholder: "Details for this section…",
            rows: 3
          ) %>
        <% end %>
      </form>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "Cancel",
        style: :secondary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Save changes",
        style: :primary,
        data: { action: "click->flat-pack--modal#close" }
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(id: "page-scroll-modal", size: :lg, scroll: :page) do |modal| %&gt;
        &lt;% modal.body do %&gt;
          <p>The overlay scrolls. The card is as tall as this copy.</p>
        &lt;% end %&gt;
        &lt;% modal.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Cancel", style: :secondary) %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Save changes") %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::Modal::Component.new(id: "policy-modal", size: :lg, scroll: :page, sticky_footer: true) do |modal| %&gt;
        &lt;% modal.body do %&gt;
          <p>Long form. Save stays on screen.</p>
        &lt;% end %&gt;
        &lt;% modal.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Save changes") %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Image gallery editor -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Image gallery editor",
    anchor_link: true,
    subtitle: "Opt-in screens inside one dialog. Back, loading, and a broken link are all in the walkthrough."
  ) %>

  <div class="mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Open gallery",
      style: :primary,
      data: {action: "click->flat-pack--modal#open", "modal-id": "gallery-editor"}
    ) %>
  </div>

  <%= render FlatPack::Modal::Component.new(
    id: "gallery-editor",
    title: "Gallery",
    size: :lg,
    navigable: true,
    src: demo_gallery_editor_path
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(
        id: "gallery-editor",
        title: "Gallery",
        size: :lg,
        navigable: true,
        src: demo_gallery_editor_path
      ) %&gt;

      &lt;%= flat_pack_modal_screen(modal_id: "gallery-editor", title: "Edit image") do |screen| %&gt;
        &lt;% screen.footer do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Save", data: { fp_nav: "back" }) %&gt;
        &lt;% end %&gt;
        &lt;%= render FlatPack::Button::Component.new(text: "Edit photographer", href: photographer_path, data: { fp_nav: "push" }) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Grow from the button -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Grow from the button",
    anchor_link: true,
    subtitle: "Opt-in. The dialog starts on the control you clicked, then settles. Close sends it back."
  ) %>
  <p class="text-(--surface-muted-content-color) mb-4">
    Pass <code>origin: :trigger</code>. Off keeps today’s fade and scale. Phones under 640px wide fall back to that fade.
  </p>

  <div class="relative mb-6 min-h-72 rounded-[var(--radius-lg)] border border-(--surface-border-color) bg-(--surface-muted-background-color) p-4">
    <div class="absolute left-4 top-4">
      <%= render FlatPack::Button::Component.new(
        text: "Top left",
        style: :secondary,
        data: {action: "click->flat-pack--modal#open", "modal-id": "origin-top-left"}
      ) %>
    </div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <%= render FlatPack::Button::Component.new(
        text: "Centre",
        style: :primary,
        data: {action: "click->flat-pack--modal#open", "modal-id": "origin-centre"}
      ) %>
    </div>
    <div class="absolute bottom-4 right-4">
      <%= render FlatPack::Button::Component.new(
        text: "Bottom right",
        style: :secondary,
        data: {action: "click->flat-pack--modal#open", "modal-id": "origin-bottom-right"}
      ) %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 mb-6">
    <%= render FlatPack::Button::Component.new(
      text: "Long note, from here",
      style: :secondary,
      data: {action: "click->flat-pack--modal#open", "modal-id": "origin-page-scroll"}
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Open gallery from here",
      style: :primary,
      data: {action: "click->flat-pack--modal#open", "modal-id": "gallery-editor-from-button"}
    ) %>
  </div>

  <%= render FlatPack::Table::Component.new(
    data: [
      {name: "Harbour at dusk", kind: "Photo"},
      {name: "Studio lights", kind: "Photo"},
      {name: "Field notes", kind: "Doc"}
    ],
    min_width: :sm
  ) do |table| %>
    <% table.column(title: "Name", html: ->(row) { row[:name] }) %>
    <% table.column(title: "Kind", html: ->(row) { row[:kind] }) %>
    <% table.column(title: "", html: ->(_row) {
      render FlatPack::Button::Component.new(
        text: "Open",
        style: :ghost,
        data: {action: "click->flat-pack--modal#open", "modal-id": "origin-table-row"}
      )
    }) %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(id: "origin-top-left", title: "From the top left", origin: :trigger) do |modal| %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">This card grew out of the top-left button.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: {action: "click->flat-pack--modal#close"}) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(id: "origin-centre", title: "From the centre", origin: :trigger) do |modal| %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">Same motion, from the middle of the page.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: {action: "click->flat-pack--modal#close"}) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(id: "origin-bottom-right", title: "From the bottom right", origin: :trigger) do |modal| %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">Close it and it shrinks back into that corner.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: {action: "click->flat-pack--modal#close"}) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(id: "origin-table-row", title: "From a table row", origin: :trigger) do |modal| %>
    <% modal.body do %>
      <p class="text-(--surface-content-color)">Useful when the open control sits in a dense row.</p>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Close", style: :secondary, data: {action: "click->flat-pack--modal#close"}) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(
    id: "origin-page-scroll",
    title: "Long note",
    size: :lg,
    scroll: :page,
    sticky_footer: true,
    origin: :trigger
  ) do |modal| %>
    <% modal.body do %>
      <div class="space-y-4 text-(--surface-content-color)">
        <p>Page scroll and a pinned footer still grow from the button.</p>
        <% 12.times do |i| %>
          <p>
            <strong>Note <%= i + 1 %>.</strong>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </p>
        <% end %>
      </div>
    <% end %>
    <% modal.footer do %>
      <%= render FlatPack::Button::Component.new(text: "Cancel", style: :secondary, data: {action: "click->flat-pack--modal#close"}) %>
      <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, data: {action: "click->flat-pack--modal#close"}) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(
    id: "gallery-editor-from-button",
    title: "Gallery",
    size: :lg,
    navigable: true,
    src: demo_gallery_editor_path,
    origin: :trigger
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Modal::Component.new(id: "invite-modal", title: "Invite member", origin: :trigger) do |modal| %&gt;
        &lt;% modal.body do %&gt;
          <p>This card grew out of the button.</p>
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Features -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Features", anchor_link: true, subtitle: "Examples for Features.") %>
  <%= render FlatPack::List::Component.new(spacing: :dense, class: "text-[var(--surface-content-color)]") do %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Focus Trap:</strong> Keeps keyboard focus within the modal while open<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Focus Restoration:</strong> Returns focus to the trigger element on close<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>ESC to Close:</strong> Press ESC key to dismiss the modal<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Backdrop Click:</strong> Click outside the modal to close (configurable)<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Scroll Prevention:</strong> Prevents page scrolling while modal is open. The overlay can still scroll when <code>scroll: :page</code>.<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Page scroll:</strong> <code>scroll: :page</code> sizes the card to its content. <code>sticky_footer: true</code> pins the actions.<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Accessibility:</strong> Full ARIA support with role="dialog" and aria-modal="true"<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Animations:</strong> Fade and scale on open and close. Under Reduce Motion, fade only and no close delay.<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Grow from the button:</strong> Opt-in. Pass <code>origin: :trigger</code>. Off keeps today’s motion.<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Turbo Compatible:</strong> Works seamlessly with Turbo navigation<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Navigable screens:</strong> Opt-in. Pass <code>navigable: true</code> and <code>src</code>. Default modals stay as they are.<% end %>
  <% end %>
</section>
