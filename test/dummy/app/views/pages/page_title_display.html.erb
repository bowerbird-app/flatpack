<div class="min-h-screen bg-[var(--surface-page-background-color)] px-6 pt-10 pb-24 sm:px-10">
  <div class="mb-8">
    <%= render FlatPack::Button::Component.new(text: "Back to Page Title", style: :secondary, href: "/demo/page_header") %>
  </div>

  <div class="space-y-20 max-w-5xl">
    <section id="short">
      <%= render FlatPack::PageTitle::Component.new(title: "Northlight", size: :display) %>
    </section>

    <section id="long">
      <%= render FlatPack::PageTitle::Component.new(
        title: "A press kit for the Northlight collection",
        size: :display
      ) %>
    </section>

    <section id="subtitle">
      <%= render FlatPack::PageTitle::Component.new(
        title: "A press kit for the Northlight collection",
        subtitle: "Stills, credits, and download packs",
        size: :display
      ) %>
    </section>
  </div>

  <section id="dark" data-theme="dark" class="mt-20 -mx-6 px-6 py-16 sm:-mx-10 sm:px-10 bg-[var(--surface-page-background-color)]">
    <div class="max-w-5xl">
      <%= render FlatPack::PageTitle::Component.new(
        title: "A press kit for the Northlight collection",
        subtitle: "Stills, credits, and download packs",
        size: :display
      ) %>
    </div>
  </section>
</div>
