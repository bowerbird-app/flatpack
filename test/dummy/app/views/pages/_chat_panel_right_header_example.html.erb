<section id="chat-panel-right-header" class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Actions on the right",
    anchor_link: true,
    subtitle: "A long title stays on the left. Buttons stay on the right, in one row."
  ) %>

  <% long_title = "Riverside studio quarterly launch planning with Alicia, Mina, and the full design chat group" %>

  <div class="mb-6 mt-6 space-y-6">
    <div id="right-header-one">
      <p class="mb-2 text-sm font-semibold">One button</p>
      <div class="overflow-hidden rounded-lg border border-(--surface-border-color) bg-(--surface-background-color)">
        <%= render FlatPack::Chat::Panel::Component.new do |panel| %>
          <% panel.header do %>
            <div class="flex min-w-0 items-center p-4">
              <p class="min-w-0 truncate text-sm font-semibold"><%= long_title %></p>
            </div>
          <% end %>
          <% panel.right_header do %>
            <div class="flex items-center gap-2 whitespace-nowrap p-4">
              <%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :ghost, size: :sm, title: "Search", aria: { label: "Search conversation" }) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div id="right-header-two">
      <p class="mb-2 text-sm font-semibold">Two buttons</p>
      <div class="overflow-hidden rounded-lg border border-(--surface-border-color) bg-(--surface-background-color)">
        <%= render FlatPack::Chat::Panel::Component.new do |panel| %>
          <% panel.header do %>
            <div class="flex min-w-0 items-center p-4">
              <p class="min-w-0 truncate text-sm font-semibold"><%= long_title %></p>
            </div>
          <% end %>
          <% panel.right_header do %>
            <div class="flex items-center gap-2 whitespace-nowrap p-4">
              <%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :ghost, size: :sm, title: "Search", aria: { label: "Search conversation" }) %>
              <%= render FlatPack::Button::Component.new(icon: "bookmark", icon_only: true, style: :ghost, size: :sm, title: "Save", aria: { label: "Save conversation" }) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div id="right-header-four">
      <p class="mb-2 text-sm font-semibold">Four buttons</p>
      <div class="overflow-hidden rounded-lg border border-(--surface-border-color) bg-(--surface-background-color)">
        <%= render FlatPack::Chat::Panel::Component.new do |panel| %>
          <% panel.header do %>
            <div class="flex min-w-0 items-center p-4">
              <p class="min-w-0 truncate text-sm font-semibold">Riverside studio quarterly launch planning with Alicia, Mina, and the full design chat group</p>
            </div>
          <% end %>
          <% panel.right_header do %>
            <div class="flex items-center gap-2 whitespace-nowrap p-4">
              <%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :ghost, size: :sm, title: "Search", aria: { label: "Search conversation" }) %>
              <%= render FlatPack::Button::Component.new(icon: "bookmark", icon_only: true, style: :ghost, size: :sm, title: "Save", aria: { label: "Save conversation" }) %>
              <%= render FlatPack::Button::Component.new(icon: "bell", icon_only: true, style: :ghost, size: :sm, title: "Mute", aria: { label: "Mute conversation" }) %>
              <%= render FlatPack::Button::Component.new(icon: "dots", icon_only: true, style: :ghost, size: :sm, title: "More", aria: { label: "More conversation actions" }) %>
              <%= render FlatPack::Badge::Component.new(text: "4 new", style: :primary, size: :sm) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Chat::Panel::Component.new do |panel| %&gt;
        &lt;% panel.header do %&gt;
          &lt;div class="flex min-w-0 items-center p-4"&gt;
            &lt;p class="min-w-0 truncate text-sm font-semibold"&gt;Riverside studio quarterly launch planning with Alicia, Mina, and the full design chat group&lt;/p&gt;
          &lt;/div&gt;
        &lt;% end %&gt;

        &lt;% panel.right_header do %&gt;
          &lt;div class="flex items-center gap-2 whitespace-nowrap p-4"&gt;
            &lt;%= render FlatPack::Button::Component.new(icon: "search", icon_only: true, style: :ghost, size: :sm, title: "Search", aria: { label: "Search conversation" }) %&gt;
            &lt;%= render FlatPack::Button::Component.new(icon: "bookmark", icon_only: true, style: :ghost, size: :sm, title: "Save", aria: { label: "Save conversation" }) %&gt;
            &lt;%= render FlatPack::Button::Component.new(icon: "bell", icon_only: true, style: :ghost, size: :sm, title: "Mute", aria: { label: "Mute conversation" }) %&gt;
            &lt;%= render FlatPack::Button::Component.new(icon: "dots", icon_only: true, style: :ghost, size: :sm, title: "More", aria: { label: "More conversation actions" }) %&gt;
            &lt;%= render FlatPack::Badge::Component.new(text: "4 new", style: :primary, size: :sm) %&gt;
          &lt;/div&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>
