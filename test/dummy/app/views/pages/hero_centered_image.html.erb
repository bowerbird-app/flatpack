<%= render layout: "pages/hero_landing_chrome" do %>
  <%= render FlatPack::Hero::Component.new(
    variant: :centered_image,
    style: "--hero-overlay-min-height: 100dvh",
    tagline: "Built for teams",
    headline: "Ship features your users love.",
    description: "Full-bleed background image with a dark overlay keeps text readable at any resolution.",
    background_image_url: "/images/hero-stool.jpg"
  ) do |hero|
    hero.slot do
      concat render(FlatPack::Button::Component.new(text: "Start for free", style: :primary, href: "#"))
      concat render(FlatPack::Button::Component.new(text: "Watch demo", style: :secondary, href: "#"))
    end
  end %>
<% end %>
