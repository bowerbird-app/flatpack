<%= render FlatPack::PageTitle::Component.new(
  title: "Collapse",
  subtitle: "Expandable content sections with smooth animations and accessible controls."
) %>

<%= render "pages/component_method_variables_table", component: :collapse %>

<%= render "shared/related_demos",
  links: [{text: "Accordion", href: demo_accordion_path}] %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Collapse Component", anchor_link: true) %>
  
  <div class="space-y-4">
    <%= render FlatPack::Collapse::Component.new(
      id: "collapse1",
      title: "What is FlatPack?",
      left_slot: render(FlatPack::Shared::IconComponent.new(name: "question-mark-circle", size: :sm, class: "text-[var(--collapse-icon-color)]"))
    ) do %>
      <p>FlatPack is a comprehensive ViewComponent library for Ruby on Rails that provides production-ready UI components with built-in accessibility, responsive design, and thoughtful defaults.</p>
    <% end %>

    <%= render FlatPack::Collapse::Component.new(id: "collapse2", title: "How do I get started?", open: true) do %>
      <p>Add FlatPack to your Gemfile, run <code class="px-2 py-1 bg-gray-100 rounded">bundle install</code>, and start using components in your views. Each component follows Rails conventions and integrates seamlessly with your existing code.</p>
    <% end %>

    <%= render FlatPack::Collapse::Component.new(id: "collapse3", title: "Advanced Settings") do %>
      <div class="space-y-4">
        <%= render FlatPack::TextInput::Component.new(
          name: "api_endpoint",
          label: "API Endpoint",
          value: "https://api.example.com"
        ) %>
        <%= render FlatPack::NumberInput::Component.new(
          name: "timeout_seconds",
          label: "Timeout (seconds)",
          value: 30,
          min: 1
        ) %>
      </div>
    <% end %>

    <%= render FlatPack::Collapse::Component.new(id: "collapse4", title: "Borderless Variant", border: false) do %>
      <p>This variant removes the outer border and horizontal padding so content aligns edge-to-edge.</p>
    <% end %>

    <%= render FlatPack::Collapse::Component.new(id: "collapse5", title: "Borderless (Open by Default)", border: false, open: true) do %>
      <p>Use this when content should be initially visible without a framed container.</p>
    <% end %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;div class=&quot;space-y-4&quot;&gt;
        &lt;%= render FlatPack::Collapse::Component.new(id: &quot;collapse1&quot;, title: &quot;What is FlatPack?&quot;) do %&gt;
          &lt;p&gt;FlatPack is a comprehensive ViewComponent library for Ruby on Rails that provides production-ready UI components with built-in accessibility, responsive design, and thoughtful defaults.&lt;/p&gt;
        &lt;% end %&gt;
    
        &lt;%= render FlatPack::Collapse::Component.new(id: &quot;collapse2&quot;, title: &quot;How do I get started?&quot;, open: true) do %&gt;
          &lt;p&gt;Add FlatPack to your Gemfile, run &lt;code class=&quot;px-2 py-1 bg-gray-100 rounded&quot;&gt;bundle install&lt;/code&gt;, and start using components in your views. Each component follows Rails conventions and integrates seamlessly with your existing code.&lt;/p&gt;
        &lt;% end %&gt;
    
        &lt;%= render FlatPack::Collapse::Component.new(id: &quot;collapse3&quot;, title: &quot;Advanced Settings&quot;) do %&gt;
          &lt;div class=&quot;space-y-4&quot;&gt;
            &lt;%= render FlatPack::TextInput::Component.new(
              name: &quot;api_endpoint&quot;,
              label: &quot;API Endpoint&quot;,
              value: &quot;https://api.example.com&quot;
            ) %&gt;
            &lt;%= render FlatPack::NumberInput::Component.new(
              name: &quot;timeout_seconds&quot;,
              label: &quot;Timeout (seconds)&quot;,
              value: 30,
              min: 1
            ) %&gt;
          &lt;/div&gt;
        &lt;% end %&gt;

        &lt;%= render FlatPack::Collapse::Component.new(id: &quot;collapse4&quot;, title: &quot;Borderless Variant&quot;, border: false) do %&gt;
          &lt;p&gt;This variant removes the outer border and horizontal padding so content aligns edge-to-edge.&lt;/p&gt;
        &lt;% end %&gt;

        &lt;%= render FlatPack::Collapse::Component.new(id: &quot;collapse5&quot;, title: &quot;Borderless (Open by Default)&quot;, border: false, open: true) do %&gt;
          &lt;p&gt;Use this when content should be initially visible without a framed container.&lt;/p&gt;
        &lt;% end %&gt;
      &lt;/div&gt;
    CODE
    language: "erb",
    title: "Collapse Component"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Keyboard Navigation", anchor_link: true) %>
  
  <div class="p-6 bg-blue-50 border border-blue-200 rounded-lg">
    <p class="font-medium mb-2">Try these keyboard shortcuts:</p>
    <%= render FlatPack::List::Component.new(spacing: :dense, class: "text-sm") do %>
      <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><kbd class="px-2 py-1 bg-white border rounded">Tab</kbd> - Navigate between collapse items<% end %>
      <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><kbd class="px-2 py-1 bg-white border rounded">Space</kbd> or <kbd class="px-2 py-1 bg-white border rounded">Enter</kbd> - Toggle open/closed<% end %>
      <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><kbd class="px-2 py-1 bg-white border rounded">Escape</kbd> - Close focused item (if open)<% end %>
    <% end %>
  </div>
</section>
