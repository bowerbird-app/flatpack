<%= render FlatPack::PageTitle::Component.new(
  title: "Combobox",
  subtitle: "A searchable single choice. Type to filter, then pick a value for the form."
) %>

<%= render "pages/component_method_variables_table", component: :combobox %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Filter and select", anchor_link: true) %>

  <div class="space-y-6 max-w-md p-6 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded-[var(--radius-lg)]">
    <%= render FlatPack::Combobox::Component.new(
      name: "city",
      label: "City",
      placeholder: "Search cities",
      value: "melbourne",
      options: [
        {value: "melbourne", label: "Melbourne"},
        {value: "sydney", label: "Sydney"},
        {value: "brisbane", label: "Brisbane"},
        {value: "perth", label: "Perth"},
        {value: "adelaide", label: "Adelaide"}
      ]
    ) %>

    <%= render FlatPack::Combobox::Component.new(
      name: "country",
      label: "Country",
      options: ["Australia", "Canada", "United Kingdom", "United States"],
      placeholder: "Search countries"
    ) %>

    <%= render FlatPack::Combobox::Component.new(
      name: "plan",
      label: "Plan (disabled)",
      options: ["Starter", "Team"],
      value: "Team",
      disabled: true
    ) %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Combobox::Component.new(
        name: "city",
        label: "City",
        value: "melbourne",
        options: [
          {value: "melbourne", label: "Melbourne"},
          {value: "sydney", label: "Sydney"}
        ]
      ) %&gt;
    CODE
    language: "erb",
    title: "Combobox"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Type to fetch", anchor_link: true) %>

  <p class="mb-4 text-sm text-[var(--surface-muted-content-color)]">Three letters, then the list comes from the server. Pick a row to fill the hidden value.</p>

  <div class="space-y-6 max-w-md p-6 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded-[var(--radius-lg)]">
    <%= render FlatPack::Combobox::Component.new(
      name: "place_id",
      label: "Place",
      placeholder: "Search places",
      search_endpoint: demo_forms_combobox_options_path,
      search_param: "q",
      min_search_length: 3,
      debounce: 300
    ) %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Combobox::Component.new(
        name: "place_id",
        label: "Place",
        search_endpoint: place_search_path,
        search_param: "q",
        min_search_length: 3,
        debounce: 300
      ) %&gt;
    CODE
    language: "erb",
    title: "Async Combobox"
  ) %>
</section>
