<%= render FlatPack::PageTitle::Component.new(
  title: "Button Groups",
  subtitle: "A joined row, or ghost actions on a surface."
) %>


<!-- Button Groups (Wrapped) -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Button Groups (Wrapped Together)", anchor_link: true, subtitle: "Examples for Button Groups (Wrapped Together).") %>
  <div id="joined-text" class="mb-4">
    <%= render FlatPack::ButtonGroup::Component.new(
      data: {
        controller: "segmented-buttons-demo",
        segmented_buttons_demo_active_style_value: "primary",
        segmented_buttons_demo_inactive_style_value: "secondary",
        segmented_buttons_demo_active_press_class_value: FlatPack::Button::StyleRegistry.press_class(:primary),
        segmented_buttons_demo_inactive_press_class_value: FlatPack::Button::StyleRegistry.press_class(:secondary)
      }
    ) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Left", style: :primary, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(text: "Middle", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(text: "Right", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
    <% end %>
  </div>
  <div class="mb-4">
    <%= render FlatPack::ButtonGroup::Component.new(
      data: {
        controller: "segmented-buttons-demo",
        segmented_buttons_demo_active_style_value: "primary",
        segmented_buttons_demo_inactive_style_value: "secondary",
        segmented_buttons_demo_active_press_class_value: FlatPack::Button::StyleRegistry.press_class(:primary),
        segmented_buttons_demo_inactive_press_class_value: FlatPack::Button::StyleRegistry.press_class(:secondary)
      }
    ) do |group| %>
      <% group.button(FlatPack::Button::Component.new(icon: "align-left", icon_only: true, style: :primary, aria: { pressed: true, label: "Align left" }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(icon: "align-center", icon_only: true, style: :secondary, aria: { pressed: false, label: "Align centre" }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(icon: "align-right", icon_only: true, style: :secondary, aria: { pressed: false, label: "Align right" }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::ButtonGroup::Component.new(
        data: {
          controller: "segmented-buttons-demo",
          segmented_buttons_demo_active_style_value: "primary",
          segmented_buttons_demo_inactive_style_value: "secondary",
          segmented_buttons_demo_active_press_class_value: FlatPack::Button::StyleRegistry.press_class(:primary),
          segmented_buttons_demo_inactive_press_class_value: FlatPack::Button::StyleRegistry.press_class(:secondary)
        }
      ) do |group| %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Left", style: :primary, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Middle", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Right", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="outlined">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "A quiet outline",
    anchor_link: true,
    subtitle: "Ghost actions on the surface. They sit apart. Overflow is a ghost too."
  ) %>
  <div id="outlined-plain" class="mb-8">
    <%= render FlatPack::ButtonGroup::Component.new(variant: :outlined) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Edit", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Share", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :ghost, size: :sm)) %>
    <% end %>
  </div>
  <div id="outlined-overflow-icon" class="mb-8 flex min-h-72 items-start">
    <%= render FlatPack::ButtonGroup::Component.new(variant: :outlined, visible: 2) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Edit", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Share", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :ghost, size: :sm)) %>
    <% end %>
  </div>
  <div id="outlined-overflow-label" class="mb-4 flex min-h-72 items-start">
    <%= render FlatPack::ButtonGroup::Component.new(variant: :outlined, visible: 2, overflow_label: "More") do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Edit", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Share", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :ghost, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :ghost, size: :sm)) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::ButtonGroup::Component.new(variant: :outlined, visible: 2) do |group| %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Edit", style: :ghost, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Share", style: :ghost, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :ghost, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Archive", style: :ghost, size: :sm)) %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::ButtonGroup::Component.new(variant: :outlined, visible: 2, overflow_label: "More") do |group| %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Edit", style: :ghost, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Share", style: :ghost, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :ghost, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Archive", style: :ghost, size: :sm)) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="collapsing-menu">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Collapses on a phone",
    anchor_link: true,
    subtitle: "Same buttons. A row when the window is wide, one menu when it is narrow. Share opens its items in that menu."
  ) %>
  <div id="collapsing-menu-preview" class="mb-4 flex min-h-72 items-start justify-end">
    <%= render FlatPack::ButtonGroup::Component.new(collapse: :menu, menu_label: "More") do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary, icon: "pencil")) %>
      <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
        <% dropdown.menu_item(text: "Copy link", href: "#") %>
        <% dropdown.menu_item(text: "Email", href: "#") %>
      <% end %>
      <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger)) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::ButtonGroup::Component.new(collapse: :menu, menu_label: "More") do |group| %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary, icon: "pencil")) %&gt;
        &lt;% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %&gt;
          &lt;% dropdown.menu_item(text: "Copy link", href: "#") %&gt;
          &lt;% dropdown.menu_item(text: "Email", href: "#") %&gt;
        &lt;% end %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger)) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="overflow">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "More on a wide screen",
    anchor_link: true,
    subtitle: "Two stay in the row. The rest sit under the ellipsis. Delete can be sent there on purpose, and Duplicate can stay."
  ) %>
  <div id="overflow-count" class="mb-8 flex min-h-72 items-start justify-end">
    <%= render FlatPack::ButtonGroup::Component.new(visible: 2, collapse: :menu) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :secondary, size: :sm)) %>
      <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary, size: :sm)) do |dropdown| %>
        <% dropdown.menu_item(text: "Copy link", href: "#") %>
        <% dropdown.menu_item(text: "Email", href: "#") %>
      <% end %>
      <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger, size: :sm)) %>
    <% end %>
  </div>
  <div id="overflow-override" class="mb-4 flex min-h-72 items-start justify-end">
    <%= render FlatPack::ButtonGroup::Component.new(visible: 2, collapse: :menu) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary, size: :sm)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Delete", style: :danger, size: :sm), overflow: true) %>
      <% group.button(FlatPack::Button::Component.new(text: "Share", style: :secondary, size: :sm, href: "#")) %>
      <% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :secondary, size: :sm), overflow: false) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::ButtonGroup::Component.new(visible: 2, collapse: :menu) do |group| %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary, size: :sm)) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Delete", style: :danger, size: :sm), overflow: true) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Share", style: :secondary, size: :sm, href: "#")) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :secondary, size: :sm), overflow: false) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="joined-dropdown">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "A dropdown joins the row",
    anchor_link: true,
    subtitle: "The direct child takes the segment. First, middle, last, and on its own. A wrapper around a dropdown keeps that dropdown's own shape."
  ) %>
  <div id="joined-dropdown-plain" class="mb-6 flex flex-wrap items-start gap-6">
    <div id="joined-plain-first">
      <%= render FlatPack::ButtonGroup::Component.new do |group| %>
        <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
          <% dropdown.menu_item(text: "Copy link", href: "#") %>
          <% dropdown.menu_item(text: "Email", href: "#") %>
        <% end %>
        <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary)) %>
        <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger)) %>
      <% end %>
    </div>
    <div id="joined-plain-middle">
      <%= render FlatPack::ButtonGroup::Component.new do |group| %>
        <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary)) %>
        <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
          <% dropdown.menu_item(text: "Copy link", href: "#") %>
          <% dropdown.menu_item(text: "Email", href: "#") %>
        <% end %>
        <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger)) %>
      <% end %>
    </div>
    <div id="joined-plain-last">
      <%= render FlatPack::ButtonGroup::Component.new do |group| %>
        <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary)) %>
        <% group.button(FlatPack::Button::Component.new(text: "Duplicate", style: :secondary)) %>
        <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
          <% dropdown.menu_item(text: "Copy link", href: "#") %>
          <% dropdown.menu_item(text: "Email", href: "#") %>
        <% end %>
      <% end %>
    </div>
    <div id="joined-plain-only">
      <%= render FlatPack::ButtonGroup::Component.new do |group| %>
        <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
          <% dropdown.menu_item(text: "Copy link", href: "#") %>
          <% dropdown.menu_item(text: "Email", href: "#") %>
        <% end %>
      <% end %>
    </div>
  </div>
  <div id="joined-dropdown-collapse" class="mb-6 flex flex-wrap items-start gap-6">
    <div id="joined-collapse-middle">
      <%= render FlatPack::ButtonGroup::Component.new(collapse: :menu, menu_label: "More") do |group| %>
        <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary)) %>
        <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
          <% dropdown.menu_item(text: "Copy link", href: "#") %>
          <% dropdown.menu_item(text: "Email", href: "#") %>
        <% end %>
        <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger)) %>
      <% end %>
    </div>
    <div id="joined-collapse-only">
      <%= render FlatPack::ButtonGroup::Component.new(collapse: :menu, menu_label: "More") do |group| %>
        <% group.button(FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary)) do |dropdown| %>
          <% dropdown.menu_item(text: "Copy link", href: "#") %>
          <% dropdown.menu_item(text: "Email", href: "#") %>
        <% end %>
      <% end %>
    </div>
  </div>
  <div id="joined-dropdown-nested" class="mb-4">
    <%= render FlatPack::ButtonGroup::Component.new do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Rename", style: :secondary)) %>
      <% group.button(capture do %>
        <div class="publishable-quick-actions">
          <div hidden>Queued</div>
          <%= render FlatPack::Button::Dropdown::Component.new(text: "Share", style: :secondary) do |dropdown| %>
            <% dropdown.menu_item(text: "Copy link", href: "#") %>
            <% dropdown.menu_item(text: "Email", href: "#") %>
          <% end %>
        </div>
      <% end) %>
      <% group.button(FlatPack::Button::Component.new(text: "Archive", style: :danger)) %>
    <% end %>
  </div>
</section>

<section class="mb-12" id="menu-collapse">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Menu collapse",
    anchor_link: true,
    subtitle: "A labelled row that opens the next rows in place. The same piece the phone menu uses for Share."
  ) %>
  <div id="menu-collapse-preview" class="mb-4 max-w-xs">
    <%= render FlatPack::Menu::Collapse::Component.new(title: "Share", icon: "pencil") do |section| %>
      <% section.items do %>
        <%= link_to "Copy link", "#" %>
        <%= link_to "Email", "#" %>
      <% end %>
    <% end %>
    <%= render FlatPack::Menu::Collapse::Component.new(title: "More", open: true) do |section| %>
      <% section.items do %>
        <%= link_to "Duplicate", "#" %>
        <%= button_tag "Archive", type: "button", data: {fp_style: "danger"} %>
      <% end %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Menu::Collapse::Component.new(title: "Share", icon: "pencil") do |section| %&gt;
        &lt;% section.items do %&gt;
          &lt;%= link_to "Copy link", "#" %&gt;
          &lt;%= link_to "Email", "#" %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<%= render "shared/related_demos",
  links: [
    {text: "Buttons", href: demo_buttons_path},
    {text: "Links", href: demo_links_path},
    {text: "Pill Buttons", href: demo_buttons_pills_path},
    {text: "Segmented", href: demo_buttons_segmented_path},
    {text: "Dropdowns", href: demo_buttons_dropdowns_path}
  ] %>
