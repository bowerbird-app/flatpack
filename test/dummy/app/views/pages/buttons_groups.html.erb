<%= render FlatPack::PageTitle::Component.new(
  title: "Button Groups",
  subtitle: "Visually connected button groups with shared borders."
) %>


<!-- Button Groups (Wrapped) -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Button Groups (Wrapped Together)", anchor_link: true, subtitle: "Examples for Button Groups (Wrapped Together).") %>
  <div class="mb-4">
    <%= render FlatPack::ButtonGroup::Component.new(
      data: {
        controller: "segmented-buttons-demo",
        segmented_buttons_demo_active_classes_value: FlatPack::Button::Component::SCHEMES[:primary],
        segmented_buttons_demo_inactive_classes_value: FlatPack::Button::Component::SCHEMES[:secondary]
      }
    ) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Left", style: :primary, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(text: "Middle", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(text: "Right", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
    <% end %>
  </div>
  <div class="mb-4">
    <%= render FlatPack::ButtonGroup::Component.new(
      data: {
        controller: "segmented-buttons-demo",
        segmented_buttons_demo_active_classes_value: FlatPack::Button::Component::SCHEMES[:primary],
        segmented_buttons_demo_inactive_classes_value: FlatPack::Button::Component::SCHEMES[:secondary]
      }
    ) do |group| %>
      <% group.button(FlatPack::Button::Component.new(icon: "align-left", icon_only: true, style: :primary, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(icon: "align-center", icon_only: true, style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
      <% group.button(FlatPack::Button::Component.new(icon: "align-right", icon_only: true, style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::ButtonGroup::Component.new(
        data: {
          controller: "segmented-buttons-demo",
          segmented_buttons_demo_active_classes_value: FlatPack::Button::Component::SCHEMES[:primary],
          segmented_buttons_demo_inactive_classes_value: FlatPack::Button::Component::SCHEMES[:secondary]
        }
      ) do |group| %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Left", style: :primary, aria: { pressed: true }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Middle", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %&gt;
        &lt;% group.button(FlatPack::Button::Component.new(text: "Right", style: :secondary, aria: { pressed: false }, data: { segmented_buttons_demo_target: "button", action: "segmented-buttons-demo#activate" })) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<%= render "shared/related_demos",
  links: [
    {text: "Buttons", href: demo_buttons_path},
    {text: "Links", href: demo_links_path},
    {text: "Pill Buttons", href: demo_buttons_pills_path},
    {text: "Segmented", href: demo_buttons_segmented_path},
    {text: "Dropdowns", href: demo_buttons_dropdowns_path}
  ] %>
