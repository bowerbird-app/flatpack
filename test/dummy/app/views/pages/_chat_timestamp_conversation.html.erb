<%= render FlatPack::Chat::MessageList::Component.new(stick_to_bottom: false) do %>
  <%= render FlatPack::Chat::DateDivider::Component.new(label: "Today") %>

  <%= render FlatPack::Chat::MessageGroup::Component.new(direction: :incoming, show_avatar: true, show_name: true, sender_name: "Mina") do |group| %>
    <% group.avatar do %>
      <%= render FlatPack::Avatar::Component.new(name: "Mina Cho", size: :sm) %>
    <% end %>
    <% group.message do %>
      <%= render FlatPack::Chat::ReceivedMessage::Component.new(
        timestamp: Time.zone.parse("2026-11-10 10:02"),
        reveal_timestamp: true
      ) do %>
        Can you glance at the launch notes?
      <% end %>
    <% end %>
    <% group.message do %>
      <%= render FlatPack::Chat::ReceivedMessage::Component.new(
        timestamp: Time.zone.parse("2026-11-10 10:08"),
        reveal_timestamp: true
      ) do %>
        Page two still feels loud.
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Chat::DateDivider::Component.new(label: "11:30 AM") %>

  <%= render FlatPack::Chat::MessageGroup::Component.new(direction: :incoming, show_avatar: true, sender_name: "Mina") do |group| %>
    <% group.avatar do %>
      <%= render FlatPack::Avatar::Component.new(name: "Mina Cho", size: :sm) %>
    <% end %>
    <% group.message do %>
      <%= render FlatPack::Chat::ReceivedMessage::Component.new(
        timestamp: Time.zone.parse("2026-11-10 11:32"),
        reveal_timestamp: true
      ) do %>
        Back from coffee. This version sings.
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Chat::MessageGroup::Component.new(direction: :outgoing, show_avatar: false) do |group| %>
    <% group.message do %>
      <%= render FlatPack::Chat::SentMessage::Component.new(
        timestamp: Time.zone.parse("2026-11-10 11:33"),
        reveal_timestamp: true
      ) do %>
        Shipping that cut.
      <% end %>
    <% end %>
    <% group.message do %>
      <%= render FlatPack::Chat::SentMessage::Component.new(
        timestamp: Time.zone.parse("2026-11-10 14:30"),
        reveal_timestamp: true
      ) do %>
        Posted. Hover me for the time.
      <% end %>
    <% end %>
    <% group.status do %>
      <%= render FlatPack::Chat::SentAt::Component.new(timestamp: Time.zone.parse("2026-11-10 14:30")) %>
    <% end %>
  <% end %>
<% end %>
