<%= render FlatPack::PageTitle::Component.new(
  title: "Empty State Component",
  subtitle: "An empty screen is an invitation to act, not a picture of an empty box."
) %>

<%= render "pages/component_method_variables_table", component: :empty_state %>

<!-- Canonical: title, what to do, action -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Start from an action", anchor_link: true, subtitle: "Title, a short next step, and a button. The icon is optional.") %>
  <div class="border border-[var(--surface-border-color)] rounded-lg p-8">
    <%= render FlatPack::EmptyState::Component.new(
      title: "No projects yet",
      description: "Create a project to group work in one place."
    ) do |empty| %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: "Create project", style: :primary) %>
        <%= render FlatPack::Button::Component.new(text: "Import a project", style: :secondary) %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::EmptyState::Component.new(
        title: "No projects yet",
        description: "Create a project to group work in one place."
      ) do |empty| %&gt;
        &lt;% empty.slot do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Create project", style: :primary) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<!-- Empty then content -->
<section class="mb-12" data-controller="empty-state-demo">
  <%= render FlatPack::SectionTitle::Component.new(title: "Empty then content", anchor_link: true, subtitle: "When the first item arrives, fade the empty panel out and the content in. Hosts add fp-content-enter to the replacement.") %>
  <div class="flex flex-wrap gap-3 mb-4">
    <%= render FlatPack::Button::Component.new(
      text: "Show empty",
      style: :secondary,
      data: {action: "click->empty-state-demo#showEmpty"}
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Show content",
      style: :primary,
      data: {action: "click->empty-state-demo#showContent"}
    ) %>
  </div>
  <div class="border border-[var(--surface-border-color)] rounded-lg p-8 min-h-[16rem]">
    <div data-empty-state-demo-target="empty">
      <%= render FlatPack::EmptyState::Component.new(
        title: "No messages yet",
        description: "Start a conversation. New threads show up here."
      ) do |empty| %>
        <% empty.slot do %>
          <%= render FlatPack::Button::Component.new(
            text: "Write a message",
            style: :primary,
            data: {action: "click->empty-state-demo#showContent"}
          ) %>
        <% end %>
      <% end %>
    </div>
    <div class="fp-content-enter space-y-3" data-empty-state-demo-target="content" hidden>
      <%= render FlatPack::List::Component.new do %>
        <%= render FlatPack::List::Item.new do %>
          <span class="font-medium">Jordan</span>
          <span class="text-sm text-[var(--surface-muted-content-color)]"> Kickoff notes are in the shared folder.</span>
        <% end %>
        <%= render FlatPack::List::Item.new do %>
          <span class="font-medium">Sam</span>
          <span class="text-sm text-[var(--surface-muted-content-color)]"> Ship checklist is ready for review.</span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- Optional quiet icon -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Optional icon", anchor_link: true, subtitle: "A small kit icon can label the context. It is not the empty state.") %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="border border-[var(--surface-border-color)] rounded-lg p-8">
      <%= render FlatPack::EmptyState::Component.new(
        title: "Inbox is clear",
        description: "New messages land here. Write one when you are ready.",
        icon: :inbox
      ) do |empty| %>
        <% empty.slot do %>
          <%= render FlatPack::Button::Component.new(text: "Write a message", style: :primary) %>
        <% end %>
      <% end %>
    </div>

    <div class="border border-[var(--surface-border-color)] rounded-lg p-8">
      <%= render FlatPack::EmptyState::Component.new(
        title: "No matches",
        description: "Try a different name or clear the filters.",
        icon: :search
      ) do |empty| %>
        <% empty.slot do %>
          <%= render FlatPack::Button::Component.new(text: "Clear filters", style: :secondary) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::EmptyState::Component.new(
        title: "No matches",
        description: "Try a different name or clear the filters.",
        icon: :search
      ) do |empty| %&gt;
        &lt;% empty.slot do %&gt;
          &lt;%= render FlatPack::Button::Component.new(text: "Clear filters", style: :secondary) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<!-- Empty State in Tables -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Empty table", anchor_link: true, subtitle: "Tables keep a single line of copy in the body. Use EmptyState above the table when the next step needs a button.") %>
  <%= render FlatPack::Table::Component.new(data: []) do |table| %>
    <% table.column(title: "Name", html: ->(row) { row.name }) %>
    <% table.column(title: "Email", html: ->(row) { row.email }) %>
    <% table.column(title: "Status", html: ->(row) { row.status }) %>
  <% end %>
</section>

<!-- Empty State in Cards -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Inside a card", anchor_link: true, subtitle: "Same pattern in a card body: what is missing, then the action.") %>
  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.header do %>
      <h3 class="text-lg font-semibold">Recent activity</h3>
    <% end %>
    <% card.body do %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "Nothing here yet",
        description: "Activity shows up after the first event."
      ) do |empty| %>
        <% empty.slot do %>
          <%= render FlatPack::Button::Component.new(text: "Record an event", style: :primary, size: :sm) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>

<!-- Custom graphic still available, not the default -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Custom graphic", anchor_link: true, subtitle: "The graphic slot is there when a host needs a brand mark. Keep it small and still lead with the action.") %>
  <div class="border border-[var(--surface-border-color)] rounded-lg p-8">
    <%= render FlatPack::EmptyState::Component.new(
      title: "No files yet",
      description: "Upload a CSV or connect a source to fill this list."
    ) do |empty| %>
      <% empty.graphic do %>
        <%= render FlatPack::Shared::IconComponent.new(name: :arrow_up_tray, size: :lg, class: "text-[var(--surface-muted-content-color)]") %>
      <% end %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(text: "Upload CSV", style: :primary) %>
        <%= render FlatPack::Button::Component.new(text: "Connect a source", style: :secondary) %>
      <% end %>
    <% end %>
  </div>
</section>
