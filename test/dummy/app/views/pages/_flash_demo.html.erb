<% return_to = local_assigns.fetch(:return_to) %>
<section class="mb-12" id="flash-demo">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Flash",
    anchor_link: true,
    subtitle: "Redirect with a notice or an alert."
  ) %>
  <p class="mb-4 text-sm text-[var(--surface-muted-content-color)]">
    These buttons set a flash and come back. The page passes that hash into FlatPack::Flash.
  </p>
  <div class="mb-4 flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Saved toast",
      href: demo_flash_path(as: "toast", key: "notice", return_to: return_to),
      style: :success
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Problem toast",
      href: demo_flash_path(as: "toast", key: "alert", return_to: return_to),
      style: :danger
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Both toasts",
      href: demo_flash_path(as: "toast", key: "both", return_to: return_to),
      style: :secondary
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Saved alert",
      href: demo_flash_path(as: "alert", key: "notice", return_to: return_to),
      style: :success
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Problem alert",
      href: demo_flash_path(as: "alert", key: "alert", return_to: return_to),
      style: :danger
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Both alerts",
      href: demo_flash_path(as: "alert", key: "both", return_to: return_to),
      style: :secondary
    ) %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Flash::Component.new(flash: flash, as: :toast) %&gt;

      &lt;%= render FlatPack::Flash::Component.new(
        flash: flash,
        as: :alert,
        styles: { saved: :success }
      ) %&gt;
    CODE
  ) %>
</section>
