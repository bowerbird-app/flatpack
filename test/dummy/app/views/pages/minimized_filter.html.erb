<%= render FlatPack::PageTitle::Component.new(
  title: "Minimized Filters",
  subtitle: "Keep filters in a dedicated modal-only flow with a single Filter trigger and applied-count badge."
) %>

<%
  erb_open = "<" + "%"
  erb_output_open = "<" + "%="
  erb_tag_close = "%" + ">"
%>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Minimized Filters",
    anchor_link: true,
    subtitle: "Use MinimizedFilters::Component when filter controls should render only inside the modal body."
  ) %>

  <p class="text-(--surface-muted-content-color) mb-4">
    This component never renders inline controls on desktop or mobile.
    Filter inputs are defined in <strong>filter_body</strong> and appear exclusively in the modal opened by the trigger.
  </p>

  <%
    minimized_filter_variables = [
      {
        variable: "id (MinimizedFilters::Component)",
        accepts: "String (required)",
        example: 'id: "minimized-filter-table-controls"'
      },
      {
        variable: "form_url (MinimizedFilters::Component)",
        accepts: "String (required)",
        example: "form_url: demo_minimized_filter_path"
      },
      {
        variable: "turbo_frame (MinimizedFilters::Component)",
        accepts: "String (required)",
        example: 'turbo_frame: "minimized-filter-table-frame"'
      },
      {
        variable: "active_count (MinimizedFilters::Component)",
        accepts: "Integer (default: 0)",
        example: "active_count: @minimized_filter_active_count"
      },
      {
        variable: "button_size (MinimizedFilters::Component)",
        accepts: "Symbol (default: :sm)",
        example: "button_size: :lg"
      },
      {
        variable: "filter_body (MinimizedFilters::Component slot)",
        accepts: "Slot content (required)",
        example: "minimized_filters.filter_body do ... end"
      },
      {
        variable: "reset_url (MinimizedFilters::Component)",
        accepts: "String, nil (default: nil)",
        example: "reset_url: demo_minimized_filter_path"
      },
      {
        variable: "mobile_form_class (MinimizedFilters::Component)",
        accepts: "String, nil",
        example: 'mobile_form_class: "space-y-3"'
      }
    ]
  %>

  <%= render FlatPack::Table::Component.new(data: minimized_filter_variables, class: "mb-4") do |table| %>
    <% table.column(title: "Variable", html: ->(row) { row[:variable] }) %>
    <% table.column(title: "Accepts", html: ->(row) { row[:accepts] }) %>
    <% table.column(title: "Example", html: ->(row) { row[:example] }) %>
  <% end %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Table Example",
    anchor_link: true,
    subtitle: "Modal-only filters targeting one table surface in a Turbo Frame."
  ) %>

  <%= turbo_frame_tag "minimized-filter-table-frame" do %>
    <div class="mb-4">
      <%= render FlatPack::MinimizedFilters::Component.new(
        id: "minimized-filter-table-controls",
        form_url: demo_minimized_filter_path,
        turbo_frame: "minimized-filter-table-frame",
        active_count: @minimized_filter_active_count,
        reset_url: demo_minimized_filter_path,
        mobile_form_class: "space-y-3 p-[0.15rem]"
      ) do |minimized_filters| %>
        <% minimized_filters.filter_body do %>
          <div class="grid gap-3">
            <%= render FlatPack::Select::Component.new(
              name: "minimized_status",
              value: @minimized_filter_status,
              options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
              label: "Status"
            ) %>

            <%= render FlatPack::Select::Component.new(
              name: "minimized_category",
              value: @minimized_filter_category,
              options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
              label: "Category"
            ) %>

            <%= render FlatPack::Search::Component.new(
              name: "minimized_q",
              value: @minimized_filter_search_query,
              placeholder: "Search table rows...",
              max_width: :none,
              class: "w-full"
            ) %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render FlatPack::Table::Component.new(data: @minimized_filter_filtered_users.first(10)) do |table| %>
      <% table.column(title: "ID", html: ->(user) { user.id.to_s }) %>
      <% table.column(title: "Name", html: ->(user) { user.name }) %>
      <% table.column(title: "Email", html: ->(user) { user.email }) %>
      <% table.column(title: "Category", html: ->(user) { user.category.to_s.titleize }) %>
      <% table.column(title: "Status", html: ->(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} turbo_frame_tag "minimized-filter-table-frame" do #{erb_tag_close}
        #{erb_output_open} render FlatPack::MinimizedFilters::Component.new(
          id: "minimized-filter-table-controls",
          form_url: demo_minimized_filter_path,
          turbo_frame: "minimized-filter-table-frame",
          active_count: @minimized_filter_active_count,
          reset_url: demo_minimized_filter_path,
          mobile_form_class: "space-y-3 p-[0.15rem]"
        ) do |minimized_filters| #{erb_tag_close}
          #{erb_open} minimized_filters.filter_body do #{erb_tag_close}
            #{erb_output_open} render FlatPack::Select::Component.new(name: "minimized_status", value: @minimized_filter_status, options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] }, label: "Status") #{erb_tag_close}
            #{erb_output_open} render FlatPack::Select::Component.new(name: "minimized_category", value: @minimized_filter_category, options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] }, label: "Category") #{erb_tag_close}
            #{erb_output_open} render FlatPack::Search::Component.new(name: "minimized_q", value: @minimized_filter_search_query, placeholder: "Search table rows...", max_width: :none, class: "w-full") #{erb_tag_close}
          #{erb_open} end #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Table Example with Inline Filters",
    anchor_link: true,
    subtitle: "Desktop and mobile both show Status, Category, and Filter count in one control row."
  ) %>

  <%= turbo_frame_tag "minimized-filter-inline-table-frame" do %>
    <div class="mb-4 flex flex-nowrap items-end gap-2 overflow-x-auto pb-1">
      <%= form_with(
        url: demo_minimized_filter_path,
        method: :get,
        class: "flex flex-nowrap items-end gap-2 shrink-0",
        data: {
          turbo_frame: "minimized-filter-inline-table-frame",
          controller: "flat-pack--auto-submit",
          action: "input->flat-pack--auto-submit#queueSubmit change->flat-pack--auto-submit#queueSubmit",
          flat_pack__auto_submit_delay_value: 300
        }
      ) do %>
        <%= render FlatPack::Select::Component.new(
          name: "inline_status",
          value: @minimized_inline_filter_status,
          options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
          label: "Status"
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "inline_category",
          value: @minimized_inline_filter_category,
          options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
          label: "Category"
        ) %>
      <% end %>

      <div class="shrink-0">
        <%= render FlatPack::MinimizedFilters::Component.new(
          id: "minimized-filter-inline-table-controls",
          form_url: demo_minimized_filter_path,
          turbo_frame: "minimized-filter-inline-table-frame",
          active_count: @minimized_inline_filter_active_count,
          reset_url: demo_minimized_filter_path,
          mobile_form_class: "space-y-3 p-[0.15rem]",
          button_size: :lg,
          class: "w-auto"
        ) do |minimized_filters| %>
          <% minimized_filters.filter_body do %>
            <div class="grid gap-3">
              <%= render FlatPack::Select::Component.new(
                name: "inline_status",
                value: @minimized_inline_filter_status,
                options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
                label: "Status"
              ) %>

              <%= render FlatPack::Select::Component.new(
                name: "inline_category",
                value: @minimized_inline_filter_category,
                options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
                label: "Category"
              ) %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= render FlatPack::Table::Component.new(data: @minimized_inline_filter_filtered_users.first(10)) do |table| %>
      <% table.column(title: "ID", html: ->(user) { user.id.to_s }) %>
      <% table.column(title: "Name", html: ->(user) { user.name }) %>
      <% table.column(title: "Email", html: ->(user) { user.email }) %>
      <% table.column(title: "Category", html: ->(user) { user.category.to_s.titleize }) %>
      <% table.column(title: "Status", html: ->(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB (Inline Filters)",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} turbo_frame_tag "minimized-filter-inline-table-frame" do #{erb_tag_close}
        #{erb_output_open} form_with(
          url: demo_minimized_filter_path,
          method: :get,
          class: "flex flex-wrap items-end gap-3",
          data: {
            turbo_frame: "minimized-filter-inline-table-frame",
            controller: "flat-pack--auto-submit",
            action: "input->flat-pack--auto-submit#queueSubmit change->flat-pack--auto-submit#queueSubmit",
            flat_pack__auto_submit_delay_value: 300
          }
        ) do #{erb_tag_close}
          #{erb_output_open} render FlatPack::Select::Component.new(name: "inline_status", value: @minimized_inline_filter_status, options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] }, label: "Status") #{erb_tag_close}
          #{erb_output_open} render FlatPack::Select::Component.new(name: "inline_category", value: @minimized_inline_filter_category, options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] }, label: "Category") #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} render FlatPack::MinimizedFilters::Component.new(
          id: "minimized-filter-inline-table-controls",
          form_url: demo_minimized_filter_path,
          turbo_frame: "minimized-filter-inline-table-frame",
          active_count: @minimized_inline_filter_active_count,
          reset_url: demo_minimized_filter_path,
          mobile_form_class: "space-y-3 p-[0.15rem]",
          button_size: :lg
        ) do |minimized_filters| #{erb_tag_close}
          #{erb_open} minimized_filters.filter_body do #{erb_tag_close}
            #{erb_output_open} render FlatPack::Select::Component.new(name: "inline_status", value: @minimized_inline_filter_status, options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] }, label: "Status") #{erb_tag_close}
            #{erb_output_open} render FlatPack::Select::Component.new(name: "inline_category", value: @minimized_inline_filter_category, options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] }, label: "Category") #{erb_tag_close}
          #{erb_open} end #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} render FlatPack::Table::Component.new(data: @minimized_inline_filter_filtered_users.first(10)) do |table| #{erb_tag_close}
          #{erb_open} table.column(title: "ID", html: ->(user) { user.id.to_s }) #{erb_tag_close}
          #{erb_open} table.column(title: "Name", html: ->(user) { user.name }) #{erb_tag_close}
          #{erb_open} table.column(title: "Email", html: ->(user) { user.email }) #{erb_tag_close}
          #{erb_open} table.column(title: "Category", html: ->(user) { user.category.to_s.titleize }) #{erb_tag_close}
          #{erb_open} table.column(title: "Status", html: ->(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>
</section>
