<%= render FlatPack::PageTitle::Component.new(
  title: "Text Input",
  subtitle: "Single-line text field examples with default, error, and disabled states."
) %>

<%= render "pages/toast_region" %>

<%= render "pages/component_method_variables_table", component: :text_input %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Text Input Examples", anchor_link: true) %>

  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body(class: "space-y-[var(--stack-gap-md)]") do %>
      <%= render FlatPack::TextInput::Component.new(
        name: "username",
        label: "Username",
        placeholder: "Enter your username",
        required: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "username_error",
        label: "Username (with error)",
        value: "john",
        error: "Username must be at least 5 characters",
        minlength: 5,
        data: {
          flat_pack_message_too_short: "Username must be at least 5 characters"
        }
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "username_disabled",
        label: "Username (disabled)",
        value: "johndoe",
        disabled: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "headline",
        id: "headline",
        label: "Headline (with character count)",
        placeholder: "Write a short headline...",
        character_count: true,
        min_characters: 20,
        max_characters: 60
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "tagline",
        id: "tagline",
        label: "Tagline (count only)",
        placeholder: "Add a short tagline...",
        character_count: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "api_key",
        id: "api_key",
        label: "API Key (quick copy)",
        value: "sk_live_1234567890",
        quick_copy: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "embed_code",
        id: "embed_code",
        label: "Embed Code (quick copy)",
        value: %q(<iframe src="https://widgets.example.com/reviews" width="100%" height="320" loading="lazy"></iframe>),
        quick_copy: true
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Card::Component.new do |card| %&gt;
        &lt;% card.body do %&gt;
        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;username&quot;,
          label: &quot;Username&quot;,
          placeholder: &quot;Enter your username&quot;,
          required: true
        ) %&gt;
    
        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;username_error&quot;,
          label: &quot;Username (with error)&quot;,
          value: &quot;john&quot;,
          error: &quot;Username must be at least 5 characters&quot;,
          minlength: 5,
          data: {
            flat_pack_message_too_short: &quot;Username must be at least 5 characters&quot;
          }
        ) %&gt;
    
        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;username_disabled&quot;,
          label: &quot;Username (disabled)&quot;,
          value: &quot;johndoe&quot;,
          disabled: true
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;headline&quot;,
          id: &quot;headline&quot;,
          label: &quot;Headline (with character count)&quot;,
          placeholder: &quot;Write a short headline...&quot;,
          character_count: true,
          min_characters: 20,
          max_characters: 60
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;tagline&quot;,
          id: &quot;tagline&quot;,
          label: &quot;Tagline (count only)&quot;,
          placeholder: &quot;Add a short tagline...&quot;,
          character_count: true
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;api_key&quot;,
          id: &quot;api_key&quot;,
          label: &quot;API Key (quick copy)&quot;,
          value: &quot;sk_live_1234567890&quot;,
          quick_copy: true
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: &quot;embed_code&quot;,
          id: &quot;embed_code&quot;,
          label: &quot;Embed Code (quick copy)&quot;,
          value: %q(&lt;iframe src=&quot;https://widgets.example.com/reviews&quot; width=&quot;100%&quot; height=&quot;320&quot; loading=&quot;lazy&quot;&gt;&lt;/iframe&gt;),
          quick_copy: true
        ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    language: "erb",
    title: "Text Input Examples"
  ) %>
</section>
