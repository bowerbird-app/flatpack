<% content_for :title, "Input Components - FlatPack" %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Input Components",
  subtitle: "Text-based input components with Stimulus integration"
) %>

<%= render "pages/toast_region" %>

<%= render "pages/component_method_variables_table", component: :text_input %>

  <!-- Text Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Text Input", anchor_link: true, subtitle: "Examples for Text Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Standard single-line text field</p>
    
    <div class="space-y-4">
      <%= render FlatPack::TextInput::Component.new(
        name: "username",
        label: "Username",
        placeholder: "Enter your username",
        help_text: "Use the name teammates will recognize.",
        required: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "username_error",
        label: "Username (with error)",
        value: "john",
        error: "Username must be at least 5 characters",
        help_text: "Usernames should be clear and searchable.",
        minlength: 5,
        data: {
          flat_pack_message_too_short: "Username must be at least 5 characters"
        }
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "username_disabled",
        label: "Username (disabled)",
        value: "johndoe",
        help_text: "Disabled fields keep their existing value.",
        disabled: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "headline",
        id: "headline",
        label: "Headline (with character count)",
        placeholder: "Write a short headline...",
        help_text: "Keep this headline brief and specific.",
        character_count: true,
        min_characters: 20,
        max_characters: 60
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "tagline",
        id: "tagline",
        label: "Tagline (count only)",
        placeholder: "Add a short tagline...",
        help_text: "A short tagline works best for cards and previews.",
        character_count: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "api_key",
        id: "api_key",
        label: "API Key (quick copy)",
        value: "sk_live_1234567890",
        help_text: "Use quick copy for values users need to paste elsewhere.",
        quick_copy: true
      ) %>

      <%= render FlatPack::TextInput::Component.new(
        name: "embed_code",
        id: "embed_code",
        label: "Embed Code (quick copy)",
        value: %q(<iframe src="https://widgets.example.com/reviews" width="100%" height="320" loading="lazy"></iframe>),
        help_text: "Copy the full snippet into the destination page.",
        quick_copy: true
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::TextInput::Component.new(
          name: "username",
          label: "Username",
          placeholder: "Enter your username",
          help_text: "Use the name teammates will recognize.",
          required: true
        ) %&gt;
        
        &lt;%= render FlatPack::TextInput::Component.new(
          name: "username_error",
          label: "Username (with error)",
          value: "john",
          error: "Username must be at least 5 characters",
          help_text: "Usernames should be clear and searchable.",
          minlength: 5,
          data: {
            flat_pack_message_too_short: "Username must be at least 5 characters"
          }
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: "headline",
          id: "headline",
          label: "Headline (with character count)",
          placeholder: "Write a short headline...",
          help_text: "Keep this headline brief and specific.",
          character_count: true,
          min_characters: 20,
          max_characters: 60
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: "tagline",
          id: "tagline",
          label: "Tagline (count only)",
          placeholder: "Add a short tagline...",
          help_text: "A short tagline works best for cards and previews.",
          character_count: true
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: "api_key",
          id: "api_key",
          label: "API Key (quick copy)",
          value: "sk_live_1234567890",
          help_text: "Use quick copy for values users need to paste elsewhere.",
          quick_copy: true
        ) %&gt;

        &lt;%= render FlatPack::TextInput::Component.new(
          name: "embed_code",
          id: "embed_code",
          label: "Embed Code (quick copy)",
          value: %q(&lt;iframe src="https://widgets.example.com/reviews" width="100%" height="320" loading="lazy"&gt;&lt;/iframe&gt;),
          help_text: "Copy the full snippet into the destination page.",
          quick_copy: true
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Password Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Password Input", anchor_link: true, subtitle: "Examples for Password Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Masked input with show/hide toggle</p>
    
    <div class="space-y-4">
      <%= render FlatPack::PasswordInput::Component.new(
        name: "password",
        label: "Password",
        placeholder: "Enter your password",
        help_text: "Use at least 12 characters for better protection.",
        required: true
      ) %>

      <%= render FlatPack::PasswordInput::Component.new(
        name: "password_error",
        label: "Password (with error)",
        error: "Password must contain at least one number",
        help_text: "Include at least one number to meet the rule.",
        pattern: "(?=.*\\d).+",
        data: {
          flat_pack_message_pattern_mismatch: "Password must contain at least one number"
        }
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::PasswordInput::Component.new(
          name: "password",
          label: "Password",
          placeholder: "Enter your password",
          help_text: "Use at least 12 characters for better protection.",
          required: true
        ) %&gt;
        
        &lt;%= render FlatPack::PasswordInput::Component.new(
          name: "password_error",
          label: "Password (with error)",
          error: "Password must contain at least one number",
          help_text: "Include at least one number to meet the rule.",
          pattern: "(?=.*\d).+",
          data: {
            flat_pack_message_pattern_mismatch: "Password must contain at least one number"
          }
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Email Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Email Input", anchor_link: true, subtitle: "Examples for Email Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Email field with mobile @ keyboard support</p>
    
    <div class="space-y-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "email",
        label: "Email Address",
        placeholder: "you@example.com",
        help_text: "We only use this for account notifications.",
        required: true
      ) %>

      <%= render FlatPack::EmailInput::Component.new(
        name: "email_error",
        label: "Email (with error)",
        value: "invalid-email",
        help_text: "Email addresses must include a valid domain.",
        error: "Please enter a valid email address"
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::EmailInput::Component.new(
          name: "email",
          label: "Email Address",
          placeholder: "you@example.com",
          help_text: "We only use this for account notifications.",
          required: true
        ) %&gt;
        
        &lt;%= render FlatPack::EmailInput::Component.new(
          name: "email_error",
          label: "Email (with error)",
          value: "invalid-email",
          help_text: "Email addresses must include a valid domain.",
          error: "Please enter a valid email address"
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Phone Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Phone Input", anchor_link: true, subtitle: "Examples for Phone Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Phone field with numeric keypad on mobile</p>
    
    <div class="space-y-4">
      <%= render FlatPack::PhoneInput::Component.new(
        name: "phone",
        label: "Phone Number",
        placeholder: "+1 (555) 123-4567",
        help_text: "Include a country code when collecting international numbers."
      ) %>

      <%= render FlatPack::PhoneInput::Component.new(
        name: "phone_error",
        label: "Phone (with error)",
        value: "123",
        error: "Phone number must be at least 10 digits",
        help_text: "Enter at least 10 digits for domestic numbers.",
        minlength: 10,
        data: {
          flat_pack_message_too_short: "Phone number must be at least 10 digits"
        }
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::PhoneInput::Component.new(
          name: "phone",
          label: "Phone Number",
          placeholder: "+1 (555) 123-4567",
          help_text: "Include a country code when collecting international numbers."
        ) %&gt;
        
        &lt;%= render FlatPack::PhoneInput::Component.new(
          name: "phone_error",
          label: "Phone (with error)",
          value: "123",
          error: "Phone number must be at least 10 digits",
          help_text: "Enter at least 10 digits for domestic numbers.",
          minlength: 10,
          data: {
            flat_pack_message_too_short: "Phone number must be at least 10 digits"
          }
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Search Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Search Input", anchor_link: true, subtitle: "Examples for Search Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Search field with clear button (appears when typing)</p>
    
    <div class="space-y-4">
      <%= render FlatPack::SearchInput::Component.new(
        name: "search",
        label: "Search",
        placeholder: "Search for anything...",
        help_text: "Search by name, tag, or reference number."
      ) %>

      <%= render FlatPack::SearchInput::Component.new(
        name: "search_with_value",
        label: "Search (with value)",
        value: "sample query",
        help_text: "Prefilled searches can be edited before submitting."
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::SearchInput::Component.new(
          name: "search",
          label: "Search",
          placeholder: "Search for anything...",
          help_text: "Search by name, tag, or reference number."
        ) %&gt;
        
        &lt;%= render FlatPack::SearchInput::Component.new(
          name: "search_with_value",
          label: "Search (with value)",
          value: "sample query",
          help_text: "Prefilled searches can be edited before submitting."
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- URL Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "URL Input", anchor_link: true, subtitle: "Examples for URL Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">URL field with validation and .com keyboard on mobile</p>
    
    <div class="space-y-4">
      <%= render FlatPack::UrlInput::Component.new(
        name: "website",
        label: "Website URL",
        placeholder: "https://example.com",
        help_text: "Use a full URL beginning with https://."
      ) %>

      <%= render FlatPack::UrlInput::Component.new(
        name: "website_error",
        label: "Website (with error)",
        value: "not-a-url",
        help_text: "URLs should include a protocol and valid host.",
        error: "Please enter a valid URL"
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::UrlInput::Component.new(
          name: "website",
          label: "Website URL",
          placeholder: "https://example.com",
          help_text: "Use a full URL beginning with https://."
        ) %&gt;
        
        &lt;%= render FlatPack::UrlInput::Component.new(
          name: "website_error",
          label: "Website (with error)",
          value: "not-a-url",
          help_text: "URLs should include a protocol and valid host.",
          error: "Please enter a valid URL"
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Text Area -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Text Area", anchor_link: true, subtitle: "Examples for Text Area.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Multi-line input that auto-expands and supports optional live character counting with min/max thresholds</p>
    
    <div class="space-y-4">
      <%= render FlatPack::TextArea::Component.new(
        name: "description",
        label: "Description",
        placeholder: "Enter a detailed description...",
        help_text: "Plain text help appears below the field and above validation messages.",
        rows: 3
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "description_with_value",
        label: "Description (with value)",
        value: "This is a sample description.\nIt has multiple lines.\nTry adding more!",
        help_text: "Existing multiline content can still include helper guidance.",
        rows: 3
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "description_error",
        label: "Description (with error)",
        error: "Description must be at least 50 characters",
        help_text: "Describe the item clearly enough for reviewers.",
        required: true,
        minlength: 50,
        data: {
          flat_pack_message_required: "Description must be at least 50 characters",
          flat_pack_message_too_short: "Description must be at least 50 characters"
        },
        rows: 3
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "project_summary",
        id: "project_summary",
        label: "Project Summary (with character count)",
        placeholder: "Write a short summary...",
        rows: 3,
        help_text: "Summaries should stay within the configured length range.",
        character_count: true,
        min_characters: 30,
        max_characters: 140
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "release_notes",
        id: "release_notes",
        label: "Release Notes (quick copy)",
        value: "Fixed onboarding bug\nAdded quick copy to text area",
        rows: 3,
        help_text: "Quick copy is useful for reusable notes and snippets.",
        quick_copy: true
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::TextArea::Component.new(
          name: "description",
          label: "Description",
          placeholder: "Enter a detailed description...",
          help_text: "Plain text help appears below the field and above validation messages.",
          rows: 3
        ) %&gt;
        
        &lt;%= render FlatPack::TextArea::Component.new(
          name: "description_error",
          label: "Description (with error)",
          error: "Description must be at least 50 characters",
          help_text: "Describe the item clearly enough for reviewers.",
          required: true,
          minlength: 50,
          data: {
            flat_pack_message_required: "Description must be at least 50 characters",
            flat_pack_message_too_short: "Description must be at least 50 characters"
          },
          rows: 3
        ) %&gt;
        
        &lt;%= render FlatPack::TextArea::Component.new(
          name: "project_summary",
          id: "project_summary",
          label: "Project Summary (with character count)",
          help_text: "Summaries should stay within the configured length range.",
          character_count: true,
          min_characters: 30,
          max_characters: 140,
          rows: 3
        ) %&gt;

        &lt;%= render FlatPack::TextArea::Component.new(
          name: "release_notes",
          id: "release_notes",
          label: "Release Notes (quick copy)",
          value: "Fixed onboarding bug\nAdded quick copy to text area",
          rows: 3,
          help_text: "Quick copy is useful for reusable notes and snippets.",
          quick_copy: true
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Number Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Number Input", anchor_link: true, subtitle: "Examples for Number Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Numeric field with min/max/step validation</p>
    
    <div class="space-y-4">
      <%= render FlatPack::NumberInput::Component.new(
        name: "quantity",
        label: "Quantity",
        placeholder: "Enter quantity",
        min: 0,
        max: 100,
        step: 1,
        help_text: "Whole numbers from 0 to 100 are accepted.",
        required: true
      ) %>

      <%= render FlatPack::NumberInput::Component.new(
        name: "price",
        label: "Price (USD)",
        placeholder: "0.00",
        min: 0.01,
        step: 0.01,
        help_text: "Use decimal values for cents.",
        value: 19.99
      ) %>

      <%= render FlatPack::NumberInput::Component.new(
        name: "quantity_error",
        label: "Quantity (with error)",
        value: 150,
        error: "Quantity must not exceed 100",
        help_text: "Keep the quantity within the allowed range.",
        max: 100
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::NumberInput::Component.new(
          name: "quantity",
          label: "Quantity",
          placeholder: "Enter quantity",
          min: 0,
          max: 100,
          step: 1,
          help_text: "Whole numbers from 0 to 100 are accepted.",
          required: true
        ) %&gt;
        
        &lt;%= render FlatPack::NumberInput::Component.new(
          name: "price",
          label: "Price (USD)",
          placeholder: "0.00",
          min: 0.01,
          step: 0.01,
          help_text: "Use decimal values for cents.",
          value: 19.99
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Date Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Date Input", anchor_link: true, subtitle: "Examples for Date Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Date picker with min/max constraints</p>
    
    <div class="space-y-4">
      <%= render FlatPack::DateInput::Component.new(
        name: "birth_date",
        label: "Birth Date",
        placeholder: "Select date",
        max: Date.today.to_s,
        help_text: "Future dates are not accepted for birth dates.",
        required: true
      ) %>

      <%= render FlatPack::DateInput::Component.new(
        name: "event_date",
        label: "Event Date",
        min: Date.today.to_s,
        max: (Date.today + 90).to_s,
        help_text: "Events can be scheduled up to 90 days ahead.",
        value: (Date.today + 7).to_s
      ) %>

      <%= render FlatPack::DateInput::Component.new(
        name: "date_error",
        label: "Date (with error)",
        value: Date.today.to_s,
        min: Date.tomorrow.to_s,
        error: "Date must be in the future",
        help_text: "Choose a future date for scheduled work.",
        data: {
          flat_pack_message_range_underflow: "Date must be in the future"
        }
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::DateInput::Component.new(
          name: "birth_date",
          label: "Birth Date",
          placeholder: "Select date",
          max: Date.today.to_s,
          help_text: "Future dates are not accepted for birth dates.",
          required: true
        ) %&gt;
        
        &lt;%= render FlatPack::DateInput::Component.new(
          name: "event_date",
          label: "Event Date",
          min: Date.today.to_s,
          max: (Date.today + 90).to_s,
          help_text: "Events can be scheduled up to 90 days ahead.",
          value: (Date.today + 7).to_s
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- File Input -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "File Input", anchor_link: true, subtitle: "Examples for File Input.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">File upload with drag-and-drop and previews</p>
    
    <div class="space-y-4">
      <%= render FlatPack::FileInput::Component.new(
        name: "avatar",
        label: "Profile Picture",
        accept: "image/png,image/jpeg,image/gif",
        max_size: 2_097_152, # 2MB
        help_text: "PNG, JPEG, or GIF images up to 2 MB are accepted.",
        preview: true
      ) %>

      <%= render FlatPack::FileInput::Component.new(
        name: "documents",
        label: "Upload Documents",
        accept: ".pdf,.doc,.docx",
        multiple: true,
        max_size: 5_242_880, # 5MB
        help_text: "Upload one or more PDF or Word documents up to 5 MB each.",
        preview: false
      ) %>

      <%= render FlatPack::FileInput::Component.new(
        name: "file_error",
        label: "File (with error)",
        error: "File size must not exceed 5MB",
        help_text: "Select a smaller file before submitting.",
        max_size: 5_242_880
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::FileInput::Component.new(
          name: "avatar",
          label: "Profile Picture",
          accept: "image/png,image/jpeg,image/gif",
          max_size: 2_097_152, # 2MB
          help_text: "PNG, JPEG, or GIF images up to 2 MB are accepted.",
          preview: true
        ) %&gt;
        
        &lt;%= render FlatPack::FileInput::Component.new(
          name: "documents",
          label: "Upload Documents",
          accept: ".pdf,.doc,.docx",
          multiple: true,
          max_size: 5_242_880, # 5MB
          help_text: "Upload one or more PDF or Word documents up to 5 MB each.",
          preview: false
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>


  <!-- Checkbox -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Checkbox", anchor_link: true, subtitle: "Examples for Checkbox.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Single checkbox component with label</p>
    
    <div class="space-y-4">
      <%= render FlatPack::Checkbox::Component.new(
        name: "terms",
        label: "I agree to the terms and conditions",
        help_text: "Required before you can continue.",
        required: true
      ) %>

      <%= render FlatPack::Checkbox::Component.new(
        name: "newsletter",
        label: "Subscribe to newsletter",
        help_text: "You can unsubscribe from emails later.",
        checked: true
      ) %>

      <%= render FlatPack::Checkbox::Component.new(
        name: "terms_error",
        label: "I agree to the terms",
        error: "You must agree to continue",
        help_text: "Confirm the terms before submitting.",
        required: true,
        data: {
          flat_pack_message_required: "You must agree to continue"
        }
      ) %>

      <%= render FlatPack::Checkbox::Component.new(
        name: "disabled_checkbox",
        label: "This checkbox is disabled",
        help_text: "Disabled options cannot be changed here.",
        disabled: true
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::Checkbox::Component.new(
          name: "terms",
          label: "I agree to the terms and conditions",
          help_text: "Required before you can continue.",
          required: true
        ) %&gt;
        
        &lt;%= render FlatPack::Checkbox::Component.new(
          name: "newsletter",
          label: "Subscribe to newsletter",
          help_text: "You can unsubscribe from emails later.",
          checked: true
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Radio Group -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Radio Group", anchor_link: true, subtitle: "Examples for Radio Group.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Radio button group for single selection</p>
    
    <div class="space-y-6">
      <%= render FlatPack::RadioGroup::Component.new(
        name: "size",
        options: ["Small", "Medium", "Large"],
        label: "Choose a size",
        help_text: "Select the size that best fits the current order.",
        value: "Medium"
      ) %>

      <%= render FlatPack::RadioGroup::Component.new(
        name: "color",
        options: [["Red", "red"], ["Blue", "blue"], ["Green", "green"]],
        label: "Choose a color",
        help_text: "Pick one color for this item.",
        required: true
      ) %>

      <%= render FlatPack::RadioGroup::Component.new(
        name: "plan",
        options: [
          {label: "Free Plan", value: "free", disabled: false},
          {label: "Pro Plan", value: "pro", disabled: false},
          {label: "Enterprise (Coming Soon)", value: "enterprise", disabled: true}
        ],
        label: "Select a plan",
        help_text: "Disabled plans show options that are not available yet.",
        value: "pro"
      ) %>

      <%= render FlatPack::RadioGroup::Component.new(
        name: "payment_error",
        options: ["Credit Card", "PayPal", "Bank Transfer"],
        label: "Payment Method",
        error: "Please select a payment method",
        help_text: "Choose the payment method to use at checkout.",
        required: true,
        data: {
          flat_pack_message_required: "Please select a payment method"
        }
      ) %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::RadioGroup::Component.new(
          name: "size",
          options: ["Small", "Medium", "Large"],
          label: "Choose a size",
          help_text: "Select the size that best fits the current order.",
          value: "Medium"
        ) %&gt;
        
        &lt;%= render FlatPack::RadioGroup::Component.new(
          name: "color",
          options: [["Red", "red"], ["Blue", "blue"], ["Green", "green"]],
          label: "Choose a color",
          help_text: "Pick one color for this item."
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Select (Dropdown) -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Select (Dropdown)", anchor_link: true, subtitle: "Examples for Select (Dropdown).") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Dropdown select with optional search functionality</p>
    
    <div class="space-y-6">
      <div>
        <h3 class="text-lg font-medium mb-2 text-[var(--surface-content-color)]">Native Select</h3>
        <%= render FlatPack::Select::Component.new(
          name: "country",
          options: ["United States", "Canada", "United Kingdom", "Australia"],
          label: "Country",
          placeholder: "Select a country",
          help_text: "Choose the country used for billing and tax rules.",
          required: true
        ) %>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-2 text-[var(--surface-content-color)]">Select with Value/Label Pairs</h3>
        <%= render FlatPack::Select::Component.new(
          name: "state",
          options: [["California", "CA"], ["New York", "NY"], ["Texas", "TX"], ["Florida", "FL"]],
          label: "State",
          help_text: "Stored values can differ from visible option labels.",
          value: "CA"
        ) %>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-2 text-[var(--surface-content-color)]">Searchable Select</h3>
        <%= render FlatPack::Select::Component.new(
          name: "city",
          options: [
            "New York", "Los Angeles", "Chicago", "Houston", "Phoenix",
            "Philadelphia", "San Antonio", "San Diego", "Dallas", "San Jose",
            "Austin", "Jacksonville", "Fort Worth", "Columbus", "Indianapolis"
          ],
          label: "City",
          placeholder: "Search cities...",
          help_text: "Type to filter long option lists.",
          searchable: true,
          required: true
        ) %>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-2 text-[var(--surface-content-color)]">Select with Disabled Options</h3>
        <%= render FlatPack::Select::Component.new(
          name: "plan",
          options: [
            {label: "Free Plan", value: "free", disabled: false},
            {label: "Pro Plan", value: "pro", disabled: false},
            {label: "Enterprise (Coming Soon)", value: "enterprise", disabled: true}
          ],
          label: "Select a plan",
          help_text: "Unavailable plans can stay visible as disabled options.",
          value: "pro"
        ) %>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-2 text-[var(--surface-content-color)]">Select with Error</h3>
        <%= render FlatPack::Select::Component.new(
          name: "category",
          options: ["Electronics", "Clothing", "Books", "Food"],
          label: "Category",
          error: "Please select a category",
          help_text: "A category is required before publishing.",
          required: true,
          data: {
            flat_pack_message_required: "Please select a category"
          }
        ) %>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-2 text-[var(--surface-content-color)]">Disabled Select</h3>
        <%= render FlatPack::Select::Component.new(
          name: "disabled_select",
          options: ["Option 1", "Option 2"],
          label: "Disabled Select",
          value: "Option 1",
          help_text: "Disabled selects preserve the existing value.",
          disabled: true
        ) %>
      </div>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        &lt;%= render FlatPack::Select::Component.new(
          name: "country",
          options: ["United States", "Canada", "United Kingdom"],
          label: "Country",
          placeholder: "Select a country",
          help_text: "Choose the country used for billing and tax rules."
        ) %&gt;
        
        &lt;%= render FlatPack::Select::Component.new(
          name: "city",
          options: ["New York", "Los Angeles", "Chicago"],
          label: "City",
          help_text: "Type to filter long option lists.",
          searchable: true
        ) %&gt;
      CODE
      class: "mt-4"
    ) %>
  </section>

  <!-- Switch Component -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Switch Component", anchor_link: true, subtitle: "Examples for Switch Component.") %>
    <p class="mb-4">Modern toggle switches for boolean on/off states.</p>

    <div class="space-y-6 mb-4">
      <div>
        <h3 class="text-lg font-medium mb-3">Basic Switches</h3>
        <div class="space-y-3">
          <%= render FlatPack::Switch::Component.new(
            name: "switch_1",
            label: "Enable feature",
            help_text: "Turn this on to expose the feature to the current workspace."
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_2",
            label: "Auto-save",
            help_text: "Auto-save keeps changes without a manual submit.",
            checked: true
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_3",
            label: "Disabled switch",
            help_text: "Disabled toggles show unavailable settings.",
            disabled: true
          ) %>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-3">Switch Sizes</h3>
        <div class="space-y-3">
          <%= render FlatPack::Switch::Component.new(
            name: "switch_sm",
            label: "Small switch",
            help_text: "Use small switches in dense setting lists.",
            size: :sm
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_md",
            label: "Medium switch (default)",
            help_text: "Medium is the default switch size.",
            size: :md
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_lg",
            label: "Large switch",
            help_text: "Large switches suit roomy form layouts.",
            size: :lg
          ) %>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-3">Switch States</h3>
        <div class="space-y-3">
          <%= render FlatPack::Switch::Component.new(
            name: "switch_off",
            label: "Unchecked (OFF)",
            help_text: "Unchecked switches submit the off state."
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_on",
            label: "Checked (ON)",
            help_text: "Checked switches show the enabled state.",
            checked: true
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_disabled",
            label: "Disabled (OFF)",
            help_text: "Disabled off switches cannot be changed.",
            disabled: true
          ) %>
          <%= render FlatPack::Switch::Component.new(
            name: "switch_disabled_on",
            label: "Disabled (ON)",
            checked: true,
            help_text: "Disabled on switches keep their saved value.",
            disabled: true
          ) %>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-3">Switch with Error</h3>
        <%= render FlatPack::Switch::Component.new(
          name: "switch_error",
          label: "Terms and conditions",
          error: "You must accept the terms and conditions",
          help_text: "Acceptance is required before continuing.",
          required: true
        ) %>
      </div>

      <div>
        <h3 class="text-lg font-medium mb-3">Settings Panel Example</h3>
        <div class="border border-[var(--surface-border-color)] rounded-md p-4 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-medium">Email Notifications</h4>
              <p class="text-sm text-[var(--surface-muted-content-color)]">Receive email updates</p>
            </div>
            <%= render FlatPack::Switch::Component.new(
              name: "email_notifications",
              help_text: "Send product and account updates by email.",
              checked: true
            ) %>
          </div>
          
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-medium">SMS Notifications</h4>
              <p class="text-sm text-[var(--surface-muted-content-color)]">Receive text messages</p>
            </div>
            <%= render FlatPack::Switch::Component.new(
              name: "sms_notifications",
              help_text: "Send time-sensitive alerts by text message."
            ) %>
          </div>
          
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-medium">Dark Mode</h4>
              <p class="text-sm text-[var(--surface-muted-content-color)]">Use dark theme</p>
            </div>
            <%= render FlatPack::Switch::Component.new(
              name: "dark_mode",
              help_text: "Use the dark interface theme by default.",
              checked: true
            ) %>
          </div>
          
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-medium">Public Profile</h4>
              <p class="text-sm text-[var(--surface-muted-content-color)]">Make profile visible to others</p>
            </div>
            <%= render FlatPack::Switch::Component.new(
              name: "public_profile",
              help_text: "Allow other users to view this profile."
            ) %>
          </div>
        </div>
      </div>
    </div>

    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Switch::Component.new(
          name: "notifications",
          label: "Enable notifications",
          help_text: "Turn this on to expose the feature to the current workspace.",
          checked: true
        ) %&gt;
        
        &lt;%= render FlatPack::Switch::Component.new(
          name: "dark_mode",
          label: "Dark mode",
          help_text: "Use the dark interface theme by default.",
          size: :lg
        ) %&gt;
        
        &lt;%= render FlatPack::Switch::Component.new(
          name: "terms",
          label: "I agree to the terms",
          required: true,
          help_text: "Acceptance is required before continuing.",
          error: "You must accept the terms"
        ) %&gt;
      CODE
    ) %>
  </section>

  <!-- Combined Form Example -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Complete Form Example", anchor_link: true, subtitle: "Examples for Complete Form Example.") %>
    <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">All input components in a single form</p>
    
    <form class="space-y-4 p-6 border border-[var(--surface-border-color)] rounded-[var(--radius-lg)] bg-[var(--surface-muted-background-color)]">
      <%= render FlatPack::TextInput::Component.new(
        name: "full_name",
        label: "Full Name",
        placeholder: "John Doe",
        help_text: "Use the name that should appear on account records.",
        required: true
      ) %>

      <%= render FlatPack::EmailInput::Component.new(
        name: "contact_email",
        label: "Email",
        placeholder: "john@example.com",
        help_text: "Use the email address for account notifications.",
        required: true
      ) %>

      <%= render FlatPack::PhoneInput::Component.new(
        name: "contact_phone",
        label: "Phone Number",
        placeholder: "+1 (555) 123-4567",
        help_text: "Include a country code when applicable."
      ) %>

      <%= render FlatPack::DateInput::Component.new(
        name: "birth_date",
        label: "Birth Date",
        help_text: "Must be today or earlier.",
        max: Date.today.to_s
      ) %>

      <%= render FlatPack::NumberInput::Component.new(
        name: "age",
        label: "Age",
        min: 18,
        max: 120,
        step: 1,
        placeholder: "Enter your age",
        help_text: "Enter a whole number from 18 to 120."
      ) %>

      <%= render FlatPack::PasswordInput::Component.new(
        name: "account_password",
        label: "Password",
        placeholder: "Enter a secure password",
        help_text: "Use at least 12 characters.",
        required: true
      ) %>

      <%= render FlatPack::UrlInput::Component.new(
        name: "portfolio",
        label: "Portfolio URL",
        placeholder: "https://yourportfolio.com",
        help_text: "Use a public portfolio or profile URL."
      ) %>

      <%= render FlatPack::FileInput::Component.new(
        name: "profile_picture",
        label: "Profile Picture",
        accept: "image/png,image/jpeg",
        max_size: 2_097_152,
        help_text: "Upload a PNG or JPEG image up to 2 MB.",
        preview: true
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "country",
        options: [["United States", "us"], ["Canada", "ca"], ["United Kingdom", "uk"], ["Australia", "au"]],
        label: "Country",
        placeholder: "Select your country",
        help_text: "Choose the country used for billing details.",
        required: true
      ) %>

      <%= render FlatPack::RadioGroup::Component.new(
        name: "notification_preference",
        options: ["Email", "SMS", "Push Notifications"],
        label: "Notification Preference",
        help_text: "Pick the primary channel for account updates.",
        value: "Email"
      ) %>

      <%= render FlatPack::Checkbox::Component.new(
        name: "agree_terms",
        label: "I agree to the terms and conditions",
        help_text: "Required before submitting the form.",
        required: true
      ) %>

      <%= render FlatPack::Checkbox::Component.new(
        name: "subscribe_newsletter",
        label: "Subscribe to our newsletter",
        help_text: "Newsletter subscriptions can be changed later."
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "bio",
        label: "Biography",
        placeholder: "Tell us about yourself...",
        help_text: "Keep the summary short and plain text.",
        rows: 4
      ) %>

      <div class="pt-4">
        <%= render FlatPack::Button::Component.new(
          text: "Submit Form",
          style: :primary,
          size: :md
        ) %>
      </div>
    </form>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE'),
        <form class="space-y-4">
          &lt;%= render FlatPack::TextInput::Component.new(
            name: "full_name",
            label: "Full Name",
            placeholder: "John Doe",
            help_text: "Use the name that should appear on account records.",
            required: true
          ) %&gt;
        
          &lt;%= render FlatPack::EmailInput::Component.new(
            name: "contact_email",
            label: "Email",
            placeholder: "john@example.com",
            help_text: "Use the email address for account notifications.",
            required: true
          ) %&gt;
        
          &lt;%= render FlatPack::DateInput::Component.new(
            name: "birth_date",
            label: "Birth Date",
            help_text: "Must be today or earlier.",
            max: Date.today.to_s
          ) %&gt;
        
          &lt;%= render FlatPack::NumberInput::Component.new(
            name: "age",
            label: "Age",
            min: 18,
            max: 120,
            help_text: "Enter a whole number from 18 to 120."
          ) %&gt;
        
          &lt;%= render FlatPack::FileInput::Component.new(
            name: "profile_picture",
            label: "Profile Picture",
            accept: "image/png,image/jpeg",
            max_size: 2_097_152,
            help_text: "Upload a PNG or JPEG image up to 2 MB."
          ) %&gt;
        
          &lt;%= render FlatPack::Select::Component.new(
            name: "country",
            options: [["United States", "us"], ["Canada", "ca"]],
            label: "Country",
            help_text: "Choose the country used for billing details."
          ) %&gt;
        
          &lt;%= render FlatPack::RadioGroup::Component.new(
            name: "notification_preference",
            options: ["Email", "SMS"],
            label: "Notification Preference",
            help_text: "Pick the primary channel for account updates."
          ) %&gt;
        
          &lt;%= render FlatPack::Checkbox::Component.new(
            name: "agree_terms",
            label: "I agree to the terms",
            help_text: "Required before submitting the form."
          ) %&gt;
        
          &lt;%= render FlatPack::TextArea::Component.new(
            name: "bio",
            label: "Biography",
            help_text: "Keep the summary short and plain text.",
            rows: 4
          ) %&gt;
        
          &lt;%= render FlatPack::Button::Component.new(
            text: "Submit Form",
            style: :primary
          ) %&gt;
        </form>
      CODE
      class: "mt-4"
    ) %>
  </section>

