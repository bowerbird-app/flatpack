    <div class="space-y-2 text-center">
      <%= render FlatPack::Notification::Component.new(
        unread_count: 0,
        see_all_href: demo_notification_path,
        notifications: []
      ) %>
      <p class="text-xs text-[var(--surface-muted-content-color)]">No unread</p>
    </div>

    <div class="space-y-2 text-center">
      <%= render FlatPack::Notification::Component.new(
        unread_count: 1,
        see_all_href: demo_notification_path,
        notifications: demo_notifications.first(1)
      ) %>
      <p class="text-xs text-[var(--surface-muted-content-color)]">One unread</p>
    </div>

    <div class="space-y-2 text-center">
      <%= render FlatPack::Notification::Component.new(
        unread_count: 9,
        see_all_href: demo_notification_path,
        notifications: demo_notifications
      ) %>
      <p class="text-xs text-[var(--surface-muted-content-color)]">Nine unread</p>
    </div>

    <div class="space-y-2 text-center">
