<%= render FlatPack::PageTitle::Component.new(
  title: "Sidebar Layout",
  subtitle: "Layout shell examples for placing the sidebar on the left or right."
) %>

<%= render "pages/component_method_variables_table", component: :sidebar_layout %>

<% sidebar_side = params[:side].in?(%w[left right]) ? params[:side] : "left" %>
<% background_on = params[:background].in?(%w[1 true]) %>
<% background_query = request.query_parameters.except("background") %>
<% background_query = background_query.merge("background" => "1", "floating" => "1") unless background_on %>
<% top_nav_floating = params[:floating_top_nav].in?(%w[1 true]) %>
<% content_below = params[:content_scroll] == "below" %>
<% float_top_query = request.query_parameters.merge("floating" => "1", "background" => "1", "floating_top_nav" => "1").except("content_scroll") %>
<% dock_top_query = request.query_parameters.except("floating_top_nav", "content_scroll") %>
<% scroll_query = float_top_query.merge("content_scroll" => content_below ? "behind" : "below") %>
<% content_height = params[:height] == "content" %>
<% fit_rail_query = request.query_parameters.merge("floating" => "1", "background" => "1", "height" => "content") %>
<% fill_rail_query = request.query_parameters.except("height") %>
<% content_width = params[:width] == "content" %>
<% fit_width_query = request.query_parameters.merge("width" => "content") %>
<% fixed_width_query = request.query_parameters.except("width") %>

<div class="mb-8 flex flex-wrap items-center gap-3">
  <%= link_to(
    "Sidebar: #{sidebar_side == "right" ? "Right" : "Left"}",
    demo_sidebar_layout_path(request.query_parameters.merge(side: sidebar_side == "right" ? "left" : "right")),
    class: "inline-flex text-sm px-3 py-1.5 rounded-lg bg-primary text-white hover:opacity-90 transition-opacity"
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: background_on ? "Hide photo" : "Photo background",
    href: demo_sidebar_layout_path(background_query),
    style: :secondary,
    size: :sm
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: top_nav_floating ? "Dock the top" : "Float the top",
    href: demo_sidebar_layout_path(top_nav_floating ? dock_top_query : float_top_query),
    style: :secondary,
    size: :sm
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: content_height ? "Fill the rail" : "Fit the rail",
    href: demo_sidebar_layout_path(content_height ? fill_rail_query : fit_rail_query),
    style: :secondary,
    size: :sm
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: content_width ? "Fixed width" : "Fit the labels",
    href: demo_sidebar_layout_path(content_width ? fixed_width_query : fit_width_query),
    style: :secondary,
    size: :sm
  ) %>
  <% if top_nav_floating %>
    <%= render FlatPack::Button::Component.new(
      text: content_below ? "Scroll under" : "Start below",
      href: demo_sidebar_layout_path(scroll_query),
      style: :ghost,
      size: :sm
    ) %>
  <% end %>
</div>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Layout Positioning",
    anchor_link: true,
    subtitle: "Use side: :left or side: :right on SidebarLayout for shell positioning."
  ) %>
  <p class="text-sm text-(--surface-muted-content-color) mb-4">
    This page focuses only on the layout shell. The detailed sidebar component demos now live under the Sidebar menu group.
    This page starts with the detached rail. Pass <code>?floating=0</code> for the flush rail.
    Photo background uses <code>?background=1</code>.
    <code>?floating_top_nav=1</code> turns the bar into cards. <code>content_scroll=below</code> parks those cards above the page.
    <code>?height=content</code> with <code>?floating=1</code> sizes the desktop rail to its items.
    <code>?width=content</code> sizes the open desktop rail to its widest item.
  </p>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::SidebarLayout::Component.new(side: :right) do |layout| %&gt;
        &lt;% layout.sidebar do %&gt;
          &lt;%= render FlatPack::Sidebar::Component.new(side: :right) do |sidebar| %&gt;
            &lt;%# sidebar content %&gt;
          &lt;% end %&gt;
        &lt;% end %&gt;

        &lt;% layout.top_nav do %&gt;
          &lt;%= render FlatPack::TopNav::Component.new %&gt;
        &lt;% end %&gt;

        &lt;% layout.main do %&gt;
          &lt;main&gt;...&lt;/main&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="scroll-sample">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Scroll the page",
    anchor_link: true,
    subtitle: "The rail and the top nav stay put. This copy is long so you can see the page move under the cards."
  ) %>
  <% 12.times do |index| %>
    <p class="mb-8 text-sm leading-6 text-[var(--surface-content-color)]">
      Block <%= index + 1 %>. The shell keeps the viewport. Only this column scrolls.
      A floating top nav sits on the photo, and the first lines start below the cards.
      Keep going. The cards should still be on screen when you reach the end.
    </p>
  <% end %>
  <p class="text-sm font-medium" id="scroll-end">You reached the end.</p>
</section>
