<%= render FlatPack::PageTitle::Component.new(
  title: "Section Title",
  subtitle: "In-page headings. The default is today's look. Smaller sizes fit inside cards."
) %>

<%= render "pages/component_method_variables_table", component: :section_title %>

<%
  erb_output_open = "<" + "%="
  erb_tag_close = "%" + ">"
%>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Default", anchor_link: true, subtitle: "size: :lg, spacing: :lg, level: :h2 — same markup as every demo page heading.") %>

  <div class="rounded-lg border border-dashed border-[var(--surface-border-color)] px-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Workspace overview",
      subtitle: "Latest metrics and progress for this project."
    ) %>
    <p class="text-sm text-[var(--surface-muted-content-color)] pb-4">Page content sits under the title. The wrapper still uses my-8 (32px above and below).</p>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    class: "mt-4",
    code: <<~CODE
      #{erb_output_open} render FlatPack::SectionTitle::Component.new(
        title: "Workspace overview",
        subtitle: "Latest metrics and progress for this project."
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Sizes", anchor_link: true, subtitle: "Type scale for the heading, subtitle, and copy-link icon. These cards use spacing: :none so the type is the only change.") %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-2">size: :lg (default)</p>
      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Members",
            subtitle: "Who can access this workspace",
            size: :lg,
            spacing: :none
          ) %>
          <%= render "pages/section_title_members" %>
        <% end %>
      <% end %>
    </div>

    <div>
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-2">size: :md</p>
      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Members",
            subtitle: "Who can access this workspace",
            size: :md,
            spacing: :none
          ) %>
          <%= render "pages/section_title_members" %>
        <% end %>
      <% end %>
    </div>

    <div>
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-2">size: :sm</p>
      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Members",
            subtitle: "Who can access this workspace",
            size: :sm,
            spacing: :none
          ) %>
          <%= render "pages/section_title_members" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <p class="mt-3 text-sm text-[var(--surface-muted-content-color)]">:lg is the default. :md and :sm are for headings that sit with other content, not as the page section label.</p>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    class: "mt-4",
    code: <<~CODE
      #{erb_output_open} render FlatPack::SectionTitle::Component.new(
        title: "Members",
        subtitle: "Who can access this workspace",
        size: :md
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Spacing", anchor_link: true, subtitle: "Vertical margin on the wrapper. :none drops my-* so a caller class can set the gap.") %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% [
      [:lg, "Default. Same my-8 used on demo pages."],
      [:md, "A bit tighter. Handy between stacked blocks."],
      [:sm, "Compact. Use in dense settings screens."],
      [:none, "No wrapper margin. Pair with class: or the parent gap."]
    ].each do |spacing, note| %>
      <div class="rounded-lg border border-dashed border-[var(--surface-border-color)] px-4">
        <%= render FlatPack::SectionTitle::Component.new(
          title: "spacing: :#{spacing}",
          subtitle: note,
          size: :md,
          spacing: spacing
        ) %>
        <p class="text-sm text-[var(--surface-muted-content-color)] pb-4">Content under the title.</p>
      </div>
    <% end %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    class: "mt-4",
    code: <<~CODE
      #{erb_output_open} render FlatPack::SectionTitle::Component.new(
        title: "Members",
        size: :md,
        spacing: :none,
        class: "mb-3"
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Inside a card", anchor_link: true, subtitle: "The reason for size and spacing. Default my-8 is too much in a padded card body.") %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl">
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Members",
          subtitle: "Default size and spacing"
        ) %>
        <%= render "pages/section_title_members" %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Members",
          subtitle: "Who can access this workspace",
          size: :md,
          spacing: :none
        ) %>
        <%= render "pages/section_title_members" %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    class: "mt-4",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Card::Component.new do |card| %&gt;
        &lt;% card.body do %&gt;
          &lt;%= render FlatPack::SectionTitle::Component.new(
            title: "Members",
            subtitle: "Who can access this workspace",
            size: :md,
            spacing: :none
          ) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Heading level", anchor_link: true, subtitle: "level: changes the tag. size: still owns the type scale.") %>

  <%= render FlatPack::Card::Component.new(class: "max-w-xl") do |card| %>
    <% card.body do %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Billing contact",
        subtitle: "Who receives invoices",
        size: :md,
        spacing: :none,
        level: :h3
      ) %>
      <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
        <%= render FlatPack::List::Item.new(trailing: "accounts@example.com", class: "px-0") do %>Email<% end %>
        <%= render FlatPack::List::Item.new(trailing: "+61 7 5555 0100", class: "px-0") do %>Phone<% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    class: "mt-4",
    code: <<~CODE
      #{erb_output_open} render FlatPack::SectionTitle::Component.new(
        title: "Billing contact",
        subtitle: "Who receives invoices",
        size: :md,
        spacing: :none,
        level: :h3
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Copy link", anchor_link: true, subtitle: "Hover the heading to copy a deep link. The icon scales with size.") %>

  <div class="max-w-xl">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Usage limits",
      subtitle: "Hover to copy a link to this heading.",
      size: :md,
      spacing: :sm,
      anchor_link: true
    ) %>
  </div>
</section>
