<%= render FlatPack::PageTitle::Component.new(
  title: "Basic Table Demos",
  subtitle: "Foundational table patterns: basic columns and formatted cell rendering."
) %>

<%= render "pages/component_method_variables_table", component: :table %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Basic Table", anchor_link: true, subtitle: "Simple rows and columns.") %>
  <%= render FlatPack::Table::Component.new(data: @users.first(5), turbo_frame: "basic_table") do |table| %>
    <% table.column(title: "ID", html: ->(user) { user.id.to_s }) %>
    <% table.column(title: "Name", html: ->(user) { user.name }) %>
    <% table.column(title: "Email", html: ->(user) { user.email }) %>
    <% table.column(title: "Category", html: ->(user) { user.category.to_s.titleize }) %>
    <% table.column(title: "Actions", html: ->(user) {
      dropdown = FlatPack::Button::Dropdown::Component.new(text: "Actions", style: :ghost)
      dropdown.menu_item(text: "View #{user.name}", icon: "eye", href: "#")
      dropdown.menu_item(text: "Edit #{user.name}", icon: "pencil", href: "#")
      dropdown.menu_divider
      dropdown.menu_item(text: "Delete", icon: "trash", destructive: true, href: "#")
      render dropdown
    }) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Table::Component.new(data: @users.first(5), turbo_frame: &quot;basic_table&quot;) do |table| %&gt;
        &lt;% table.column(title: &quot;ID&quot;, html: -&gt;(user) { user.id.to_s }) %&gt;
        &lt;% table.column(title: &quot;Name&quot;, html: -&gt;(user) { user.name }) %&gt;
        &lt;% table.column(title: &quot;Email&quot;, html: -&gt;(user) { user.email }) %&gt;
        &lt;% table.column(title: &quot;Category&quot;, html: -&gt;(user) { user.category.to_s.titleize }) %&gt;
        &lt;% table.column(title: &quot;Actions&quot;, html: -&gt;(user) {
          dropdown = FlatPack::Button::Dropdown::Component.new(text: &quot;Actions&quot;, style: :ghost)
          dropdown.menu_item(text: &quot;View #{user.name}&quot;, icon: &quot;eye&quot;, href: &quot;#&quot;)
          dropdown.menu_item(text: &quot;Edit #{user.name}&quot;, icon: &quot;pencil&quot;, href: &quot;#&quot;)
          dropdown.menu_divider
          dropdown.menu_item(text: &quot;Delete&quot;, icon: &quot;trash&quot;, destructive: true, href: &quot;#&quot;)
          render dropdown
        }) %&gt;
      &lt;% end %&gt;
    CODE
    language: "erb",
    title: "Basic Table"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Table with Generic Filter Controls",
    anchor_link: true,
    subtitle: "Use the same sibling control-surface pattern as charts for table filtering and search."
  ) %>

  <p class="text-(--surface-muted-content-color) mb-4">
    This demo keeps filter and search state in URL params and refreshes the table via Turbo Frames.
  </p>

  <%= turbo_frame_tag "basic-table-generic-filter-frame" do %>
    <%= form_with(
      url: demo_tables_basic_path,
      method: :get,
      class: "hidden md:flex mb-4 flex-wrap items-end gap-3",
      data: {
        turbo_frame: "basic-table-generic-filter-frame",
        controller: "flat-pack--auto-submit",
        action: "input->flat-pack--auto-submit#queueSubmit change->flat-pack--auto-submit#queueSubmit",
        flat_pack__auto_submit_delay_value: 300
      }
    ) do %>
      <%= render FlatPack::Select::Component.new(
        name: "status",
        value: @table_filter_status,
        options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
        label: "Status"
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "category",
        value: @table_filter_category,
        options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
        label: "Category"
      ) %>

      <%= render FlatPack::Search::Component.new(
        name: "q",
        value: @table_search_query,
        placeholder: "Search table rows...",
        max_width: :none,
        class: "w-56"
      ) %>
    <% end %>

    <div class="mb-4 md:hidden">
      <%= render FlatPack::ModalFilter::Component.new(
        id: "basic-table-generic-filters",
        form_url: demo_tables_basic_path,
        turbo_frame: "basic-table-generic-filter-frame",
        active_count: @table_filter_active_count,
        reset_url: demo_tables_basic_path,
        mobile_form_class: "space-y-3"
      ) do |modal_filter| %>
        <% modal_filter.filter_body do %>
          <div class="grid gap-3">
            <%= render FlatPack::Select::Component.new(
              name: "status",
              value: @table_filter_status,
              options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
              label: "Status"
            ) %>

            <%= render FlatPack::Select::Component.new(
              name: "category",
              value: @table_filter_category,
              options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
              label: "Category"
            ) %>

            <%= render FlatPack::Search::Component.new(
              name: "q",
              value: @table_search_query,
              placeholder: "Search table rows...",
              max_width: :none,
              class: "w-full"
            ) %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render FlatPack::Table::Component.new(data: @table_filtered_users.first(10)) do |table| %>
      <% table.column(title: "ID", html: ->(user) { user.id.to_s }) %>
      <% table.column(title: "Name", html: ->(user) { user.name }) %>
      <% table.column(title: "Email", html: ->(user) { user.email }) %>
      <% table.column(title: "Category", html: ->(user) { user.category.to_s.titleize }) %>
      <% table.column(title: "Status", html: ->(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= turbo_frame_tag "basic-table-generic-filter-frame" do %&gt;
        &lt;%= form_with(
          url: demo_tables_basic_path,
          method: :get,
          class: "hidden md:flex mb-4 flex-wrap items-end gap-3",
          data: {
            turbo_frame: "basic-table-generic-filter-frame",
            controller: "flat-pack--auto-submit",
            action: "input-&gt;flat-pack--auto-submit#queueSubmit change-&gt;flat-pack--auto-submit#queueSubmit",
            flat_pack__auto_submit_delay_value: 300
          }
        ) do %&gt;
          &lt;%= render FlatPack::Select::Component.new(
            name: "status",
            value: @table_filter_status,
            options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
            label: "Status"
          ) %&gt;
          &lt;%= render FlatPack::Select::Component.new(
            name: "category",
            value: @table_filter_category,
            options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
            label: "Category"
          ) %&gt;
          &lt;%= render FlatPack::Search::Component.new(
            name: "q",
            value: @table_search_query,
            placeholder: "Search table rows...",
            max_width: :none,
            class: "w-56"
          ) %&gt;
        &lt;% end %&gt;

        &lt;%= render FlatPack::ModalFilter::Component.new(
          id: "basic-table-generic-filters",
          form_url: demo_tables_basic_path,
          turbo_frame: "basic-table-generic-filter-frame",
          active_count: @table_filter_active_count,
          reset_url: demo_tables_basic_path,
          mobile_form_class: "space-y-3"
        ) do |modal_filter| %&gt;
          &lt;% modal_filter.filter_body do %&gt;
            &lt;div class="grid gap-3"&gt;
            &lt;%= render FlatPack::Select::Component.new(
              name: "status",
              value: @table_filter_status,
              options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
              label: "Status"
            ) %&gt;

            &lt;%= render FlatPack::Select::Component.new(
              name: "category",
              value: @table_filter_category,
              options: @table_filter_definitions.fetch("category").fetch(:values).map { |value_key, value_label| [value_label, value_key] },
              label: "Category"
            ) %&gt;

            &lt;%= render FlatPack::Search::Component.new(
              name: "q",
              value: @table_search_query,
              placeholder: "Search table rows...",
              max_width: :none,
              class: "w-full"
            ) %&gt;
            &lt;/div&gt;
          &lt;% end %&gt;
        &lt;% end %&gt;

        &lt;%= render FlatPack::Table::Component.new(data: @table_filtered_users.first(10)) do |table| %&gt;
          &lt;% table.column(title: "ID", html: -&gt;(user) { user.id.to_s }) %&gt;
          &lt;% table.column(title: "Name", html: -&gt;(user) { user.name }) %&gt;
          &lt;% table.column(title: "Email", html: -&gt;(user) { user.email }) %&gt;
          &lt;% table.column(title: "Category", html: -&gt;(user) { user.category.to_s.titleize }) %&gt;
          &lt;% table.column(title: "Status", html: -&gt;(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    language: "erb",
    title: "Table with Generic Filter Controls"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Single Outer Frame with Multiple Table Controls",
    anchor_link: true,
    subtitle: "One outer frame contains multiple control groups, each targeting its own inner table frame."
  ) %>

  <p class="text-(--surface-muted-content-color) mb-4">
    Search applies to both tables, while each filter group independently targets table 1 or table 2.
  </p>

  <%= turbo_frame_tag "basic-table-multi-frame" do %>
    <div class="space-y-4">
      <%= render FlatPack::ChartButtons::Component.new(
        turbo_frame: "basic-table-multi-frame",
        margin_bottom: nil
      ) do |controls| %>
        <% controls.control do %>
          <%= form_with(
            url: demo_tables_basic_path,
            method: :get,
            class: "inline-flex items-center",
            data: {
              turbo_frame: "basic-table-multi-frame",
              controller: "flat-pack--auto-submit",
              action: "input->flat-pack--auto-submit#queueSubmit",
              flat_pack__auto_submit_delay_value: 300
            }
          ) do %>
            <%= hidden_field_tag :table_1_category, @table_multi_category_value %>
            <%= hidden_field_tag :table_2_status, @table_multi_status_value %>
            <%= render FlatPack::Search::Component.new(
              name: "table_multi_q",
              value: @table_multi_search_query,
              placeholder: "Search both tables...",
              max_width: :none,
              class: "w-56"
            ) %>
          <% end %>
        <% end %>

        <% controls.button(
          text: "Table 1 All",
          href: demo_tables_basic_path(table_1_category: "all", table_2_status: @table_multi_status_value, table_multi_q: @table_multi_search_query),
          selected: @table_multi_category_value == "all"
        ) %>
        <% controls.button(
          text: "Table 1 Technology",
          href: demo_tables_basic_path(table_1_category: "technology", table_2_status: @table_multi_status_value, table_multi_q: @table_multi_search_query),
          selected: @table_multi_category_value == "technology"
        ) %>
        <% controls.button(
          text: "Table 1 Business",
          href: demo_tables_basic_path(table_1_category: "business", table_2_status: @table_multi_status_value, table_multi_q: @table_multi_search_query),
          selected: @table_multi_category_value == "business"
        ) %>

        <% controls.dropdown(
          text: "Table 2 Status",
          options: @table_filter_definitions.fetch("status").fetch(:values).map { |value_key, value_label|
            {
              text: value_label,
              url: demo_tables_basic_path(table_1_category: @table_multi_category_value, table_2_status: value_key, table_multi_q: @table_multi_search_query),
              selected: @table_multi_status_value == value_key
            }
          }
        ) %>
      <% end %>

      <%= turbo_frame_tag "basic-table-1-panel", class: "block mb-4" do %>
        <%= render FlatPack::Table::Component.new(data: @table_multi_table_1_users.first(8)) do |table| %>
          <% table.column(title: "ID", html: ->(user) { user.id.to_s }) %>
          <% table.column(title: "Name", html: ->(user) { user.name }) %>
          <% table.column(title: "Category", html: ->(user) { user.category.to_s.titleize }) %>
          <% table.column(title: "Email", html: ->(user) { user.email }) %>
        <% end %>
      <% end %>

      <%= turbo_frame_tag "basic-table-2-panel", class: "block mb-4" do %>
        <%= render FlatPack::Table::Component.new(data: @table_multi_table_2_users.first(8)) do |table| %>
          <% table.column(title: "ID", html: ->(user) { user.id.to_s }) %>
          <% table.column(title: "Name", html: ->(user) { user.name }) %>
          <% table.column(title: "Status", html: ->(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %>
          <% table.column(title: "Views", html: ->(user) { number_with_delimiter(user.views_count) }) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Formatted Columns", anchor_link: true, subtitle: "Use lambda renderers for custom output.") %>
  <%= render FlatPack::Table::Component.new(data: @users.first(5)) do |table| %>
    <% table.column(title: "Name", html: ->(user) { "<strong class=\"text-[var(--color-primary)]\">#{user.name}</strong>".html_safe }) %>
    <% table.column(title: "Status", html: ->(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %>
    <% table.column(title: "Published", html: ->(user) { user.published_at.strftime("%b %d, %Y") }) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Table::Component.new(data: @users.first(5)) do |table| %&gt;
        &lt;% table.column(title: &quot;Name&quot;, html: -&gt;(user) { &quot;&lt;strong class=\&quot;text-[var(--color-primary)]\&quot;&gt;#{user.name}&lt;/strong&gt;&quot;.html_safe }) %&gt;
        &lt;% table.column(title: &quot;Status&quot;, html: -&gt;(user) { render FlatPack::Badge::Component.new(text: user.status.capitalize, size: :sm) }) %&gt;
        &lt;% table.column(title: &quot;Published&quot;, html: -&gt;(user) { user.published_at.strftime(&quot;%b %d, %Y&quot;) }) %&gt;
      &lt;% end %&gt;
    CODE
    language: "erb",
    title: "Formatted Columns"
  ) %>
</section>

