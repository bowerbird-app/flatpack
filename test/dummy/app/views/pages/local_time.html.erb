<%= render FlatPack::PageTitle::Component.new(
  title: "Local Time Demo",
  subtitle: "Render UTC timestamps in local browser time with optional relative labels."
) %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Local Time",
    anchor_link: true,
    subtitle: "Converts UTC datetime values into local browser display text."
  ) %>

  <div class="space-y-4 rounded-lg border border-(--surface-border-color) bg-(--surface-background-color) p-4">
    <div class="text-sm text-(--surface-muted-content-color)">
      Current time in user locale:
      <time class="local-time font-medium text-(--surface-content-color)" datetime="<%= @now.utc.iso8601 %>">
        <%= @now.utc.strftime("%d %b %Y, %I:%M %P UTC") %>
      </time>
    </div>

    <div class="text-sm text-(--surface-muted-content-color)">
      Existing title should be preserved:
      <time
        class="local-time font-medium text-(--surface-content-color)"
        datetime="<%= @now.utc.iso8601 %>"
        title="Custom title should not be overwritten"
      >
        <%= @now.utc.strftime("%d %b %Y, %I:%M %P UTC") %>
      </time>
    </div>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;time class=&quot;local-time&quot; datetime=&quot;&lt;%= @now.utc.iso8601 %&gt;&quot;&gt;
        &lt;%= @now.utc.strftime(&quot;%d %b %Y, %I:%M %P UTC&quot;) %&gt;
      &lt;/time&gt;

      &lt;time
        class=&quot;local-time&quot;
        datetime=&quot;&lt;%= @now.utc.iso8601 %&gt;&quot;
        title=&quot;Custom title should not be overwritten&quot;
      &gt;
        &lt;%= @now.utc.strftime(&quot;%d %b %Y, %I:%M %P UTC&quot;) %&gt;
      &lt;/time&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Relative Time",
    anchor_link: true,
    subtitle: "Compare default and shortened local-time relative labels across common time distances."
  ) %>

  <%= render FlatPack::Table::Component.new(data: @relative_time_examples, class: "mb-4") do |table| %>
    <% table.column(title: "Example", html: ->(row) { row.first }) %>
    <% table.column(title: "Unshortened", html: ->(row) {
      timestamp = row.last
      tag.time(
        timestamp.utc.strftime("%d %b %Y, %I:%M %P UTC"),
        class: "local-time relative-time font-medium text-(--surface-content-color)",
        datetime: timestamp.utc.iso8601
      )
    }) %>
    <% table.column(title: "Shortened", html: ->(row) {
      timestamp = row.last
      tag.time(
        timestamp.utc.strftime("%d %b %Y, %I:%M %P UTC"),
        class: "local-time relative-time font-medium text-(--surface-content-color)",
        datetime: timestamp.utc.iso8601,
        data: {shorten_timestamp: true}
      )
    }) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Table::Component.new(data: @relative_time_examples) do |table| %&gt;
        &lt;% table.column(title: "Example", html: -&gt;(row) { row.first }) %&gt;
        &lt;% table.column(title: "Unshortened", html: -&gt;(row) {
          timestamp = row.last
          tag.time(
            timestamp.utc.strftime("%d %b %Y, %I:%M %P UTC"),
            class: "local-time relative-time",
            datetime: timestamp.utc.iso8601
          )
        }) %&gt;
        &lt;% table.column(title: "Shortened", html: -&gt;(row) {
          timestamp = row.last
          tag.time(
            timestamp.utc.strftime("%d %b %Y, %I:%M %P UTC"),
            class: "local-time relative-time",
            datetime: timestamp.utc.iso8601,
            data: {shorten_timestamp: true}
          )
        }) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Short Relative Time",
    anchor_link: true,
    subtitle: "Add data-shorten-timestamp for compact recency labels."
  ) %>

  <div class="rounded-lg border border-(--surface-border-color) bg-(--surface-background-color) p-4">
    <div class="text-sm text-(--surface-muted-content-color)">
      Shortened:
      <time
        class="local-time relative-time font-medium text-(--surface-content-color)"
        datetime="<%= 20.minutes.ago.utc.iso8601 %>"
        data-shorten-timestamp="true"
      >
        <%= 20.minutes.ago.utc.strftime("%d %b %Y, %I:%M %P UTC") %>
      </time>
    </div>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;time
        class=&quot;local-time relative-time&quot;
        datetime=&quot;&lt;%= 20.minutes.ago.utc.iso8601 %&gt;&quot;
        data-shorten-timestamp=&quot;true&quot;
      &gt;
        &lt;%= 20.minutes.ago.utc.strftime(&quot;%d %b %Y, %I:%M %P UTC&quot;) %&gt;
      &lt;/time&gt;
    CODE
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Invalid Or Missing Datetime",
    anchor_link: true,
    subtitle: "Fallback text remains unchanged when datetime is invalid or absent."
  ) %>

  <div class="space-y-4 rounded-lg border border-(--surface-border-color) bg-(--surface-background-color) p-4">
    <div class="text-sm text-(--surface-muted-content-color)">
      Invalid datetime:
      <time class="local-time font-medium text-(--surface-content-color)" datetime="not-a-valid-date">
        Fallback text should remain
      </time>
    </div>

    <div class="text-sm text-(--surface-muted-content-color)">
      Missing datetime:
      <time class="local-time font-medium text-(--surface-content-color)">
        Fallback text should remain
      </time>
    </div>
  </div>
</section>
