    <%= render FlatPack::Button::Dropdown::Component.new(text: "Small", style: :primary, size: :sm) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Medium", style: :primary, size: :md) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Large", style: :primary, size: :lg) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "Small", style: :primary, size: :sm) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Option 1", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Option 2", href: "#") %&gt;
