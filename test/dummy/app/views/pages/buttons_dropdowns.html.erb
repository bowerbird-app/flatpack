    <%= render FlatPack::Button::Dropdown::Component.new(text: "Small", style: :primary, size: :sm) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Medium", style: :primary, size: :md) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Large", style: :primary, size: :lg) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "Small", style: :primary, size: :sm) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Option 1", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Option 2", href: "#") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Button Dropdowns - Positions -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Dropdown Positions", anchor_link: true, subtitle: "Examples for Dropdown Positions.") %>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    Bottom positions (default):
  </p>
  <div class="flex gap-3 mb-8 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
    <%= render FlatPack::Button::Dropdown::Component.new(text: "Bottom Right", placement: :bottom_right) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
      <% dropdown.menu_item(text: "Option 3", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Bottom Left", placement: :bottom_left) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
      <% dropdown.menu_item(text: "Option 3", href: "#") %>
    <% end %>
  </div>

  <p class="text-[var(--surface-muted-content-color)] mb-4">
    Top positions (opens upward):
  </p>
  <div class="flex gap-3 mb-4 pt-32 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
    <%= render FlatPack::Button::Dropdown::Component.new(text: "Top Right", placement: :top_right) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
      <% dropdown.menu_item(text: "Option 3", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Top Left", placement: :top_left) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
      <% dropdown.menu_item(text: "Option 3", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "Bottom Right", placement: :bottom_right) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Option 1", href: "#") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Button Dropdowns - With Icons and Badges -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Dropdowns with Icons and Badges", anchor_link: true, subtitle: "Examples for Dropdowns with Icons and Badges.") %>
  <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
    <%= render FlatPack::Button::Dropdown::Component.new(text: "Notifications", style: :primary, icon: "dashboard") do |dropdown| %>
      <% dropdown.menu_item(text: "Messages", icon: "box", badge: "12", href: "#") %>
      <% dropdown.menu_item(text: "Alerts", icon: "alert", badge: "3", href: "#") %>
      <% dropdown.menu_item(text: "Updates", icon: "check", href: "#") %>
      <% dropdown.menu_divider %>
      <% dropdown.menu_item(text: "View all", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "Notifications", style: :primary, icon: "dashboard") do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Messages", icon: "box", badge: "12", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Alerts", icon: "alert", badge: "3", href: "#") %&gt;
        &lt;% dropdown.menu_divider %&gt;
        &lt;% dropdown.menu_item(text: "View all", href: "#") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Button Dropdowns - Disabled Items -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Dropdowns with Disabled Items", anchor_link: true, subtitle: "Examples for Dropdowns with Disabled Items.") %>
  <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
    <%= render FlatPack::Button::Dropdown::Component.new(text: "File", style: :secondary) do |dropdown| %>
      <% dropdown.menu_item(text: "Home", icon: "home", href: "#") %>
      <% dropdown.menu_item(text: "Dashboard", icon: "dashboard", href: "#") %>
      <% dropdown.menu_item(text: "Settings", icon: "settings", disabled: true) %>
      <% dropdown.menu_divider %>
      <% dropdown.menu_item(text: "Upload", icon: "upload", disabled: true) %>
      <% dropdown.menu_item(text: "Search", icon: "search", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "File", style: :secondary) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Home", icon: "home", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Settings", icon: "settings", disabled: true) %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Button Dropdowns - Disabled Dropdown -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Disabled Dropdown", anchor_link: true, subtitle: "Examples for Disabled Dropdown.") %>
  <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
    <%= render FlatPack::Button::Dropdown::Component.new(text: "Disabled", style: :primary, disabled: true) do |dropdown| %>
      <% dropdown.menu_item(text: "Option 1", href: "#") %>
      <% dropdown.menu_item(text: "Option 2", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "Disabled", style: :primary, disabled: true) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Option 1", href: "#") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="icon-trigger">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Icon trigger",
    anchor_link: true,
    subtitle: "A heart on the photo. A square plus beside it."
  ) %>
  <div class="mb-4 flex flex-wrap items-end gap-6">
    <div class="w-full max-w-sm">
      <%= render FlatPack::Media::Component.new(
        src: "/masonry/kiln.svg",
        alt: "Kiln yard",
        width: 500,
        height: 300
      ) do |media| %>
        <% media.with_item(placement: :top_right, inset: :sm) do %>
          <%= render FlatPack::Button::Dropdown::Component.new(
            text: "Add to list",
            icon: "heart",
            icon_only: true,
            round: true,
            size: :lg,
            style: :primary,
            placement: :bottom_left
          ) do |dropdown| %>
            <% dropdown.menu_item(text: "Favorites", icon: "heart", href: "#") %>
            <% dropdown.menu_item(text: "Weekend", icon: "calendar", href: "#") %>
            <% dropdown.menu_item(text: "Gift ideas", icon: "gift", href: "#") %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="rounded-[var(--radius-lg)] border border-[var(--surface-border-color)] bg-[var(--surface-background-color)] p-4" style="--button-border-radius: var(--radius-md)">
      <%= render FlatPack::Button::Dropdown::Component.new(
        text: "Add",
        icon: "plus",
        icon_only: true,
        size: :lg,
        style: :secondary
      ) do |dropdown| %>
        <% dropdown.menu_item(text: "Photo", href: "#") %>
        <% dropdown.menu_item(text: "Note", href: "#") %>
      <% end %>
    </div>
  </div>

  <p class="mb-3 text-sm text-[var(--surface-muted-content-color)]">Same heart. Four corners.</p>
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <% [
      [:bottom_right, "Bottom right"],
      [:bottom_left, "Bottom left"],
      [:top_right, "Top right"],
      [:top_left, "Top left"]
    ].each do |placement, label| %>
      <%= render FlatPack::Button::Dropdown::Component.new(
        text: label,
        icon: "heart",
        icon_only: true,
        round: true,
        size: :sm,
        style: :secondary,
        placement: placement
      ) do |dropdown| %>
        <% dropdown.menu_item(text: label, href: "#") %>
        <% dropdown.menu_item(text: "Favorites", href: "#") %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(
        text: "Add to list",
        icon: "heart",
        icon_only: true,
        round: true,
        size: :lg
      ) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Favorites", icon: "heart", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Weekend", icon: "calendar", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Gift ideas", icon: "gift", href: "#") %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::Button::Dropdown::Component.new(
        text: "Add",
        icon: "plus",
        icon_only: true,
        size: :lg
      ) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Photo", href: "#") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<section class="mb-12" id="host-hooks">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Host hooks",
    anchor_link: true,
    subtitle: "Menu classes, a swapped trigger label, an icon at the end, and a form that stays open."
  ) %>
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Dropdown::Component.new(
      text: "Lists",
      style: :secondary,
      placement: :bottom_left,
      menu_class: "min-w-[18rem]",
      menu_attributes: {id: "demo-add-to-list-menu"}
    ) do |dropdown| %>
      <% dropdown.with_trigger_label { "Lists · 3" } %>
      <% dropdown.menu_item(text: "Favorites", icon: "heart", icon_position: :end, href: "#") %>
      <% dropdown.menu_item(text: "Weekend", icon: "calendar", icon_position: :end, href: "#") %>
      <% dropdown.menu_divider %>
      <% dropdown.menu_form do %>
        <form class="flex flex-col gap-2">
          <%= render FlatPack::TextInput::Component.new(name: "demo_list_name", label: "New list") %>
          <%= render FlatPack::Button::Component.new(text: "Add", size: :sm, style: :primary, type: "button") %>
        </form>
      <% end %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Pin", style: :ghost) do |dropdown| %>
      <% dropdown.menu_item(text: "Stay put", icon: "lock", keep_open: true) %>
      <% dropdown.menu_item(text: "Close after", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(
        text: "Lists",
        placement: :bottom_left,
        menu_class: "min-w-[18rem]",
        menu_attributes: { id: "add-to-list-menu" }
      ) do |dropdown| %&gt;
        &lt;% dropdown.with_trigger_label { "Lists · 3" } %&gt;
        &lt;% dropdown.menu_item(text: "Favorites", icon: "heart", icon_position: :end, href: "#") %&gt;
        &lt;% dropdown.menu_form do %&gt;
          &lt;form&gt;
            &lt;%= render FlatPack::TextInput::Component.new(name: "name", label: "New list") %&gt;
            &lt;%= render FlatPack::Button::Component.new(text: "Add", size: :sm, type: "submit") %&gt;
          &lt;/form&gt;
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

