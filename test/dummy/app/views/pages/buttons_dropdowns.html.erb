<%= render FlatPack::PageTitle::Component.new(
  title: "Button Dropdowns",
  subtitle: "Dropdown menus with full keyboard navigation, accessibility support, and multiple styling options."
) %>

<!-- Button Dropdowns - Basic -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Button Dropdowns", anchor_link: true, subtitle: "Examples for Button Dropdowns.") %>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    Dropdown menus with full keyboard navigation, accessibility support, and multiple styling options.
  </p>
  <div class="flex gap-3 mb-4 overflow-x-auto pb-2 md:overflow-visible md:pb-0">
    <%= render FlatPack::Button::Dropdown::Component.new(text: "Actions", style: :primary) do |dropdown| %>
      <% dropdown.menu_item(text: "Search", icon: "search", href: "#") %>
      <% dropdown.menu_item(text: "Dashboard", icon: "dashboard", href: "#") %>
      <% dropdown.menu_divider %>
      <% dropdown.menu_item(text: "Settings", icon: "settings", href: "#") %>
      <% dropdown.menu_item(text: "Delete", icon: "trash", destructive: true, href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "Options", style: :secondary) do |dropdown| %>
      <% dropdown.menu_item(text: "Home", icon: "home", href: "#") %>
      <% dropdown.menu_item(text: "Monitor", icon: "monitor", href: "#") %>
      <% dropdown.menu_divider %>
      <% dropdown.menu_item(text: "Settings", icon: "settings", href: "#") %>
    <% end %>

    <%= render FlatPack::Button::Dropdown::Component.new(text: "More", style: :ghost) do |dropdown| %>
      <% dropdown.menu_item(text: "Upload", icon: "upload", href: "#") %>
      <% dropdown.menu_item(text: "Check", icon: "check", href: "#") %>
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Button::Dropdown::Component.new(text: "Actions", style: :primary) do |dropdown| %&gt;
        &lt;% dropdown.menu_item(text: "Search", icon: "search", href: "#") %&gt;
        &lt;% dropdown.menu_item(text: "Dashboard", icon: "dashboard", href: "#") %&gt;
        &lt;% dropdown.menu_divider %&gt;
        &lt;% dropdown.menu_item(text: "Delete", icon: "trash", destructive: true, href: "#") %&gt;
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Button Dropdowns - Sizes -->
<section class="mb-12">
