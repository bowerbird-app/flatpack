<%= render FlatPack::PageTitle::Component.new(
  title: "Link Component",
  subtitle: "Text links with built-in URL validation and security features."
) %>

<p class="text-[var(--surface-muted-content-color)] mb-12">
  API reference for the Link component is not yet available in the component method table.
</p>

<!-- Link Component -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Link Component", anchor_link: true, subtitle: "Examples for Link Component.") %>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    For text links without button styling, use the Link component. It includes built-in URL validation and security features.
  </p>
  <div class="flex gap-4 mb-4">
    <%= render FlatPack::Link::Component.new(href: demo_tables_basic_path) do %>
      Go to Tables
    <% end %>
    <%= render FlatPack::Link::Component.new(href: "https://github.com", target: "_blank") do %>
      GitHub (opens in new tab)
    <% end %>
    <%= render FlatPack::Link::Component.new(href: "mailto:hello@example.com") do %>
      Email us
    <% end %>
    <%= render FlatPack::Link::Component.new(href: "tel:+1234567890") do %>
      Call us
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Link::Component.new(href: demo_tables_basic_path) do %&gt;
        Go to Tables
      &lt;% end %&gt;
      
      &lt;%= render FlatPack::Link::Component.new(href: "https://github.com", target: "_blank") do %&gt;
        GitHub (opens in new tab)  # Automatically adds rel="noopener noreferrer"
      &lt;% end %&gt;
      
      &lt;%= render FlatPack::Link::Component.new(href: "mailto:hello@example.com") do %&gt;
        Email us
      &lt;% end %&gt;
    CODE
  ) %>
</section>

<!-- Link Component with Custom Classes -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Link Component with Custom Styling", anchor_link: true, subtitle: "Examples for Link Component with Custom Styling.") %>
  <div class="space-y-3 mb-4">
    <%= render FlatPack::Link::Component.new(href: "#", class: "text-blue-600 hover:text-blue-800 font-semibold") do %>
      Custom styled link
    <% end %>
    <br>
    <%= render FlatPack::Link::Component.new(href: "#", class: "text-green-600 underline") do %>
      Underlined green link
    <% end %>
    <br>
    <%= render FlatPack::Link::Component.new(href: "#", class: "text-[var(--color-primary)] hover:underline") do %>
      Theme colored link
    <% end %>
  </div>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Link::Component.new(
        href: "#",
        class: "text-blue-600 hover:text-blue-800 font-semibold"
      ) do %&gt;
        Custom styled link
      &lt;% end %&gt;
    CODE
  ) %>
</section>
