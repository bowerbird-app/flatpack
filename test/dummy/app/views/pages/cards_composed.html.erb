        &lt;%= render FlatPack::Card::Component.new(style: :list, padding: :sm) do |card| %&gt;
          &lt;% card.body do %&gt;
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                &lt;%= render FlatPack::Avatar::Component.new(name: "Alice", initials: "A", size: :md) %&gt;
                <div>
                  <p class="font-medium">Alice sent you a message</p>
                  <p class="text-sm text-[var(--surface-muted-content-color)]">2 minutes ago</p>
                </div>
              </div>
              <span class="text-xs text-[var(--surface-muted-content-color)]">10:30 AM</span>
            </div>
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>
