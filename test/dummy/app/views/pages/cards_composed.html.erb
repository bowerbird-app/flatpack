<%# Controller: no instance variables required — stat_cards and other data are inline. %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Composed Card Examples",
  subtitle: "Product, stat, profile, pricing, themed, and list card layouts."
) %>

<%= render "pages/component_method_variables_table", component: :card %>

  <!-- Product Card Example -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Product Card Example", anchor_link: true, subtitle: "Examples for Product Card Example.") %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "4/3") do %>
          <div class="w-full h-full bg-gradient-to-br from-green-400 to-blue-500 flex items-center justify-center text-white text-xl font-bold">
            Product
          </div>
        <% end %>
        <% card.body do %>
          <h3 class="text-lg font-semibold mb-2">Premium Widget</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">High-quality widget with advanced features and premium support.</p>
          <div class="text-2xl font-bold text-green-600">$99.99</div>
        <% end %>
        <% card.footer do %>
          <%= render FlatPack::Button::Component.new(
            text: "Add to Cart",
            style: :primary,
            class: "w-full"
          ) %>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "4/3") do %>
          <div class="w-full h-full bg-gradient-to-br from-purple-400 to-pink-500 flex items-center justify-center text-white text-xl font-bold">
            Product
          </div>
        <% end %>
        <% card.body do %>
          <h3 class="text-lg font-semibold mb-2">Standard Widget</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Reliable widget with essential features for everyday use.</p>
          <div class="text-2xl font-bold text-green-600">$49.99</div>
        <% end %>
        <% card.footer do %>
          <%= render FlatPack::Button::Component.new(
            text: "Add to Cart",
            style: :primary,
            class: "w-full"
          ) %>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.media(aspect_ratio: "4/3") do %>
          <div class="w-full h-full bg-gradient-to-br from-orange-400 to-red-500 flex items-center justify-center text-white text-xl font-bold">
            Product
          </div>
        <% end %>
        <% card.body do %>
          <h3 class="text-lg font-semibold mb-2">Basic Widget</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Simple widget perfect for getting started with basic needs.</p>
          <div class="text-2xl font-bold text-green-600">$29.99</div>
        <% end %>
        <% card.footer do %>
          <%= render FlatPack::Button::Component.new(
            text: "Add to Cart",
            style: :primary,
            class: "w-full"
          ) %>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(style: :default) do |card| %&gt;
          &lt;% card.media(aspect_ratio: "4/3") do %&gt;
            <div class="w-full h-full bg-gradient-to-br from-green-400 to-blue-500 flex items-center justify-center text-white text-xl font-bold">
              Product
            </div>
          &lt;% end %&gt;
          &lt;% card.body do %&gt;
            <h3 class="text-lg font-semibold mb-2">Premium Widget</h3>
            <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">High-quality widget with advanced features and premium support.</p>
            <div class="text-2xl font-bold text-green-600">$99.99</div>
          &lt;% end %&gt;
          &lt;% card.footer do %&gt;
            &lt;%= render FlatPack::Button::Component.new(
              text: "Add to Cart",
              style: :primary,
              class: "w-full"
            ) %&gt;
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

  <!-- Stat Cards -->
  <section class="mb-12">
    <%= render FlatPack::SectionTitle::Component.new(title: "Stat Cards", anchor_link: true, subtitle: "Examples for Stat Cards.") %>
    <%
      stat_cards = [
        { icon: "users",     label: "Total Users",      value: "2,543",  trend: "+12%", up: true  },
        { icon: "dashboard", label: "Active Sessions",  value: "1,234",  trend: "+8%",  up: true  },
        { icon: "dashboard", label: "Revenue",          value: "$45.2K", trend: "+23%", up: true  },
        { icon: "monitor",   label: "Uptime",           value: "98.5%",  trend: "-0.5%", up: false }
      ]
    %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-4">
      <% stat_cards.each do |stat| %>
        <%= render FlatPack::Card::Component.new(style: :default, class: "overflow-hidden") do |card| %>
          <% card.body do %>
            <div class="flex items-center gap-4">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] flex items-center justify-center">
                <%= render FlatPack::Shared::IconComponent.new(name: stat[:icon], size: :lg, class: "text-[var(--surface-muted-content-color)]") %>
              </div>
              <div class="flex flex-col">
                <span class="text-xs font-medium text-[var(--surface-muted-content-color)] uppercase tracking-wide"><%= stat[:label] %></span>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="text-2xl font-bold text-[var(--surface-content-color)]"><%= stat[:value] %></span>
                  <span class="text-xs font-medium" style="color: <%= stat[:up] ? "var(--color-success-background-color)" : "var(--color-danger-background-color)" %>"><%= stat[:trend] %></span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%= render FlatPack::CodeBlock::Component.new(
      language: "erb",
      code: CGI.unescapeHTML(<<~'CODE')
        &lt;%= render FlatPack::Card::Component.new(style: :default) do |card| %&gt;
          &lt;% card.body do %&gt;
            &lt;div class="flex items-center gap-4"&gt;
              &lt;div class="shrink-0 w-12 h-12 rounded-xl bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] flex items-center justify-center"&gt;
                &lt;%= render FlatPack::Shared::IconComponent.new(name: "users", size: :lg, class: "text-[var(--surface-muted-content-color)]") %&gt;
              &lt;/div&gt;
              &lt;div class="flex flex-col"&gt;
                &lt;span class="text-xs font-medium text-[var(--surface-muted-content-color)] uppercase tracking-wide"&gt;Total Users&lt;/span&gt;
                &lt;div class="flex items-center gap-1.5 mt-0.5"&gt;
                  &lt;span class="text-2xl font-bold text-[var(--surface-content-color)]"&gt;2,543&lt;/span&gt;
                  &lt;span class="text-xs font-medium" style="color: var(--color-success-background-color)"&gt;+12%&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;% end %&gt;
        &lt;% end %&gt;
      CODE
    ) %>
  </section>

  <!-- Profile Card -->
