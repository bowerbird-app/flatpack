<%
  register_page_nav "New press kit", "/press-kits/new", role: :primary, icon: :plus
  register_page_nav "Share", "/press-kits/share", role: :secondary, icon: :share
  register_page_nav "Delete", "/press-kits/delete", role: :destructive, icon: :trash
  register_page_nav component: PublishableQuickActionsComponent.new, role: :secondary
%>

<% if params[:shell] == "page" %>
  <%= render FlatPack::PageLayout::Component.new(width: :default, id: "page-nav-registry-shell") do |layout| %>
    <% layout.top_nav do %>
      <%= render FlatPack::TopNav::Component.new do |nav| %>
        <% nav.left do %>
          Press kit
        <% end %>
      <% end %>
    <% end %>

    <%= render "pages/page_nav_registry_header", styles: FlatPack::PageNavRoleStyles::SOLID %>
  <% end %>
<% else %>
  <%= render "pages/page_nav_registry_header", styles: FlatPack::PageNavRoleStyles::QUIET %>
<% end %>
