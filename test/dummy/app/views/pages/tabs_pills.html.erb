<%= render FlatPack::PageTitle::Component.new(
  title: "Pills Tabs",
  subtitle: "Tabbed content with pill-style triggers and full keyboard navigation."
) %>

<%= render "pages/component_method_variables_table", component: :tabs %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Pills Variant", anchor_link: true, subtitle: "Rounded tabs. Compare primary with default.") %>
  <div class="grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="text-lg font-semibold mb-2">Primary</h3>
      <p class="text-[var(--surface-muted-content-color)] mb-4">The selected tab uses the primary colour.</p>
      <%= render FlatPack::Tabs::Component.new(variant: :pills) do |tabs| %>
        <% tabs.tab(id: "account", label: "Account") %>
        <% tabs.tab(id: "billing", label: "Billing") %>
        <% tabs.tab(id: "members", label: "Team Members") %>

        <% tabs.panel(id: "account") do %>
          <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Account Preferences</h3>
            <p class="text-[var(--surface-content-color)]">
              Pills are useful when you want segmented-control styling while keeping tab semantics and keyboard support.
            </p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "billing") do %>
          <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Billing Settings</h3>
            <p class="text-[var(--surface-content-color)]">The selected tab uses the primary colour.</p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "members") do %>
          <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Team Members</h3>
            <p class="text-[var(--surface-content-color)]">Switch styles with <code>variant: :pills</code> and keep existing tab/panel declarations.</p>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div>
      <h3 class="text-lg font-semibold mb-2">Default</h3>
      <p class="text-[var(--surface-muted-content-color)] mb-4">The selected tab matches a default button.</p>
      <%= render FlatPack::Tabs::Component.new(variant: :pills, style: :default) do |tabs| %>
        <% tabs.tab(id: "default-account", label: "Account") %>
        <% tabs.tab(id: "default-billing", label: "Billing") %>
        <% tabs.tab(id: "default-members", label: "Team Members") %>

        <% tabs.panel(id: "default-account") do %>
          <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Account Preferences</h3>
            <p class="text-[var(--surface-content-color)]">
              This group uses the default button colour for the selected tab.
            </p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "default-billing") do %>
          <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Billing Settings</h3>
            <p class="text-[var(--surface-content-color)]">The selected tab matches a default button.</p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "default-members") do %>
          <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Team Members</h3>
            <p class="text-[var(--surface-content-color)]">Same tabs, different selected colour.</p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Tabs::Component.new(variant: :pills) do |tabs| %&gt;
        &lt;% tabs.tab(id: "account", label: "Account") %&gt;
        &lt;% tabs.tab(id: "billing", label: "Billing") %&gt;

        &lt;% tabs.panel(id: "account") do %&gt;
          <p>Account content...</p>
        &lt;% end %&gt;
        &lt;% tabs.panel(id: "billing") do %&gt;
          <p>The selected tab uses the primary colour.</p>
        &lt;% end %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::Tabs::Component.new(variant: :pills, style: :default) do |tabs| %&gt;
        &lt;% tabs.tab(id: "account", label: "Account") %&gt;
        &lt;% tabs.tab(id: "billing", label: "Billing") %&gt;

        &lt;% tabs.panel(id: "account") do %&gt;
          <p>The selected tab matches a default button.</p>
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<section class="mb-12" id="sliding-pills">
  <%= render FlatPack::SectionTitle::Component.new(title: "Sliding pill", anchor_link: true, subtitle: "The fill follows the selected tab.") %>
  <%= render FlatPack::Tabs::Component.new(variant: :pills, indicator: :slide) do |tabs| %>
    <% tabs.tab(id: "slide-account", label: "Account") %>
    <% tabs.tab(id: "slide-billing", label: "Billing") %>
    <% tabs.tab(id: "slide-members", label: "Team") %>

    <% tabs.panel(id: "slide-account") do %>
      <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
        <h3 class="text-lg font-semibold mb-2">Account</h3>
        <p class="text-[var(--surface-content-color)]">The filled pill slides. Text colour is the only change on the tab itself.</p>
      <% end %>
    <% end %>
    <% tabs.panel(id: "slide-billing") do %>
      <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
        <h3 class="text-lg font-semibold mb-2">Billing</h3>
        <p class="text-[var(--surface-content-color)]">Same tokens as the instant pills above. This one just moves.</p>
      <% end %>
    <% end %>
    <% tabs.panel(id: "slide-members") do %>
      <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
        <h3 class="text-lg font-semibold mb-2">Team</h3>
        <p class="text-[var(--surface-content-color)]">Pass <code>indicator: :slide</code> on the pills variant.</p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Tabs::Component.new(variant: :pills, indicator: :slide) do |tabs| %&gt;
        &lt;% tabs.tab(id: "account", label: "Account") %&gt;
        &lt;% tabs.tab(id: "billing", label: "Billing") %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Keyboard Navigation", anchor_link: true, subtitle: "Examples for Keyboard Navigation.") %>
  <%= render FlatPack::Card::Component.new(style: :flat, padding: :lg) do %>
    <h3 class="font-semibold mb-3">Keyboard Shortcuts:</h3>
    <%= render FlatPack::List::Component.new(spacing: :dense, class: "text-[var(--surface-content-color)]") do %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">←</kbd> / <kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">→</kbd> - Navigate between tabs<% end %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">Home</kbd> - Jump to first tab<% end %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">End</kbd> - Jump to last tab<% end %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">Enter</kbd> / <kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">Space</kbd> - Activate focused tab<% end %>
    <% end %>
  <% end %>
</section>
