<%= render FlatPack::PageTitle::Component.new(
  title: "Pills Tabs",
  subtitle: "Tabbed content with pill-style triggers and full keyboard navigation."
) %>

<%= render "pages/component_method_variables_table", component: :tabs %>

<section class="mb-12" id="tabs-pill-track">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Flush or a track",
    anchor_link: true,
    subtitle: "Pill tabs line up with the heading. Pass track: true for a border and padding."
  ) %>

  <div class="mt-8 space-y-8">
    <div id="tabs-pill-flush">
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-1">Flush</p>
      <h3 class="text-lg font-semibold mb-3">Library</h3>
      <%= render FlatPack::Tabs::Component.new(variant: :pills) do |tabs| %>
        <% tabs.tab(id: "flush-all", label: "All") %>
        <% tabs.tab(id: "flush-sale", label: "On sale") %>
        <% tabs.tab(id: "flush-archive", label: "Archive") %>
        <% tabs.panel(id: "flush-all") do %><p class="text-[var(--surface-content-color)]">Everything in the library.</p><% end %>
        <% tabs.panel(id: "flush-sale") do %><p class="text-[var(--surface-content-color)]">Things on sale.</p><% end %>
        <% tabs.panel(id: "flush-archive") do %><p class="text-[var(--surface-content-color)]">Older releases.</p><% end %>
      <% end %>
    </div>

    <div id="tabs-pill-track-row">
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-1">Track</p>
      <h3 class="text-lg font-semibold mb-3">Library</h3>
      <%= render FlatPack::Tabs::Component.new(variant: :pills, track: true) do |tabs| %>
        <% tabs.tab(id: "track-all", label: "All") %>
        <% tabs.tab(id: "track-sale", label: "On sale") %>
        <% tabs.tab(id: "track-archive", label: "Archive") %>
        <% tabs.panel(id: "track-all") do %><p class="text-[var(--surface-content-color)]">Everything in the library.</p><% end %>
        <% tabs.panel(id: "track-sale") do %><p class="text-[var(--surface-content-color)]">Things on sale.</p><% end %>
        <% tabs.panel(id: "track-archive") do %><p class="text-[var(--surface-content-color)]">Older releases.</p><% end %>
      <% end %>
    </div>

    <div id="tabs-pill-flush-slide">
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-1">Flush, sliding</p>
      <h3 class="text-lg font-semibold mb-3">Library</h3>
      <%= render FlatPack::Tabs::Component.new(variant: :pills, indicator: :slide) do |tabs| %>
        <% tabs.tab(id: "flush-slide-all", label: "All") %>
        <% tabs.tab(id: "flush-slide-sale", label: "On sale") %>
        <% tabs.tab(id: "flush-slide-archive", label: "Archive") %>
        <% tabs.panel(id: "flush-slide-all") do %><p class="text-[var(--surface-content-color)]">The fill slides. The row stays flush.</p><% end %>
        <% tabs.panel(id: "flush-slide-sale") do %><p class="text-[var(--surface-content-color)]">Things on sale.</p><% end %>
        <% tabs.panel(id: "flush-slide-archive") do %><p class="text-[var(--surface-content-color)]">Older releases.</p><% end %>
      <% end %>
    </div>

    <div id="tabs-pill-track-slide">
      <p class="text-sm text-[var(--surface-muted-content-color)] mb-1">Track, sliding</p>
      <h3 class="text-lg font-semibold mb-3">Library</h3>
      <%= render FlatPack::Tabs::Component.new(variant: :pills, track: true, indicator: :slide) do |tabs| %>
        <% tabs.tab(id: "track-slide-all", label: "All") %>
        <% tabs.tab(id: "track-slide-sale", label: "On sale") %>
        <% tabs.tab(id: "track-slide-archive", label: "Archive") %>
        <% tabs.panel(id: "track-slide-all") do %><p class="text-[var(--surface-content-color)]">The fill slides inside the track.</p><% end %>
        <% tabs.panel(id: "track-slide-sale") do %><p class="text-[var(--surface-content-color)]">Things on sale.</p><% end %>
        <% tabs.panel(id: "track-slide-archive") do %><p class="text-[var(--surface-content-color)]">Older releases.</p><% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Pills Variant", anchor_link: true, subtitle: "Rounded tabs. Omit style for the neutral active surface, or pass style: :primary for the brand fill.") %>
  <div class="grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="text-lg font-semibold mb-2">Neutral</h3>
      <p class="text-[var(--surface-muted-content-color)] mb-4">The selected tab uses the neutral active surface.</p>
      <%= render FlatPack::Tabs::Component.new(variant: :pills) do |tabs| %>
        <% tabs.tab(id: "account", label: "Account") %>
        <% tabs.tab(id: "billing", label: "Billing") %>
        <% tabs.tab(id: "members", label: "Team Members") %>

        <% tabs.panel(id: "account") do %>
          <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Account Preferences</h3>
            <p class="text-[var(--surface-content-color)]">
              Pills are useful when you want segmented-control styling while keeping tab semantics and keyboard support.
            </p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "billing") do %>
          <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Billing Settings</h3>
            <p class="text-[var(--surface-content-color)]">The selected tab uses the neutral active surface.</p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "members") do %>
          <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Team Members</h3>
            <p class="text-[var(--surface-content-color)]">Switch styles with <code>variant: :pills</code> and keep existing tab/panel declarations.</p>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div>
      <h3 class="text-lg font-semibold mb-2">Primary</h3>
      <p class="text-[var(--surface-muted-content-color)] mb-4">Pass style: :primary for the brand fill.</p>
      <%= render FlatPack::Tabs::Component.new(variant: :pills, style: :primary) do |tabs| %>
        <% tabs.tab(id: "default-account", label: "Account") %>
        <% tabs.tab(id: "default-billing", label: "Billing") %>
        <% tabs.tab(id: "default-members", label: "Team Members") %>

        <% tabs.panel(id: "default-account") do %>
          <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Account Preferences</h3>
            <p class="text-[var(--surface-content-color)]">
              This group uses the primary button colour for the selected tab.
            </p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "default-billing") do %>
          <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Billing Settings</h3>
            <p class="text-[var(--surface-content-color)]">The selected tab uses the primary colour.</p>
          <% end %>
        <% end %>
        <% tabs.panel(id: "default-members") do %>
          <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
            <h3 class="text-lg font-semibold mb-2">Team Members</h3>
            <p class="text-[var(--surface-content-color)]">Same tabs, different selected colour.</p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Tabs::Component.new(variant: :pills) do |tabs| %&gt;
        &lt;% tabs.tab(id: "account", label: "Account") %&gt;
        &lt;% tabs.tab(id: "billing", label: "Billing") %&gt;

        &lt;% tabs.panel(id: "account") do %&gt;
          <p>Account content...</p>
        &lt;% end %&gt;
        &lt;% tabs.panel(id: "billing") do %&gt;
          <p>The selected tab uses the neutral active surface.</p>
        &lt;% end %&gt;
      &lt;% end %&gt;

      &lt;%= render FlatPack::Tabs::Component.new(variant: :pills, style: :primary) do |tabs| %&gt;
        &lt;% tabs.tab(id: "account", label: "Account") %&gt;
        &lt;% tabs.tab(id: "billing", label: "Billing") %&gt;

        &lt;% tabs.panel(id: "account") do %&gt;
          <p>The selected tab uses the primary colour.</p>
        &lt;% end %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<section class="mb-12" id="sliding-pills">
  <%= render FlatPack::SectionTitle::Component.new(title: "Sliding pill", anchor_link: true, subtitle: "The fill follows the selected tab.") %>
  <%= render FlatPack::Tabs::Component.new(variant: :pills, indicator: :slide) do |tabs| %>
    <% tabs.tab(id: "slide-account", label: "Account") %>
    <% tabs.tab(id: "slide-billing", label: "Billing") %>
    <% tabs.tab(id: "slide-members", label: "Team") %>

    <% tabs.panel(id: "slide-account") do %>
      <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
        <h3 class="text-lg font-semibold mb-2">Account</h3>
        <p class="text-[var(--surface-content-color)]">The filled pill slides. Text colour is the only change on the tab itself.</p>
      <% end %>
    <% end %>
    <% tabs.panel(id: "slide-billing") do %>
      <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
        <h3 class="text-lg font-semibold mb-2">Billing</h3>
        <p class="text-[var(--surface-content-color)]">Same tokens as the instant pills above. This one just moves.</p>
      <% end %>
    <% end %>
    <% tabs.panel(id: "slide-members") do %>
      <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
        <h3 class="text-lg font-semibold mb-2">Team</h3>
        <p class="text-[var(--surface-content-color)]">Pass <code>indicator: :slide</code> on the pills variant.</p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      &lt;%= render FlatPack::Tabs::Component.new(variant: :pills, indicator: :slide) do |tabs| %&gt;
        &lt;% tabs.tab(id: "account", label: "Account") %&gt;
        &lt;% tabs.tab(id: "billing", label: "Billing") %&gt;
      &lt;% end %&gt;
    CODE
    class: "mt-4"
  ) %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Keyboard Navigation", anchor_link: true, subtitle: "Examples for Keyboard Navigation.") %>
  <%= render FlatPack::Card::Component.new(style: :shaded, border: :none, padding: :lg) do %>
    <h3 class="font-semibold mb-3">Keyboard Shortcuts:</h3>
    <%= render FlatPack::List::Component.new(spacing: :dense, class: "text-[var(--surface-content-color)]") do %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">←</kbd> / <kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">→</kbd> - Navigate between tabs<% end %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">Home</kbd> - Jump to first tab<% end %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">End</kbd> - Jump to last tab<% end %>
      <%= render FlatPack::List::Item.new do %><kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">Enter</kbd> / <kbd class="px-2 py-1 bg-[var(--surface-background-color)] border border-[var(--surface-border-color)] rounded text-sm">Space</kbd> - Activate focused tab<% end %>
    <% end %>
  <% end %>
</section>
