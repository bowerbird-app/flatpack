<%= render FlatPack::PageTitle::Component.new(
  title: "Type scale",
  subtitle: "Kit rungs from xs through 8xl, plus the fluid display cover size."
) %>

<%# Tailwind scan: text-xs text-sm text-base text-lg text-xl text-2xl text-3xl text-4xl text-5xl text-6xl text-7xl text-8xl %>
<%
  type_scale_steps = [
    ["text-xs", "xs", "0.75rem / 12px"],
    ["text-sm", "sm", "0.875rem / 14px"],
    ["text-base", "base", "1rem / 16px"],
    ["text-lg", "lg", "1.125rem / 18px"],
    ["text-xl", "xl", "1.25rem / 20px"],
    ["text-2xl", "2xl", "1.5rem / 24px"],
    ["text-3xl", "3xl", "1.875rem / 30px"],
    ["text-4xl", "4xl", "2.25rem / 36px"],
    ["text-5xl", "5xl", "3rem / 48px"],
    ["text-6xl", "6xl", "3.75rem / 60px"],
    ["text-7xl", "7xl", "4.5rem / 72px"],
    ["text-8xl", "8xl", "6rem / 96px"]
  ]
%>

<section class="mb-12" id="scale">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Scale",
    anchor_link: true,
    subtitle: "Tailwind utilities mapped from --text-*. 6xl through 8xl are the display rungs."
  ) %>

  <div class="space-y-8">
    <% type_scale_steps.each do |utility, name, measure| %>
      <div>
        <p class="mb-1 text-sm text-[var(--surface-muted-content-color)]"><%= name %> · <%= measure %> · <%= utility %></p>
        <p class="<%= utility %> font-semibold leading-tight text-[var(--surface-content-color)]">Northlight collection</p>
      </div>
    <% end %>
  </div>
</section>

<section class="mb-12" id="display">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Display",
    anchor_link: true,
    subtitle: "On this rounded page the cover runs 40px on a phone to 104px on a wide screen. The default theme stays near 48px to 88px."
  ) %>

  <p class="mb-1 text-sm text-[var(--surface-muted-content-color)]">display · rounded 40px to 104px · fp-display</p>
  <p class="fp-display fp-text-balance text-[var(--surface-content-color)]">A press kit for the Northlight collection</p>
</section>

<section class="mb-12" id="roles">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Roles",
    anchor_link: true,
    subtitle: "Display, section, heading, body, control, and pill. Rounded sets the face and the weights."
  ) %>

  <%= render FlatPack::Heading::Component.new(text: "Heading role", level: :h2) %>
  <div class="mt-4">
    <%= render FlatPack::Text::Component.new(text: "Body role. The Northlight collection ships stills, credits, and download packs.") %>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(text: "Save changes") %>
    <%= render FlatPack::Badge::Component.new(text: "New") %>
    <%= render FlatPack::Chip::Component.new(text: "Stills") %>
  </div>
</section>

<section class="mb-12" id="display-dark" data-theme="dark">
  <div class="rounded-[var(--radius-lg)] bg-[var(--surface-page-background-color)] p-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Display on dark",
      subtitle: "Same cover size on the dark theme."
    ) %>
    <p class="fp-display fp-text-balance text-[var(--surface-content-color)]">A press kit for the Northlight collection</p>
  </div>
</section>
