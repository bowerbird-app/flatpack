<% frame = local_assigns.fetch(:frame, :section) %>
<div id="motion-sequence" class="<%= frame == :stage ? "flex w-full flex-col justify-center gap-8" : "flex flex-col gap-8" %>">
  <div class="flex max-w-2xl flex-col gap-6">
    <%= render FlatPack::Reveal::Component.new(
      reveal: :rise,
      duration: :slower,
      tag: :h2,
      class: "text-5xl font-semibold tracking-tight"
    ) do %>
      Pack it once
    <% end %>
    <%= render FlatPack::Reveal::Component.new(
      reveal: :fade,
      delay: :md,
      tag: :p,
      class: "text-xl text-[var(--surface-muted-content-color)]"
    ) do %>
      Walnut, oiled, ready Friday.
    <% end %>
    <%= render FlatPack::Reveal::Component.new(reveal: :rise, delay: :lg, class: "flex flex-wrap gap-3") do %>
      <%= render FlatPack::Button::Component.new(text: "Start packing", style: :primary) %>
      <%= render FlatPack::Button::Component.new(text: "See the kit", style: :secondary) %>
    <% end %>
  </div>
  <div id="motion-stagger">
    <p class="mb-3 text-sm font-medium">One after another</p>
    <%= render FlatPack::Reveal::Component.new(reveal: :rise, stagger: :lg, class: "grid gap-4 md:grid-cols-4") do %>
      <% %w[Oak Walnut Maple Ash].each do |name| %>
        <div class="rounded-[var(--radius-md)] border border-[var(--card-border-color)] bg-[var(--card-background-color)] px-4 py-4 text-lg font-medium"><%= name %></div>
      <% end %>
    <% end %>
  </div>
</div>
