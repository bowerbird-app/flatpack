<%= render FlatPack::PageTitle::Component.new(
  title: "Chart Component",
  subtitle: "Data visualization using ApexCharts with Card wrapping by default."
) %>

<%= render "pages/component_method_variables_table", component: :chart %>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Overview", anchor_link: true) %>
  <p class="text-(--surface-muted-content-color) mb-6">
    FlatPack charts wrap ApexCharts with sensible defaults, optional card chrome, slots for actions and footers, and Turbo-friendly filter controls.
    Browse the sections below for chart types, composition patterns, and setup notes.
  </p>

  <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md) do %>
    <%= render FlatPack::Card::Component.new(style: :default, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Chart Types</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Line, column, bar, area, donut, gauge, and geo charts.</p>
        <%= render FlatPack::Button::Component.new(text: "View chart types", style: :secondary, size: :sm, href: demo_charts_types_path) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Composition</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Slots, filter controls, grids, footers, and card-free layouts.</p>
        <%= render FlatPack::Button::Component.new(text: "View composition", style: :secondary, size: :sm, href: demo_charts_composition_path) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default, hover: :subtle) do |card| %>
      <% card.body do %>
        <h3 class="text-lg font-semibold mb-2">Setup &amp; Reference</h3>
        <p class="text-sm text-[var(--surface-muted-content-color)] mb-4">Importmap setup, custom options, features, and type reference.</p>
        <%= render FlatPack::Button::Component.new(text: "View setup", style: :secondary, size: :sm, href: demo_charts_setup_path) %>
      <% end %>
    <% end %>
  <% end %>
</section>

<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Line Chart", anchor_link: true, subtitle: "A canonical line chart with card wrapper.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :line,
    series: [{
      name: "Sales",
      data: [30, 40, 45, 50, 49, 60, 70, 91, 125, 150, 180, 200]
    }],
    title: "Monthly Sales",
    height: 300
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Chart::Component.new(
        type: :line,
        series: [{
          name: "Sales",
          data: [30, 40, 45, 50, 49, 60, 70, 91, 125, 150, 180, 200]
        }],
        title: "Monthly Sales",
        height: 300
      ) %&gt;
    CODE
  ) %>
</section>
