<%= render FlatPack::PageTitle::Component.new(
  title: "Chart Component",
  subtitle: "Data visualization using ApexCharts with Card wrapping by default."
) %>

<%= render "pages/component_method_variables_table", component: :chart %>

<%
  erb_open = "<" + "%"
  erb_output_open = "<" + "%="
  erb_tag_close = "%" + ">"
%>

<!-- Basic Line Chart -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Line Chart", anchor_link: true, subtitle: "Examples for Line Chart.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :line,
    series: [{
      name: "Sales",
      data: [30, 40, 45, 50, 49, 60, 70, 91, 125, 150, 180, 200]
    }],
    title: "Monthly Sales",
    height: 300
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :line,
        series: [{
          name: "Sales",
          data: [30, 40, 45, 50, 49, 60, 70, 91, 125, 150, 180, 200]
        }],
        title: "Monthly Sales",
        height: 300
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Bar Chart -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Bar Chart", anchor_link: true, subtitle: "Examples for Bar Chart.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :bar,
    series: [{
      name: "Revenue",
      data: [44, 55, 57, 56, 61, 58, 63, 60, 66, 71, 89, 95]
    }],
    title: "Quarterly Revenue",
    subtitle: "In thousands",
    height: 300
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :bar,
        series: [{
          name: "Revenue",
          data: [44, 55, 57, 56, 61, 58, 63, 60, 66, 71, 89, 95]
        }],
        title: "Quarterly Revenue",
        subtitle: "In thousands",
        height: 300
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Area Chart -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Area Chart", anchor_link: true, subtitle: "Examples for Area Chart.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :area,
    series: [
      {name: "Series 1", data: [31, 40, 28, 51, 42, 109, 100]},
      {name: "Series 2", data: [11, 32, 45, 32, 34, 52, 41]}
    ],
    title: "Multi-Series Area Chart",
    height: 300
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :area,
        series: [
          {name: "Series 1", data: [31, 40, 28, 51, 42, 109, 100]},
          {name: "Series 2", data: [11, 32, 45, 32, 34, 52, 41]}
        ],
        title: "Multi-Series Area Chart",
        height: 300
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Donut Chart -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Donut Chart", anchor_link: true, subtitle: "Examples for Donut Chart.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :donut,
    series: [44, 55, 41, 17, 15],
    title: "Distribution",
    height: 350,
    options: {
      labels: ['Apple', 'Orange', 'Banana', 'Mango', 'Grape']
    }
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :donut,
        series: [44, 55, 41, 17, 15],
        title: "Distribution",
        height: 350,
        options: {
          labels: ["Apple", "Orange", "Banana", "Mango", "Grape"]
        }
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Chart with Slot -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Chart with Slot", anchor_link: true, subtitle: "Examples for Chart with Slot.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :line,
    series: [{name: "Users", data: [10, 25, 42, 68, 95, 130, 178, 220]}],
    title: "User Growth",
    subtitle: "Last 8 months",
    height: 300
  ) do |chart| %>
    <% chart.top_right_slot do %>
      <%= render FlatPack::Button::Component.new(text: "Export", style: :ghost, size: :sm) %>
      <%= render FlatPack::Button::Component.new(text: "Share", style: :secondary, size: :sm) %>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :line,
        series: [{name: "Users", data: [10, 25, 42, 68, 95, 130, 178, 220]}],
        title: "User Growth",
        subtitle: "Last 8 months",
        height: 300
      ) do |chart| #{erb_tag_close}
        #{erb_output_open} chart.top_right_slot do #{erb_tag_close}
          #{erb_output_open} render FlatPack::Button::Component.new(text: "Export", style: :ghost, size: :sm) #{erb_tag_close}
          #{erb_output_open} render FlatPack::Button::Component.new(text: "Share", style: :secondary, size: :sm) #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Chart with Generic Filter Controls -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Chart with Generic Filter Controls", anchor_link: true, subtitle: "Examples for Chart with Generic Filter Controls.") %>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    Use <code>FlatPack::ChartButtons::Component</code> as a sibling control surface for any chart filter UI.
  </p>

  <%= turbo_frame_tag "chart-period-filter" do %>
    <% compare_value = @chart_filter_compare ? "1" : "0" %>

    <%= render FlatPack::ChartButtons::Component.new(turbo_frame: "chart-period-filter") do |controls| %>
      <% controls.button(
        text: "Day",
        url: demo_charts_path(period: "day", compare: compare_value),
        selected: @chart_filter_period == "day"
      ) %>

      <% controls.button(
        text: "Month",
        url: demo_charts_path(period: "month", compare: compare_value),
        selected: @chart_filter_period == "month"
      ) %>

      <% controls.dropdown(
        text: "Range",
        style: :ghost,
        options: [
          {text: "Day", url: demo_charts_path(period: "day", compare: compare_value), selected: @chart_filter_period == "day"},
          {text: "Week", url: demo_charts_path(period: "week", compare: compare_value), selected: @chart_filter_period == "week"},
          {text: "Month", url: demo_charts_path(period: "month", compare: compare_value), selected: @chart_filter_period == "month"},
          {text: "Year", url: demo_charts_path(period: "year", compare: compare_value), selected: @chart_filter_period == "year"}
        ]
      ) %>

      <% controls.checkbox(
        name: "compare",
        label: "Compare baseline",
        checked: @chart_filter_compare,
        url: demo_charts_path(period: @chart_filter_period)
      ) %>

      <% controls.control do %>
        <%= render FlatPack::Button::Component.new(
          text: "Reset",
          style: :ghost,
          size: :sm,
          url: demo_charts_path(period: "day", compare: "0"),
          data: {
            turbo_frame: "chart-period-filter",
            turbo_prefetch: false
          }
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Chart::Component.new(
      type: :line,
      series: @chart_filter_series,
      title: "User Activity",
      subtitle: @chart_filter_subtitle,
      height: 300,
      options: {
        xaxis: {
          categories: @chart_filter_categories
        }
      }
    ) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_open}%
        period = %w[day week month year].include?(params[:period]) ? params[:period] : "day"
        compare = params[:compare] == "1"

        filter_sets = {
          "day" => {categories: %w[Mon Tue Wed Thu Fri Sat Sun], users: [42, 58, 50, 73, 88, 95, 90], baseline: [36, 49, 44, 64, 79, 87, 84]},
          "week" => {categories: %w[W1 W2 W3 W4 W5 W6 W7 W8], users: [210, 245, 278, 301, 330, 360, 390, 420], baseline: [198, 226, 253, 281, 305, 331, 357, 388]},
          "month" => {categories: %w[Jan Feb Mar Apr May Jun Jul Aug], users: [320, 410, 460, 520, 610, 680, 760, 830], baseline: [305, 380, 433, 491, 567, 634, 711, 780]},
          "year" => {categories: %w[2019 2020 2021 2022 2023 2024 2025 2026], users: [1200, 1360, 1490, 1640, 1800, 1970, 2150, 2360], baseline: [1110, 1265, 1388, 1535, 1674, 1840, 2006, 2192]}
        }

        selected = filter_sets.fetch(period)
        categories = selected[:categories]
        series = [{name: "Users", data: selected[:users]}]
        series << {name: "Baseline", data: selected[:baseline]} if compare

        compare_value = compare ? "1" : "0"
        subtitle = period.capitalize + " view"
        subtitle += " + baseline" if compare
      %#{erb_tag_close}

      #{erb_output_open} turbo_frame_tag "chart-period-filter" do #{erb_tag_close}
        #{erb_output_open} render FlatPack::ChartButtons::Component.new(turbo_frame: "chart-period-filter") do |controls| #{erb_tag_close}
          #{erb_open}% controls.button(text: "Day", url: demo_charts_path(period: "day", compare: compare_value), selected: period == "day") %#{erb_tag_close}
          #{erb_open}% controls.dropdown(text: "Range", options: [
            {text: "Day", url: demo_charts_path(period: "day", compare: compare_value), selected: period == "day"},
            {text: "Week", url: demo_charts_path(period: "week", compare: compare_value), selected: period == "week"},
            {text: "Month", url: demo_charts_path(period: "month", compare: compare_value), selected: period == "month"},
            {text: "Year", url: demo_charts_path(period: "year", compare: compare_value), selected: period == "year"}
          ]) %#{erb_tag_close}
          #{erb_open}% controls.checkbox(name: "compare", label: "Compare baseline", checked: compare, url: demo_charts_path(period: period)) %#{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} render FlatPack::Chart::Component.new(
          type: :line,
          series: series,
          title: "User Activity",
          subtitle: subtitle,
          height: 300,
          options: {xaxis: {categories: categories}}
        ) #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>

  <div class="mb-8 rounded-md border border-(--surface-border-color) bg-(--surface-muted-background-color) p-4">
    <h3 class="text-base font-semibold text-(--surface-content-color)">Default Chart Filter Component</h3>
    <p class="mt-1 text-sm text-(--surface-muted-content-color)">
      This demo moved to a dedicated page under Charts in the sidebar.
    </p>
    <div class="mt-3">
      <%= render FlatPack::Button::Component.new(
        text: "Open Default Chart Filter Demo",
        style: :secondary,
        size: :sm,
        url: demo_charts_default_filter_path
      ) %>
    </div>
  </div>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Single Outer Frame with Multiple Chart Buttons",
    anchor_link: true,
    subtitle: "Two button groups control chart 1 and chart 2 while all charts remain inside one outer frame."
  ) %>
  <p class="text-(--surface-muted-content-color) mb-4">
    This example keeps both button groups and all charts inside one outer frame, while each button group targets its own chart frame.
  </p>

  <%= turbo_frame_tag "chart-period-filter-multi" do %>
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <%= render FlatPack::ChartButtons::Component.new(margin_bottom: nil) do |controls| %>
          <% controls.button(
            text: "Chart 1 Day",
            url: demo_charts_path(chart_1_period: "day", chart_2_period: @chart_multi_chart_2_period),
            data: {turbo_frame: "chart-1-frame"}
          ) %>
          <% controls.button(
            text: "Chart 1 Month",
            url: demo_charts_path(chart_1_period: "month", chart_2_period: @chart_multi_chart_2_period),
            data: {turbo_frame: "chart-1-frame"}
          ) %>
        <% end %>

        <%= render FlatPack::ChartButtons::Component.new(margin_bottom: nil) do |controls| %>
          <% controls.dropdown(
            text: "Chart 2 Range",
            options: [
              {text: "Week", url: demo_charts_path(chart_1_period: @chart_multi_chart_1_period, chart_2_period: "week"), data: {turbo_frame: "chart-2-frame"}},
              {text: "Month", url: demo_charts_path(chart_1_period: @chart_multi_chart_1_period, chart_2_period: "month"), data: {turbo_frame: "chart-2-frame"}},
              {text: "Year", url: demo_charts_path(chart_1_period: @chart_multi_chart_1_period, chart_2_period: "year"), data: {turbo_frame: "chart-2-frame"}}
            ]
          ) %>
        <% end %>
      </div>

      <%= turbo_frame_tag "chart-1-frame", class: "block mb-4" do %>
        <%= render FlatPack::Chart::Component.new(
          type: :line,
          title: "Chart 1",
          subtitle: @chart_multi_chart_1_subtitle,
          series: @chart_multi_chart_1_series,
          height: 240,
          options: {
            xaxis: {
              categories: @chart_multi_chart_1_categories
            }
          }
        ) %>
      <% end %>

      <%= turbo_frame_tag "chart-2-frame", class: "block mb-4" do %>
        <%= render FlatPack::Chart::Component.new(
          type: :bar,
          title: "Chart 2",
          subtitle: @chart_multi_chart_2_subtitle,
          series: @chart_multi_chart_2_series,
          height: 240,
          options: {
            xaxis: {
              categories: @chart_multi_chart_2_categories
            }
          }
        ) %>
      <% end %>

      <div class="mb-4">
        <%= render FlatPack::Chart::Component.new(
          type: :area,
          title: "Chart 3",
          subtitle: "Static chart in same outer frame",
          series: @chart_multi_chart_3_series,
          height: 240,
          options: {
            xaxis: {
              categories: @chart_multi_chart_3_categories
            }
          }
        ) %>
      </div>
    </div>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_open}%
        chart_1_period = %w[day month].include?(params[:chart_1_period]) ? params[:chart_1_period] : "day"
        chart_2_period = %w[week month year].include?(params[:chart_2_period]) ? params[:chart_2_period] : "week"
      %#{erb_tag_close}

      #{erb_output_open} turbo_frame_tag "chart-period-filter-multi" do #{erb_tag_close}
        #{erb_output_open} render FlatPack::ChartButtons::Component.new(margin_bottom: nil) do |controls| #{erb_tag_close}
          #{erb_open}% controls.button(text: "Chart 1 Day", url: demo_charts_path(chart_1_period: "day", chart_2_period: chart_2_period), data: {turbo_frame: "chart-1-frame"}) %#{erb_tag_close}
          #{erb_open}% controls.button(text: "Chart 1 Month", url: demo_charts_path(chart_1_period: "month", chart_2_period: chart_2_period), data: {turbo_frame: "chart-1-frame"}) %#{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} render FlatPack::ChartButtons::Component.new(margin_bottom: nil) do |controls| #{erb_tag_close}
          #{erb_open}% controls.dropdown(text: "Chart 2 Range", options: [
            {text: "Week", url: demo_charts_path(chart_1_period: chart_1_period, chart_2_period: "week"), data: {turbo_frame: "chart-2-frame"}},
            {text: "Month", url: demo_charts_path(chart_1_period: chart_1_period, chart_2_period: "month"), data: {turbo_frame: "chart-2-frame"}},
            {text: "Year", url: demo_charts_path(chart_1_period: chart_1_period, chart_2_period: "year"), data: {turbo_frame: "chart-2-frame"}}
          ]) %#{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} turbo_frame_tag "chart-1-frame" do #{erb_tag_close}
          #{erb_output_open} render FlatPack::Chart::Component.new(type: :line, title: "Chart 1", series: @chart_multi_chart_1_series, options: {xaxis: {categories: @chart_multi_chart_1_categories}}) #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} turbo_frame_tag "chart-2-frame" do #{erb_tag_close}
          #{erb_output_open} render FlatPack::Chart::Component.new(type: :bar, title: "Chart 2", series: @chart_multi_chart_2_series, options: {xaxis: {categories: @chart_multi_chart_2_categories}}) #{erb_tag_close}
        #{erb_open} end #{erb_tag_close}

        #{erb_output_open} render FlatPack::Chart::Component.new(type: :area, title: "Chart 3", series: @chart_multi_chart_3_series, options: {xaxis: {categories: @chart_multi_chart_3_categories}}) #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>

</section>

<!-- Chart without Card -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Chart without Card Wrapper", anchor_link: true, subtitle: "Examples for Chart without Card Wrapper.") %>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    Set <code>card: false</code> to render the chart without a card wrapper.
  </p>
  <%= render FlatPack::Chart::Component.new(
    type: :bar,
    series: [{name: "Traffic", data: [12, 19, 3, 5, 2, 3]}],
    card: false,
    height: 250
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :bar,
        series: [{name: "Traffic", data: [12, 19, 3, 5, 2, 3]}],
        card: false,
        height: 250
      ) #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Mini Charts in Table Column -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Mini Chart in Table Row",
    anchor_link: true,
    subtitle: "Render sparkline activity charts in a table column for repository-like rows."
  ) %>
  <p class="text-(--surface-muted-content-color) mb-4">
    This pattern mirrors repository activity rows by combining <code>FlatPack::Table::Component</code> and
    compact <code>FlatPack::Chart::Component</code> instances with <code>card: false</code>.
  </p>

  <%= render FlatPack::Table::Component.new(data: @chart_repo_activity_rows) do |table| %>
    <% table.column(title: "Repository", html: ->(row) {
      content_tag(:div, class: "min-w-[220px]") do
        safe_join([
          content_tag(:div, row[:name], class: "font-medium text-[var(--surface-content-color)]"),
          content_tag(:div, row[:description], class: "text-xs text-[var(--surface-muted-content-color)] mt-1"),
          content_tag(:div, class: "mt-2") do
            render FlatPack::Badge::Component.new(text: row[:language], style: :default, size: :sm)
          end
        ])
      end
    }) %>

    <% table.column(title: "Commits (7d)", html: ->(row) {
      content_tag(:span, row[:commits_7d], class: "font-medium")
    }) %>

    <% table.column(title: "Activity", html: ->(row) {
      color = "var(--color-success-background-color)"
      content_tag(:div, class: "w-[104px] min-w-[104px]") do
        render FlatPack::Chart::Component.new(
          type: :area,
          series: [{name: "Commits", data: row[:activity]}],
          card: false,
          height: 56,
          class: "w-full",
          options: {
            chart: {
              sparkline: {enabled: true}
            },
            colors: [color],
            stroke: {
              curve: "smooth",
              width: 2
            },
            fill: {
              type: "gradient",
              gradient: {
                shade: "light",
                shadeIntensity: 0,
                inverseColors: false,
                gradientToColors: [color],
                opacityFrom: 0.45,
                opacityTo: 0.05,
                stops: [0, 90, 100]
              }
            },
            markers: {
              size: 0
            },
            tooltip: {
              enabled: false
            },
            grid: {
              show: false
            },
            xaxis: {
              labels: {show: false},
              axisBorder: {show: false},
              axisTicks: {show: false}
            },
            yaxis: {
              show: false
            }
          }
        )
      end
    }) %>

    <% table.column(title: "Open PRs", html: ->(row) { row[:prs_open] }) %>

    <% table.column(title: "Trend", html: ->(row) {
      trend_class = row[:trend_up] ? "text-green-700" : "text-red-700"
      content_tag(:span, row[:trend_label], class: "font-medium #{trend_class}")
    }) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_open}%
        rows = [
          {name: "flat-pack", language: "Ruby", commits_7d: 34, prs_open: 5, trend_label: "+14%", trend_up: true, activity: [2, 3, 1, 4, 6, 5, 7]},
          {name: "docs-site", language: "Markdown", commits_7d: 11, prs_open: 1, trend_label: "-4%", trend_up: false, activity: [4, 5, 4, 4, 3, 2, 1]}
        ]
      %#{erb_tag_close}

      #{erb_output_open} render FlatPack::Table::Component.new(data: rows) do |table| #{erb_tag_close}
        #{erb_open}% table.column(title: "Repository", html: ->(row) { row[:name] }) %#{erb_tag_close}
        #{erb_open}% table.column(title: "Commits (7d)", html: ->(row) { row[:commits_7d] }) %#{erb_tag_close}
        #{erb_open}% table.column(title: "Activity", html: ->(row) {
          color = "var(--color-success-background-color)"
          render FlatPack::Chart::Component.new(
            type: :area,
            series: [{name: "Commits", data: row[:activity]}],
            card: false,
            height: 56,
            options: {
              chart: {sparkline: {enabled: true}},
              colors: [color],
              stroke: {curve: "smooth", width: 2},
              fill: {
                type: "gradient",
                gradient: {
                  shade: "light",
                  shadeIntensity: 0,
                  inverseColors: false,
                  gradientToColors: [color],
                  opacityFrom: 0.45,
                  opacityTo: 0.05,
                  stops: [0, 90, 100]
                }
              },
              markers: {size: 0},
              tooltip: {enabled: false},
              grid: {show: false},
              xaxis: {labels: {show: false}, axisBorder: {show: false}, axisTicks: {show: false}},
              yaxis: {show: false}
            }
          )
        }) %#{erb_tag_close}
        #{erb_open}% table.column(title: "Open PRs", html: ->(row) { row[:prs_open] }) %#{erb_tag_close}
        #{erb_open}% table.column(title: "Trend", html: ->(row) { row[:trend_label] }) %#{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Multiple Charts in Grid -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Multiple Charts in Grid", anchor_link: true, subtitle: "Examples for Multiple Charts in Grid.") %>
  <%= render FlatPack::Grid::Component.new(cols: 2) do %>
    <%= render FlatPack::Chart::Component.new(
      type: :line,
      series: [{name: "Visits", data: [30, 40, 35, 50, 49, 60, 70, 91]}],
      title: "Website Visits",
      height: 250
    ) %>
    
    <%= render FlatPack::Chart::Component.new(
      type: :bar,
      series: [{name: "Conversions", data: [5, 8, 6, 10, 9, 12, 15, 18]}],
      title: "Conversions",
      height: 250
    ) %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Grid::Component.new(cols: 2) do #{erb_tag_close}
        #{erb_output_open} render FlatPack::Chart::Component.new(
          type: :line,
          series: [{name: "Visits", data: [30, 40, 35, 50, 49, 60, 70, 91]}],
          title: "Website Visits",
          height: 250
        ) #{erb_tag_close}

        #{erb_output_open} render FlatPack::Chart::Component.new(
          type: :bar,
          series: [{name: "Conversions", data: [5, 8, 6, 10, 9, 12, 15, 18]}],
          title: "Conversions",
          height: 250
        ) #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Chart with Footer -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Chart with Footer", anchor_link: true, subtitle: "Examples for Chart with Footer.") %>
  <%= render FlatPack::Chart::Component.new(
    type: :area,
    series: [{name: "Revenue", data: [10, 20, 15, 30, 25, 40, 35, 50]}],
    title: "Revenue Trend",
    height: 300
  ) do |chart| %>
    <% chart.footer do %>
      <div class="flex items-center justify-between text-sm">
        <div class="flex items-center gap-4">
          <div>
            <span class="text-[var(--surface-muted-content-color)]">Total:</span>
            <span class="font-semibold ml-1">$225K</span>
          </div>
          <div>
            <span class="text-[var(--surface-muted-content-color)]">Avg:</span>
            <span class="font-semibold ml-1">$28.1K</span>
          </div>
        </div>
        <span class="text-green-600 font-semibold">+12.5% vs last period</span>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::CodeBlock::Component.new(
    title: "ERB",
    language: "erb",
    code: <<~CODE
      #{erb_output_open} render FlatPack::Chart::Component.new(
        type: :area,
        series: [{name: "Revenue", data: [10, 20, 15, 30, 25, 40, 35, 50]}],
        title: "Revenue Trend",
        height: 300
      ) do |chart| #{erb_tag_close}
        #{erb_output_open} chart.footer do #{erb_tag_close}
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-4">
              <div>
                <span class="text-[var(--surface-muted-content-color)]">Total:</span>
                <span class="font-semibold ml-1">$225K</span>
              </div>
              <div>
                <span class="text-[var(--surface-muted-content-color)]">Avg:</span>
                <span class="font-semibold ml-1">$28.1K</span>
              </div>
            </div>
            <span class="text-green-600 font-semibold">+12.5% vs last period</span>
          </div>
        #{erb_open} end #{erb_tag_close}
      #{erb_open} end #{erb_tag_close}
    CODE
  ) %>
</section>

<!-- Setup Instructions -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Setup Instructions", anchor_link: true, subtitle: "Examples for Setup Instructions.") %>
  <h3 class="text-lg font-semibold mb-3">ApexCharts is Already Configured</h3>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    FlatPack includes ApexCharts via CDN in the importmap. No additional setup required!
  </p>
  
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE'),
      # config/importmap.rb (already configured)
      pin "apexcharts", to: "https://cdn.jsdelivr.net/npm/apexcharts@3.45.1/dist/apexcharts.esm.js"
    CODE
    class: "mb-4"
  ) %>
  
  <h3 class="text-lg font-semibold mb-3">For Self-Hosting (Production)</h3>
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      # Download and place in vendor/javascript
      # Then update importmap.rb
      pin "apexcharts", to: "apexcharts.min.js"
    CODE
  ) %>
</section>

<!-- Custom Options -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Custom ApexCharts Options", anchor_link: true, subtitle: "Examples for Custom ApexCharts Options.") %>
  <p class="text-[var(--surface-muted-content-color)] mb-4">
    Pass custom ApexCharts options for full control.
  </p>
  
  <%= render FlatPack::CodeBlock::Component.new(
    code: CGI.unescapeHTML(<<~'CODE')
      &lt;%= render FlatPack::Chart::Component.new(
        type: :line,
        series: [{name: "Sales", data: [30, 40, 45]}],
        options: {
          chart: {
            toolbar: { show: true }
          },
          colors: ['#FF5733'],
          stroke: {
            width: 3,
            curve: 'smooth'
          },
          xaxis: {
            categories: ['Jan', 'Feb', 'Mar']
          }
        }
      ) %&gt;
    CODE
  ) %>
</section>

<!-- Features -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Features", anchor_link: true, subtitle: "Examples for Features.") %>
  <%= render FlatPack::List::Component.new(spacing: :dense, class: "text-[var(--surface-content-color)]") do %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>ApexCharts Integration:</strong> Professional data visualization library<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Lazy Loading:</strong> Charts load only when needed (via dynamic import)<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Card Wrapping:</strong> Automatic card wrapper with title, actions, footer<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>6 Chart Types:</strong> Line, bar, area, donut, pie, and more<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Responsive:</strong> Charts adapt to container size<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Turbo Compatible:</strong> Properly cleans up on navigation<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Customizable:</strong> Full access to ApexCharts options<% end %>
    <%= render FlatPack::List::Item.new(class: "py-0 px-0") do %><strong>Accessible:</strong> Works with screen readers<% end %>
  <% end %>
</section>

<!-- Chart Types Reference -->
<section class="mb-12">
  <%= render FlatPack::SectionTitle::Component.new(title: "Available Chart Types", anchor_link: true, subtitle: "Examples for Available Chart Types.") %>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
    <%= render FlatPack::Badge::Component.new(text: ":line", variant: :default) %>
    <%= render FlatPack::Badge::Component.new(text: ":bar", variant: :default) %>
    <%= render FlatPack::Badge::Component.new(text: ":area", variant: :default) %>
    <%= render FlatPack::Badge::Component.new(text: ":donut", variant: :default) %>
    <%= render FlatPack::Badge::Component.new(text: ":pie", variant: :default) %>
    <%= render FlatPack::Badge::Component.new(text: ":radial", variant: :default) %>
  </div>
</section>
