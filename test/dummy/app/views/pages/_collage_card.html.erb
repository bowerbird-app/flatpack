<%# locals: (photo:) %>
<%= render FlatPack::Card::Component.new(shadow: :sm, padding: :none) do |card| %>
  <% card.media(aspect_ratio: "4/3", padding: :none) do %>
    <%= image_tag photo[:src], alt: photo[:alt], class: "h-full w-full object-cover" %>
  <% end %>
  <% card.body(padding: :sm) do %>
    <%= render FlatPack::Badge::Component.new(text: photo[:badge], size: :xs) %>
    <p class="mt-2 font-semibold"><%= photo[:title] %></p>
    <p class="text-sm text-[var(--surface-muted-content-color)]"><%= photo[:date] %></p>
  <% end %>
<% end %>
