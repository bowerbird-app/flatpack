<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Themes",
    description: "Explore FlatPack's color palettes, semantic tokens, and theme switching capabilities."
  ) %>

  <!-- How Theming Works -->
  <div class="space-y-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "How Theming Works",
      subtitle: "Brand primitives drive semantic tokens; component tokens inherit automatically.",
      anchor_link: true
    ) %>

    <div class="p-4 border border-[var(--surface-border-color)] rounded-lg bg-[var(--surface-background-color)] space-y-3">
      <p class="text-sm text-[var(--surface-muted-content-color)]">
        FlatPack tokens have three layers:
        <code class="font-mono text-xs">--brand-hue</code> / <code class="font-mono text-xs">--brand-chroma</code>
        (primitives), semantic tokens such as <code class="font-mono text-xs">--color-primary</code> and
        <code class="font-mono text-xs">--surface-content-color</code>, then component aliases such as
        <code class="font-mono text-xs">--button-primary-background-color</code> which map once to
        <code class="font-mono text-xs">var(--color-primary)</code>.
      </p>
      <p class="text-sm text-[var(--surface-muted-content-color)]">
        Recolor the app by changing brand primitives (or
        <code class="font-mono text-xs">rails g flat_pack:theme Sunrise --hue=35</code>).
        Named themes under <code class="font-mono text-xs">[data-theme="…"]</code> should override
        brand/semantic tokens only — component aliases inherit from <code class="font-mono text-xs">:root</code>.
      </p>
    </div>
  </div>

  <!-- Theme Variable Reference -->
  <div class="space-y-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Theme Variable Reference",
      subtitle: "Grouped Tailwind v4 @theme tokens with plain-language descriptions.",
      anchor_link: true
    ) %>

    <div class="p-4 border border-[var(--surface-border-color)] rounded-lg bg-[var(--surface-background-color)] space-y-3">
      <p class="text-sm text-[var(--surface-muted-content-color)]">
        This catalog lists the <code class="font-mono text-xs">@theme</code> inventory from
        <code class="font-mono text-xs">flat_pack/variables.css</code>. Values that start with
        <code class="font-mono text-xs">var(</code> are aliases — change the referenced semantic token
        (or <code class="font-mono text-xs">--brand-hue</code>) instead of editing the alias.
      </p>
      <p class="text-xs text-[var(--surface-muted-content-color)]">
        Tip: utilities such as <code class="font-mono">bg-primary</code> come from semantic
        <code class="font-mono">--color-*</code> tokens. Component tables on demo pages (Buttons, Sidebar, …)
        show the matching <code class="font-mono">--button-*</code> / <code class="font-mono">--sidebar-*</code> aliases.
      </p>
    </div>

    <div class="space-y-4">
      <% @theme_token_groups.each do |group| %>
        <div class="space-y-3">
          <%= render FlatPack::SectionTitle::Component.new(
            title: group.fetch(:title),
            subtitle: group.fetch(:subtitle),
            anchor_link: true
          ) %>
          <div class="rounded-lg bg-[var(--surface-background-color)]">
            <%= render "themes/token_table", rows: group.fetch(:rows) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>


  <div class="space-y-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Theme Demos",
      subtitle: "Compare both light and dark demos inline, with dedicated pages still available.",
      anchor_link: true
    ) %>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <div class="space-y-3 p-4 border border-[var(--surface-border-color)] rounded-lg bg-[var(--surface-background-color)]" data-theme="light">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">Light Demo</h3>
          <%= render FlatPack::Button::Component.new(text: "Open Full Demo", href: theme_demo_path(theme: "light"), style: :secondary, size: :sm) %>
        </div>
        <%= render "themes/demo_showcase" %>
      </div>

      <div class="space-y-3 p-4 border border-[var(--surface-border-color)] rounded-lg bg-[var(--surface-background-color)]" data-theme="dark">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">Dark Demo</h3>
          <%= render FlatPack::Button::Component.new(text: "Open Full Demo", href: theme_demo_path(theme: "dark"), style: :secondary, size: :sm) %>
        </div>
        <%= render "themes/demo_showcase" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">System Theme</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mt-1">Follows OS preference with automatic light/dark resolution.</p>
          <div class="mt-4">
            <%= render FlatPack::Button::Component.new(text: "Open Demo", href: theme_demo_path(theme: "system"), style: :secondary, size: :sm) %>
          </div>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">Light Theme</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mt-1">Neutral, high-contrast daytime palette.</p>
          <div class="mt-4">
            <%= render FlatPack::Button::Component.new(text: "Open Demo", href: theme_demo_path(theme: "light"), style: :secondary, size: :sm) %>
          </div>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">Dark Theme</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mt-1">Low-luminance palette tuned for dark surfaces.</p>
          <div class="mt-4">
            <%= render FlatPack::Button::Component.new(text: "Open Demo", href: theme_demo_path(theme: "dark"), style: :secondary, size: :sm) %>
          </div>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">Ocean Theme</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mt-1">Blue-leaning palette with cool accent contrast.</p>
          <div class="mt-4">
            <%= render FlatPack::Button::Component.new(text: "Open Demo", href: theme_demo_path(theme: "ocean"), style: :secondary, size: :sm) %>
          </div>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new do |card| %>
        <% card.body do %>
          <h3 class="text-base font-medium text-[var(--surface-content-color)]">Rounded Theme</h3>
          <p class="text-sm text-[var(--surface-muted-content-color)] mt-1">Soft corners and muted neutrals for a friendly style.</p>
          <div class="mt-4">
            <%= render FlatPack::Button::Component.new(text: "Open Demo", href: theme_demo_path(theme: "rounded"), style: :secondary, size: :sm) %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
