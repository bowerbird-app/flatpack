<% recording_studio_page_nav(title: "Studio") if defined?(recording_studio_page_nav) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "You're in",
    subtitle: "Apps you Connect show up here. Register new ones from the admin list.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Registered apps",
      href: "/admin/sections/oauth_apps",
      style: :primary
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Demo",
      href: "/demo",
      style: :ghost
    ) %>
  </div>

  <% if defined?(RecordingStudioOauth) %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Connected apps",
      subtitle: "These apps have their own access. Remove one to shut it off.",
      variant: :h2
    ) %>

    <% if @authorizations.present? %>
      <%= render FlatPack::List::Component.new(divider: true) do %>
        <% @authorizations.each do |authorization| %>
          <% remove_button = nil %>
          <% if authorization.revoked_at.nil? %>
            <% remove_button = capture do %>
              <%= form_with url: recording_studio_oauth.connected_app_path(authorization), method: :delete do %>
                <%= render FlatPack::Button::Component.new(
                  text: "Remove access",
                  style: :danger,
                  size: :sm,
                  type: "submit"
                ) %>
              <% end %>
            <% end %>
          <% end %>
          <%= render FlatPack::List::Item.new(trailing: remove_button) do %>
            <p class="font-medium"><%= authorization.oauth_client.name %></p>
            <p class="text-sm text-[var(--surface-muted-content-color)]">
              <%= connected_app_status(authorization) %>
            </p>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "Nothing connected yet",
        description: "When you Connect an app to a workspace, it shows up here.",
        icon: :inbox
      ) %>
    <% end %>
  <% end %>
</div>
