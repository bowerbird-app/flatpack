<% if collapse_menu? %>
  <%= collapse_stylesheet %>
  <div <%= tag.attributes(menu_root_attributes) %>>
    <%= menu_trigger %>
    <div <%= tag.attributes(row_attributes) %>><% row_slots.each do |button| %><%= rendered_child(button) %><% end %><%= overflow_dropdown %></div>
    <div <%= tag.attributes(panel_attributes) %>><% buttons.each do |button| %><%= menu_entry(button) %><% end %></div>
  </div>
<% else %>
  <div <%= tag.attributes(group_attributes) %>>
    <% row_slots.each do |button| %>
      <%= rendered_child(button) %>
    <% end %>
    <%= overflow_dropdown %>
  </div>
<% end %>
