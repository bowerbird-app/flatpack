<!DOCTYPE html>
<html class="h-full" data-theme="rounded">
  <head>
    <title>Your App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%%= csrf_meta_tags %>
    <%%= csp_meta_tag %>

    <%%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <%%= render FlatPack::SidebarLayout::Component.new(
      side: :<%= sidebar_side %>,
      storage_key: "<%= options[:storage_key] %>"
    ) do |layout| %>
      <%% layout.sidebar do %>
        <%%= render "layouts/flat_pack/sidebar", sidebar_side: :<%= sidebar_side %> %>
      <%% end %>

      <%% layout.top_nav do %>
        <%%= render "layouts/flat_pack/top_nav" %>
      <%% end %>

      <%% layout.main do %>
        <div class="p-6">
          <%% if notice.present? %>
            <%%= render FlatPack::Alert::Component.new(
              description: notice,
              style: :success,
              dismissible: true,
              class: "mb-4"
            ) %>
          <%% end %>
          <%% if alert.present? %>
            <%%= render FlatPack::Alert::Component.new(
              description: alert,
              style: :danger,
              dismissible: true,
              class: "mb-4"
            ) %>
          <%% end %>

          <%%= yield %>
        </div>
      <%% end %>
    <%% end %>
  </body>
</html>
