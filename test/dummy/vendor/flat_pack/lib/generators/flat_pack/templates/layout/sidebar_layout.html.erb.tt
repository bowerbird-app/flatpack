<!DOCTYPE html>
<html class="h-full" data-theme="rounded" lang="<%%= I18n.locale %>" <%%= tag.attributes(data: flat_pack_copy_data) %>>
  <head>
    <title>Your App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%%= csrf_meta_tags %>
    <%%= csp_meta_tag %>

    <%%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <%%= render FlatPack::SkipLink::Component.new(href: "#main") %>
    <%%= render FlatPack::SidebarLayout::Component.new(
      side: :<%= sidebar_side %>,
      storage_key: "<%= options[:storage_key] %>"
    ) do |layout| %>
      <%% layout.sidebar do %>
        <%%= render "layouts/flat_pack/sidebar", sidebar_side: :<%= sidebar_side %> %>
      <%% end %>

      <%% layout.top_nav do %>
        <%%= render "layouts/flat_pack/top_nav" %>
      <%% end %>
<% if options[:aside] %>

      <%% layout.aside do %>
        <div class="flex items-center justify-between gap-3 border-b border-(--surface-border-color) px-4 py-3">
          <h2 class="text-sm font-medium">Details</h2>
          <%%= render FlatPack::Button::Component.new(
            icon: "x-mark",
            icon_only: true,
            style: :ghost,
            size: :sm,
            aria: { label: "Close details" },
            data: { action: "click->flat-pack--sidebar-layout#closeAside" }
          ) %>
        </div>
      <%% end %>
<% end %>

      <%% layout.actions do %>
        <%%= page_nav_button_group(styles: FlatPack::PageNavRoleStyles::QUIET, collapse: :menu) %>
      <%% end %>

      <%% layout.main do %>
        <main id="main" tabindex="-1" class="fp-layout-content py-6">
          <div class="fp-layout-column">
          <%% if notice.present? %>
            <%%= render FlatPack::Alert::Component.new(
              description: notice,
              style: :success,
              dismissible: true,
              class: "mb-4"
            ) %>
          <%% end %>
          <%% if alert.present? %>
            <%%= render FlatPack::Alert::Component.new(
              description: alert,
              style: :danger,
              dismissible: true,
              class: "mb-4"
            ) %>
          <%% end %>

          <%% page_nav = flat_pack_page_nav_tag %>
          <%% if page_nav %>
            <div class="mb-4">
              <%%= page_nav %>
            </div>
          <%% end %>

          <%%= yield %>
          </div>
        </main>
      <%% end %>
    <%% end %>
  </body>
</html>
