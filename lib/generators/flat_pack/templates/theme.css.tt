/* FlatPack brand theme: <%= theme_slug %>
 *
 * Change --brand-hue / --brand-chroma / --brand-lightness to recolor primary.
 * :root, [data-theme] maps those knobs to --color-primary. Hover follows --color-primary
 * (0.10 darker on lightness). Focus rings follow --color-primary.
 * Active sidebar / top-nav fills follow --surface-active-background-color.
 * Hover follows --surface-hover-background-color.
 * For an exact hex, set --color-primary. Hover derives from it; override --color-primary-hover to diverge.
 * Surfaces stay independent unless you override --surface-*.
 * Component tokens re-resolve from semantic tokens — you usually do not override them.
 *
 * Load this stylesheet AFTER flat_pack/variables.
<% if inherited_theme -%>
 * Inherits <%= inherited_theme %>. Set data-theme="<%= inherited_theme %> <%= theme_slug %>".
 * This block overrides only the tokens below. <%= inherited_theme %> still applies.
<% elsif !as_root? -%>
 * Word match: data-theme="<%= theme_slug %>" and a stack such as data-theme="rounded <%= theme_slug %>" both hit this block.
<% end -%>
 */
<%= selector %> {
  --brand-hue: <%= brand_hue %>;
  --brand-chroma: <%= brand_chroma %>;
  --brand-lightness: <%= brand_lightness %>;
}
